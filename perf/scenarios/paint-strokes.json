{
  "name": "paint-strokes",
  "about": "Painting, the owner's first priority for responsiveness (2026-10-09): three brush strokes on the frame on screen, an undo, then a flip to the next drawing and a stroke straight after it. Run it with --fixture large to see how it holds up at scale.",
  "fixture": "owner-shape",
  "repeat": 2,
  "steps": [
    {"do": "hover", "at": [0.5, 0.5]},
    {"do": "key", "keys": "b", "after_ms": 300},
    {"do": "settle", "quiet_s": 1.0},
    {"do": "drag", "measure": "stroke", "from": [0.30, 0.40], "by": [0.20, 0.10], "ms": 800, "hz": 120, "after_ms": 400},
    {"do": "drag", "measure": "stroke", "from": [0.35, 0.55], "by": [0.25, -0.05], "ms": 800, "hz": 120, "after_ms": 400},
    {"do": "drag", "measure": "stroke", "from": [0.55, 0.30], "by": [-0.10, 0.25], "ms": 800, "hz": 120, "after_ms": 400},
    {"do": "key", "measure": "undo", "keys": "ctrl+z", "after_ms": 400},
    {"do": "key", "measure": "flip", "keys": "2", "after_ms": 150},
    {"do": "drag", "measure": "stroke after flip", "from": [0.40, 0.45], "by": [0.15, 0.10], "ms": 600, "hz": 120, "after_ms": 400},
    {"do": "settle", "quiet_s": 1.0}
  ]
}
