{
  "name": "pen-path",
  "about": "The pen and the white arrow, on the owner-shaped document. Eight points placed by click-and-drag, each pulling its handles out for half a second (pen.drag), the pointer carried from one to the next with the rubber band following (pen.hover), Enter. Then the white arrow goes into the finished line and drags its third point, and both are undone. The overlay is chrome and never goes through a publish, so the numbers that matter are overlay.shown (a change to the rubber band or the nodes until the frame carrying it is drawn) and overlay.draw (what that whole-canvas redraw cost). --fixture blank-1080p is the control: the same overlay over an empty page.",
  "fixture": "owner-shape",
  "repeat": 2,
  "steps": [
    {"do": "hover", "at": [0.5, 0.5]},
    {"do": "key", "keys": "p", "after_ms": 300},
    {"do": "drag", "from": [0.15, 0.3], "by": [0.05, 0.0], "ms": 500, "hz": 120},
    {"do": "glide", "from": [0.2, 0.3], "by": [0.05, 0.32], "ms": 700, "hz": 120},
    {"do": "drag", "from": [0.25, 0.62], "by": [0.05, 0.0], "ms": 500, "hz": 120},
    {"do": "glide", "from": [0.3, 0.62], "by": [0.05, -0.32], "ms": 700, "hz": 120},
    {"do": "drag", "from": [0.35, 0.3], "by": [0.05, 0.0], "ms": 500, "hz": 120},
    {"do": "glide", "from": [0.4, 0.3], "by": [0.05, 0.32], "ms": 700, "hz": 120},
    {"do": "drag", "from": [0.45, 0.62], "by": [0.05, 0.0], "ms": 500, "hz": 120},
    {"do": "glide", "from": [0.5, 0.62], "by": [0.05, -0.32], "ms": 700, "hz": 120},
    {"do": "shot", "name": "rubber-band"},
    {"do": "drag", "from": [0.55, 0.3], "by": [0.05, 0.0], "ms": 500, "hz": 120},
    {"do": "glide", "from": [0.6, 0.3], "by": [0.05, 0.32], "ms": 700, "hz": 120},
    {"do": "drag", "from": [0.65, 0.62], "by": [0.05, 0.0], "ms": 500, "hz": 120},
    {"do": "glide", "from": [0.7, 0.62], "by": [0.05, -0.32], "ms": 700, "hz": 120},
    {"do": "drag", "from": [0.75, 0.3], "by": [0.05, 0.0], "ms": 500, "hz": 120},
    {"do": "glide", "from": [0.8, 0.3], "by": [0.05, 0.32], "ms": 700, "hz": 120},
    {"do": "drag", "from": [0.85, 0.62], "by": [0.05, 0.0], "ms": 500, "hz": 120},
    {"do": "shot", "name": "eight-points"},
    {"do": "key", "keys": "enter"},
    {"do": "settle", "quiet_s": 1.0},
    {"do": "shot", "name": "finished-line"},
    {"do": "key", "keys": "n", "after_ms": 300},
    {"do": "click", "at": [0.35, 0.3], "after_ms": 300},
    {"do": "shot", "name": "white-arrow"},
    {"do": "drag", "from": [0.35, 0.3], "by": [0.04, 0.12], "ms": 1200, "hz": 120},
    {"do": "settle", "quiet_s": 0.8},
    {"do": "shot", "name": "point-dragged"},
    {"do": "key", "keys": "escape", "after_ms": 300},
    {"do": "key", "keys": "ctrl+z"},
    {"do": "settle", "quiet_s": 0.8},
    {"do": "key", "keys": "ctrl+z"},
    {"do": "settle", "quiet_s": 1.0}
  ]
}
