      "do": "hover",
      "at": [
        0.5,
        0.5
      ]
    },
    {
      "do": "wait",
      "ms": 10000
    },
    {
      "do": "key",
      "keys": "space",
      "measure": "play",
      "after_ms": 3000
    },
    {
      "do": "key",
      "keys": "space",
      "measure": "stop",
      "after_ms": 500
    },
    {
      "do": "settle",
      "quiet_s": 1.0
    },
