<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Prototype controls (Q203), from the owner's slider-and-selector reference:
    an effect slider whose track shows what the value does, and segmented
    selectors for a handful of choices. Live-editable like every look file.

    Not in the app yet. When one is chosen it becomes a real style in
    src/Lightbox.App/Styles/, and the prototype here is deleted.
  -->
  <Styles.Resources>
    <!-- Transparency, as every paint program shows it. Two greys, 4 px cells. -->
    <DrawingBrush x:Key="LookCheckerBrush" TileMode="Tile" DestinationRect="0,0,8,8" SourceRect="0,0,8,8">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#9A9A9A" Geometry="M0,0 H8 V8 H0 Z" />
          <GeometryDrawing Brush="#6A6A6A" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- A half-filled disc: how much of what is under it shows through. -->
    <StreamGeometry x:Key="LookIconOpacity">M8,1.5 A6.5,6.5 0 1 0 8,14.5 A6.5,6.5 0 1 0 8,1.5 Z M8,1.5 L8,14.5</StreamGeometry>
    <StreamGeometry x:Key="LookIconOpacityFill">M8,1.5 A6.5,6.5 0 0 1 8,14.5 Z</StreamGeometry>
    <!-- A drop: how much paint each dab lays down. -->
    <StreamGeometry x:Key="LookIconFlow">M8,1.5 C8,1.5 3.5,7 3.5,10 A4.5,4.5 0 0 0 12.5,10 C12.5,7 8,1.5 8,1.5 Z</StreamGeometry>
  </Styles.Resources>

  <!--
    The effect slider: a pill that is the picture of its own value. The track
    is a well; Background is the effect drawn over it (a story or a binding
    supplies it — paint colour fading in, say); .checker puts transparency
    under the effect for a value that is about seeing through.
  -->
  <Style Selector="Slider.effect">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- The track is a control, so it takes the control radius; the
               thumb is a handle, so it takes the pill. -->
          <Border CornerRadius="{StaticResource LookControlRadius}" Background="{StaticResource FieldGroundBrush}" />
          <Border x:Name="PART_Checker" CornerRadius="{StaticResource LookControlRadius}" Background="{StaticResource LookCheckerBrush}" IsVisible="False" />
          <Border CornerRadius="{StaticResource LookControlRadius}" Background="{TemplateBinding Background}" />
          <Track x:Name="PART_Track" Orientation="Horizontal" Margin="3,0"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}">
            <Track.Thumb>
              <Thumb Width="16" Height="16" Cursor="Hand">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border BorderBrush="White" BorderThickness="2" Background="#26FFFFFF"
                            CornerRadius="{StaticResource LookPillRadius}" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Slider.effect.checker /template/ Border#PART_Checker">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- The icon at the end of an effect slider: it names the value, so no label. -->
  <Style Selector="Path.effectIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.effectIconFill">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    Segmented selector: a well holding the choices, the chosen one a lighter
    flat pill. For three to five choices that are all worth seeing at once —
    DESIGN.md's "fewer than about six choices gets buttons", made into one
    control rather than a row of toggles that each manage their own state.
  -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{StaticResource FieldGroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource LookControlRadius}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="12,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="{StaticResource LookControlInnerRadius}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <!-- Inside the well's 2 px padding: one step in, so the chosen segment is
         concentric with the well. -->
    <Setter Property="CornerRadius" Value="{StaticResource LookControlInnerRadius}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverTintBrush}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ ContentPresenter, ListBox.segmented > ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <!-- Icon choices: square cells, the glyph is the label. -->
  <Style Selector="ListBox.segmented.icons > ListBoxItem">
    <Setter Property="Width" Value="30" />
    <Setter Property="Padding" Value="0" />
  </Style>
</Styles>
