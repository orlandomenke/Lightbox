<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Lightbox.Core\Lightbox.Core.csproj" />
  </ItemGroup>

  <!--
    The scanned papers (PaperField): 8-bit grey height maps, built from CC0
    sets by scripts/make_papers.py. docs/CREDITS-papers.md names each source.
    A logical name is given so it does not depend on the folder's spelling.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Media\Papers\*.png" LogicalName="Lightbox.Raster.Media.Papers.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
    <!--
      The Linux native asset, explicitly, for the reason SkiaSharp needs one:
      SkiaSharp.HarfBuzz brings the Windows and macOS binaries transitively and
      not this one, so shaping would throw at run time on the platform CI runs on.
    -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
