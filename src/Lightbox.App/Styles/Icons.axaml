  <!--
    Mirror flips the drawing in place; swap trades two values. The pair of
    opposed arrows means swap, the chevrons facing a dashed axis mean mirror —
    the axis is drawn because the axis is the point.
  -->
  <StreamGeometry x:Key="IconMirrorHorizontal">M0,0 M24,24 M12,3.8 V6.4 M12,9.7 V12.3 M12,15.6 V18.2 M8.6,8.5 L5.1,12 L8.6,15.5 M15.4,8.5 L18.9,12 L15.4,15.5</StreamGeometry>
