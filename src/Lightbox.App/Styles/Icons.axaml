<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The icon set: monoline geometry on a 24x24 grid, drawn for a 1.5px stroke
    with round caps — the vocabulary both design references are drawn in.

    These replace emoji, and that is a functional change as much as a visual
    one. An emoji is a fixed picture: it cannot dim, cannot swap between an
    open and a closed eye, renders differently per platform, and sets the row
    height (the 26px tile exists because a 16px emoji clips in 24 — see
    Density.axaml). A geometry takes its Stroke from a style, so state can
    live in the ICON — open eye, closed eye — instead of in a coloured fill
    behind it, which is what the owner asked for: one button colour, the
    glyph carries the state.

    Stroke-styled on purpose (Path with Stroke, not PathIcon with Fill): the
    references are monoline, and a stretched geometry keeps its stroke width,
    so one path serves every size without going bold.
  -->

  <!-- State pairs: the glyph is the state. -->
  <StreamGeometry x:Key="IconEyeOpen">M0,0 M24,24 M2.5,12 C6,6 18,6 21.5,12 C18,18 6,18 2.5,12 Z M12,8.9 a3.1,3.1 0 1 0 0.01,0</StreamGeometry>
  <StreamGeometry x:Key="IconEyeClosed">M0,0 M24,24 M3,13.5 C6.5,16.5 17.5,16.5 21,13.5 M5.5,15.8 L4,18.3 M12,17 L12,19.8 M18.5,15.8 L20,18.3</StreamGeometry>
  <StreamGeometry x:Key="IconLockClosed">M0,0 M24,24 M6.5,10.5 H17.5 V19.5 H6.5 Z M9,10.5 V7.5 A3,3 0 0 1 15,7.5 V10.5</StreamGeometry>
  <StreamGeometry x:Key="IconLockOpen">M0,0 M24,24 M6.5,10.5 H17.5 V19.5 H6.5 Z M9,10.5 V7 A3,3 0 0 1 14.8,5.9</StreamGeometry>
  <StreamGeometry x:Key="IconAlphaLock">M0,0 M24,24 M4.5,5.5 H19.5 V18.5 H4.5 Z M12,5.5 V18.5 M4.5,12 H19.5</StreamGeometry>
  <StreamGeometry x:Key="IconOnionOn">M0,0 M24,24 M15,12 m-5.5,0 a5.5,5.5 0 1 0 11,0 a5.5,5.5 0 1 0 -11,0 M9,12 m-5.5,0 a5.5,5.5 0 1 0 11,0 a5.5,5.5 0 1 0 -11,0</StreamGeometry>
  <StreamGeometry x:Key="IconOnionOff">M0,0 M24,24 M12,12 m-5.5,0 a5.5,5.5 0 1 0 11,0 a5.5,5.5 0 1 0 -11,0</StreamGeometry>

  <!-- The tool rail. -->
  <StreamGeometry x:Key="IconBrush">M0,0 M24,24 M19.7,4.3 C20.6,5.2 20.6,6.6 19.7,7.5 L11.5,15.7 L8.3,12.5 L16.5,4.3 C17.4,3.4 18.8,3.4 19.7,4.3 Z M7.3,13.7 C5.4,14 4.3,15.4 4,17.6 C3.9,18.6 3.5,19.4 2.8,20 C4,20.6 5.4,20.9 6.8,20.7 C9,20.4 10.3,19.2 10.5,16.9 Z</StreamGeometry>
  <StreamGeometry x:Key="IconEraser">M0,0 M24,24 M13.2,4.8 L19.9,11.5 L12.4,19 H8 L4.4,15.4 Z M8.8,10.4 L14.3,15.9 M4,20.8 H16.5</StreamGeometry>
  <StreamGeometry x:Key="IconFill">M0,0 M24,24 M11.2,3.6 L18.9,11.3 L12.4,17.8 C11,19.2 8.6,19.2 7.2,17.8 L5.4,16 C4,14.6 4,12.2 5.4,10.8 Z M4.5,11.7 H16.8 M20.6,14.8 C21.6,16.2 22.1,17.2 22.1,18.1 A1.9,1.9 0 0 1 18.3,18.1 C18.3,17.2 18.9,16.2 20.6,14.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPicker">M0,0 M24,24 M19.9,4.1 C21,5.2 21,6.9 19.9,8 L17.6,10.3 L13.7,6.4 L16,4.1 C17.1,3 18.8,3 19.9,4.1 Z M12.6,7.5 L16.5,11.4 L8.3,19.6 C7.5,20.4 6.3,20.8 5.2,20.6 L3.8,21.4 L2.6,20.2 L3.4,18.8 C3.2,17.7 3.6,16.5 4.4,15.7 Z</StreamGeometry>
  <StreamGeometry x:Key="IconGradient">M0,0 M24,24 M4.5,5 H19.5 V19 H4.5 Z M19.5,5 L4.5,19</StreamGeometry>
  <StreamGeometry x:Key="IconMove">M0,0 M24,24 M12,2.8 V21.2 M2.8,12 H21.2 M12,2.8 L9.6,5.2 M12,2.8 L14.4,5.2 M12,21.2 L9.6,18.8 M12,21.2 L14.4,18.8 M2.8,12 L5.2,9.6 M2.8,12 L5.2,14.4 M21.2,12 L18.8,9.6 M21.2,12 L18.8,14.4</StreamGeometry>
  <!--
    The pen: a nib on the same diagonal the other tools point along, with the
    slit and the ink hole that make it read as a nib rather than as an arrow at
    16px. Drawn along an axis from the back edge to the tip so the two long
    sides converge symmetrically — a hand-placed quadrilateral looks bent at
    this size and there is no way to un-see it once noticed.
  -->
  <StreamGeometry x:Key="IconPen">M0,0 M24,24 M17.8,2.8 L21.2,6.2 L11.4,14.8 L6.1,17.9 L9.3,12.6 Z M6.1,17.9 L10.3,13.7 M14.5,8.4 a1.1,1.1 0 1 0 0.01,0</StreamGeometry>

  <!-- Everyday verbs. -->
  <StreamGeometry x:Key="IconClose">M0,0 M24,24 M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M0,0 M24,24 M12,5 V19 M5,12 H19</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M0,0 M24,24 M4.5,7 H19.5 M9.5,7 V4.8 H14.5 V7 M6.8,7 L7.8,20 H16.2 L17.2,7 M10.3,10.5 V16.5 M13.7,10.5 V16.5</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M0,0 M24,24 M3.8,7 A1.6,1.6 0 0 1 5.4,5.4 H9.2 L11.6,7.9 H18.6 A1.6,1.6 0 0 1 20.2,9.5 V16.9 A1.6,1.6 0 0 1 18.6,18.5 H5.4 A1.6,1.6 0 0 1 3.8,16.9 Z</StreamGeometry>
  <StreamGeometry x:Key="IconEject">M0,0 M24,24 M4.5,20 H19.5 M12,5.5 L18.3,14 H5.7 Z</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M0,0 M24,24 M6,9.5 L12,15.5 L18,9.5</StreamGeometry>
</ResourceDictionary>
