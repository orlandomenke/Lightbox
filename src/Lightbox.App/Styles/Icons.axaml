<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The icon set: monoline geometry on a 24x24 grid, drawn for a 1.5px stroke
    with round caps — the vocabulary both design references are drawn in.

    These replace emoji, and that is a functional change as much as a visual
    one. An emoji is a fixed picture: it cannot dim, cannot swap between an
    open and a closed eye, renders differently per platform, and sets the row
    height (the 26px tile exists because a 16px emoji clips in 24 — see
    Density.axaml). A geometry takes its Stroke from a style, so state can
    live in the ICON — open eye, closed eye — instead of in a coloured fill
    behind it, which is what the owner asked for: one button colour, the
    glyph carries the state.

    Stroke-styled on purpose (Path with Stroke, not PathIcon with Fill): the
    references are monoline, and a stretched geometry keeps its stroke width,
    so one path serves every size without going bold.
  -->

  <!-- State pairs: the glyph is the state. -->
  <StreamGeometry x:Key="IconEyeOpen">M0,0 M24,24 M2.5,12 C6,6 18,6 21.5,12 C18,18 6,18 2.5,12 Z M12,8.9 a3.1,3.1 0 1 0 0.01,0</StreamGeometry>
  <StreamGeometry x:Key="IconEyeClosed">M0,0 M24,24 M3,13.5 C6.5,16.5 17.5,16.5 21,13.5 M5.5,15.8 L4,18.3 M12,17 L12,19.8 M18.5,15.8 L20,18.3</StreamGeometry>
  <StreamGeometry x:Key="IconLockClosed">M0,0 M24,24 M6.5,10.5 H17.5 V19.5 H6.5 Z M9,10.5 V7.5 A3,3 0 0 1 15,7.5 V10.5</StreamGeometry>
  <StreamGeometry x:Key="IconLockOpen">M0,0 M24,24 M6.5,10.5 H17.5 V19.5 H6.5 Z M9,10.5 V7 A3,3 0 0 1 14.8,5.9</StreamGeometry>
  <StreamGeometry x:Key="IconAlphaLock">M0,0 M24,24 M4.5,5.5 H19.5 V18.5 H4.5 Z M12,5.5 V18.5 M4.5,12 H19.5</StreamGeometry>
  <StreamGeometry x:Key="IconOnionOn">M0,0 M24,24 M15,12 m-5.5,0 a5.5,5.5 0 1 0 11,0 a5.5,5.5 0 1 0 -11,0 M9,12 m-5.5,0 a5.5,5.5 0 1 0 11,0 a5.5,5.5 0 1 0 -11,0</StreamGeometry>
  <StreamGeometry x:Key="IconOnionOff">M0,0 M24,24 M12,12 m-5.5,0 a5.5,5.5 0 1 0 11,0 a5.5,5.5 0 1 0 -11,0</StreamGeometry>

  <!-- The tool rail. -->
  <StreamGeometry x:Key="IconBrush">M0,0 M24,24 M19.7,4.3 C20.6,5.2 20.6,6.6 19.7,7.5 L11.5,15.7 L8.3,12.5 L16.5,4.3 C17.4,3.4 18.8,3.4 19.7,4.3 Z M7.3,13.7 C5.4,14 4.3,15.4 4,17.6 C3.9,18.6 3.5,19.4 2.8,20 C4,20.6 5.4,20.9 6.8,20.7 C9,20.4 10.3,19.2 10.5,16.9 Z</StreamGeometry>
