<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    THE BRAND, not the chrome — which is why this file exists apart from the
    palette and is excused from `NoViewInventsItsOwnChromeColour`. The
    palette's roles exist so surfaces can be re-pointed together; the logo's
    colours are the logo, measured off docs/design/ui-reference.png and
    generated by docs/design/brand/gen_logo.py. Re-skinning the application
    must never recolour the mark, so these are deliberately NOT roles.
  -->

  <!--
    The brand mark, as vectors, for the title bar. The geometry and every
    gradient stop come from docs/design/brand/gen_logo.py — the measured
    recreation of the reference — so the corner of the window and the splash
    are one drawing at two sizes. The shadow and the tip flare are omitted:
    at 18px they are noise.
  -->
  <DrawingImage x:Key="BrandIconDrawing">
    <DrawingGroup>
      <GeometryDrawing Geometry="M 100,10 L 8,66 L 41,84.6 L 100,48.6 Z">
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="100,10" EndPoint="8,66">
            <GradientStop Offset="0" Color="#F9913C" />
            <GradientStop Offset="1" Color="#F25B55" />
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M 8,66 L 8,194 L 41,175.4 L 41,84.6 Z">
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="8,66" EndPoint="8,194">
            <GradientStop Offset="0" Color="#F25B55" />
            <GradientStop Offset="1" Color="#C9359F" />
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M 8,194 L 100,250 L 100,211.4 L 41,175.4 Z">
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="8,194" EndPoint="100,250">
            <GradientStop Offset="0" Color="#C9359F" />
            <GradientStop Offset="0.55" Color="#802AC5" />
            <GradientStop Offset="1" Color="#5A36E0" />
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M 100,250 L 192,194 L 159,175.4 L 100,211.4 Z">
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="100,250" EndPoint="192,194">
            <GradientStop Offset="0" Color="#5A36E0" />
            <GradientStop Offset="1" Color="#4148F8" />
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M 192,194 L 192,116 L 159,150 L 159,175.4 Z">
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="192,194" EndPoint="192,116">
            <GradientStop Offset="0" Color="#4148F8" />
            <GradientStop Offset="0.72" Color="#7A5CFF" />
            <GradientStop Offset="1" Color="#A98BFF" />
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
      </GeometryDrawing>
      <GeometryDrawing Brush="#FFFFFF" Geometry="M 105,69 L 189,117 L 174,189 L 105,150 Z" />
    </DrawingGroup>
  </DrawingImage>
</ResourceDictionary>
