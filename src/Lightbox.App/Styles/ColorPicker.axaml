<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Lightbox.App.Controls"
        xmlns:vm="using:Lightbox.App.ViewModels"
        xmlns:docs="using:Lightbox.Core.Documents">
  <!--
    The colour picker's body, defined once.

    The Color panel and every flyout field show the same thing in the same
    order — wheel with the value slider beside it, then the readouts, then hex
    last. Two layouts that were merely similar would have to be learned twice,
    and would drift the first time one of them was touched.

    Hex sits at the bottom on purpose. Typing #c04a2f is transcribing a colour
    you already found, not choosing one; it is a readout, and it is ranked
    like one.
  -->
  <Style Selector="controls|ColorField">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center" FontSize="11"
                     IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button x:Name="PART_Swatch" Width="26" Height="22" Padding="0"
                  Background="{TemplateBinding Swatch}"
                  BorderBrush="#666" BorderThickness="1" CornerRadius="3"
                  ToolTip.Tip="Pick a colour">
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <ContentControl Content="{TemplateBinding Picker}"
                                ContentTemplate="{StaticResource ColorPickerBody}" />
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="PART_Clear" Classes="icon" Content="✕" FontSize="9"
                  Background="Transparent" BorderThickness="0"
                  IsVisible="{TemplateBinding AllowsNone}"
                  ToolTip.Tip="No colour" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Styles.Resources>
    <DataTemplate x:Key="ColorPickerBody" DataType="vm:ColorPickerViewModel">
      <StackPanel Width="248" Spacing="8">

        <!-- Wheel and value slider, side by side. The slider used to sit under
             the wheel, where a wheel tall enough to be usable pushed it out of
             view — the one control you reach for on every stroke. -->
        <Grid ColumnDefinitions="*,Auto">
          <ColorSpectrum Grid.Column="0" Shape="Ring" Components="HueSaturation"
                         Height="180"
                         HsvColor="{Binding WheelHsv, Mode=TwoWay}" />
          <ColorSlider Grid.Column="1" Orientation="Vertical" Width="22" Margin="8,0,0,0"
                       ColorModel="Hsva" ColorComponent="Component3"
                       HsvColor="{Binding WheelHsv, Mode=TwoWay}"
                       ToolTip.Tip="Value (brightness)" />
        </Grid>

        <!-- The numbers behind the colour, for reading off and for typing in. -->
        <UniformGrid Columns="3" Rows="2">
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,4,3">
            <TextBlock Text="H" Width="12" FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
            <NumericUpDown Value="{Binding Hue}" Minimum="0" Maximum="360" Increment="1"
                           FormatString="0" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,4,3">
            <TextBlock Text="S" Width="12" FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
            <NumericUpDown Value="{Binding HsvSaturation}" Minimum="0" Maximum="100" Increment="1"
                           FormatString="0" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,0,3">
            <TextBlock Text="V" Width="12" FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
            <NumericUpDown Value="{Binding HsvValue}" Minimum="0" Maximum="100" Increment="1"
                           FormatString="0" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,4,0">
            <TextBlock Text="R" Width="12" FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
            <NumericUpDown Value="{Binding Red}" Minimum="0" Maximum="255" Increment="1"
                           FormatString="0" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,4,0">
            <TextBlock Text="G" Width="12" FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
            <NumericUpDown Value="{Binding Green}" Minimum="0" Maximum="255" Increment="1"
                           FormatString="0" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Text="B" Width="12" FontSize="10" VerticalAlignment="Center" Opacity="0.7" />
            <NumericUpDown Value="{Binding Blue}" Minimum="0" Maximum="255" Increment="1"
                           FormatString="0" Width="56" />
          </StackPanel>
        </UniformGrid>

        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="Hex" Width="26" FontSize="11"
                     VerticalAlignment="Center" Opacity="0.7" />
          <TextBox Text="{Binding Hex, Mode=TwoWay}" FontSize="11"
                   ToolTip.Tip="Hex colour, e.g. #1a1a1a" />
        </DockPanel>

        <!--
          The document's palette, in every picker.

          Picking here is not the same as landing on the colour with the
          wheel: the stroke records the SWATCH, so a later recolour reaches
          the art. Offering the palette in the panel only would mean the
          convenient path — a flyout, mid-task — was also the one that
          quietly broke that link.
        -->
        <StackPanel Spacing="3" IsVisible="{Binding CanAddToPalette}">
          <!--
            The header is visible even with no palette, because that is exactly
            when "add to palette" earns its keep: it is what brings the first
            palette into being, and hiding it there would mean the only way to
            keep a colour was to go and make somewhere to keep it first.
          -->
          <DockPanel>
            <!--
              A ▾ beside the ＋, not instead of it. The common case is "into
              the one I am looking at", and making that a two-step choice to
              serve the rarer one would tax every use of the button.
            -->
            <Button DockPanel.Dock="Right" Classes="icon" Content="▾" FontSize="9"
                    Padding="3,0" Background="Transparent" BorderThickness="0"
                    IsVisible="{Binding HasPalette}"
                    ToolTip.Tip="Add it to a particular palette">
              <Button.Flyout>
                <MenuFlyout ItemsSource="{Binding PaletteTargets}">
                  <MenuFlyout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaletteTarget">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </MenuFlyout.ItemTemplate>
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                  x:DataType="vm:PaletteTarget">
                      <Setter Property="Command"
                              Value="{Binding $parent[ItemsControl].((vm:ColorPickerViewModel)DataContext).AddToNamedPaletteCommand}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button DockPanel.Dock="Right" Classes="icon" Content="＋" FontSize="10"
                    Padding="4,0" Background="Transparent" BorderThickness="0"
                    Command="{Binding AddToPaletteCommand}"
                    ToolTip.Tip="Add this colour to the palette — the selected one, or a new one if there is none yet" />
            <TextBlock Text="Palette" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding PaletteSwatches}" IsVisible="{Binding HasPalette}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="docs:Swatch">
                <Button Width="18" Height="18" Padding="0" Margin="0,0,3,3"
                        Background="{Binding Color}"
                        BorderBrush="#666" BorderThickness="1" CornerRadius="2"
                        ToolTip.Tip="{Binding Name}"
                        Command="{Binding $parent[ItemsControl].((vm:ColorPickerViewModel)DataContext).PickSwatchCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </DataTemplate>
  </Styles.Resources>
</Styles>
