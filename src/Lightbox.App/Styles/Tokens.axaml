<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The design tokens (Q203, docs/DESIGN-tokens.md). Every size, gap and type
    size the chrome uses is named here once; styles and views name the token,
    never the number. TokenRatchetTests counts what is still a literal and lets
    that count fall but never rise.

    Step 3 (Q203) set these to the new look: Tight corners, one docker label
    width, one gap scale, a 1.25 icon line. The names did not change.

    Sizes are read with StaticResource: they change through the interface
    scale (a layout transform), never by swapping a value. Colours stay in
    Palette.axaml and are read with DynamicResource, because a theme swaps them
    while the app runs.
  -->

  <!-- ===== Type ===== -->
  <!-- DESIGN.md: 12 in docker content, 11 in dense rows and option bars, 10 for
       status and hints, nothing smaller for text. -->
  <x:Double x:Key="TypeDisplay">18</x:Double>
  <x:Double x:Key="TypeTitle">15</x:Double>
  <x:Double x:Key="TypeBody">12</x:Double>
  <x:Double x:Key="TypeDense">11</x:Double>
  <x:Double x:Key="TypeHint">10</x:Double>

  <!-- ===== Spacing scale ===== -->
  <!-- Named by size. Roles (panel inset, row gap…) are step 2's decisions and
       will be named for what they do, built from these. -->
  <x:Double x:Key="Space2">2</x:Double>
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space6">6</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space10">10</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space14">14</x:Double>
  <x:Double x:Key="Space16">16</x:Double>

  <!-- ===== Density (DESIGN.md's size table; DensityScaleTests reads these) ===== -->
  <!-- DESIGN.md row: field, combo, small button, list row. -->
  <x:Double x:Key="SizeRow">24</x:Double>
  <!-- DESIGN.md tile: icon button, overlay-bar tile. -->
  <x:Double x:Key="SizeTile">26</x:Double>
  <!-- DESIGN.md tool: tool palette buttons. -->
  <x:Double x:Key="SizeTool">26</x:Double>
  <!-- DESIGN.md bar: the tool options bar's fixed row. -->
  <x:Double x:Key="SizeBar">30</x:Double>
  <!-- DESIGN.md label: label column in a labelled-row layout. -->
  <x:Double x:Key="SizeLabel">52</x:Double>
  <!-- DESIGN.md field: a numeric field's floor; it grows with the value. -->
  <x:Double x:Key="SizeField">44</x:Double>
  <!-- A numeric field's own height, two under the row. -->
  <x:Double x:Key="SizeFieldHeight">22</x:Double>

  <!-- ===== Docker content (step 2, area 1: the dockers) ===== -->
  <!-- A setting row in a docker: label · slider · value. One label width
       for every docker (Q203, step 3: one width per context; dialogs have
       their own, SizeDialogLabel, because their labels are longer prose). -->
  <x:Double x:Key="SizeDockerLabel">90</x:Double>
  <!-- The one-letter channel column: H, S, V, R, G, B. -->
  <x:Double x:Key="SizeChannelLabel">16</x:Double>
  <!-- The gap either side of a row's slider, between label and value. -->
  <Thickness x:Key="RowColumnGap">4,0</Thickness>
  <!-- Before and after a control in a row. -->
  <Thickness x:Key="GapBefore">4,0,0,0</Thickness>
  <Thickness x:Key="GapAfter">0,0,4,0</Thickness>
  <!-- Above a section, a sub-section and a following line. -->
  <Thickness x:Key="SectionGap">0,8,0,0</Thickness>
  <Thickness x:Key="SubsectionGap">0,6,0,0</Thickness>
  <Thickness x:Key="LineGap">0,4,0,0</Thickness>

  <!-- ===== Settings pages (step 2, area 2: the Configure window) ===== -->
  <!-- A settings page's inset inside the window. -->
  <Thickness x:Key="PagePadding">14</Thickness>
  <!-- A settings page's fixed field widths. Two today (120 and 110): kept
       apart so nothing moves; step 3 decides whether they are one. -->
  <x:Double x:Key="SizeSettingsField">120</x:Double>
  <x:Double x:Key="SizeSettingsFieldNarrow">110</x:Double>
  <!-- A settings page's choice list. -->
  <x:Double x:Key="SizeSettingsCombo">260</x:Double>
  <!-- An information card on a page ("Measured now"): its corners and inset. -->
  <CornerRadius x:Key="RadiusCard">6</CornerRadius>
  <!-- An image preview's corners: a brush thumbnail, a tip, an effect preview.
       Not a control (UI review, windows step). Step 3 decides whether previews
       go square with the rest of the artwork. -->
  <CornerRadius x:Key="RadiusPreview">2</CornerRadius>
  <Thickness x:Key="CardPadding">10</Thickness>

  <!-- ===== Dialogs and secondary windows (step 2, area 3) ===== -->
  <!-- A dialog's content inset. -->
  <Thickness x:Key="DialogPadding">16</Thickness>
  <!-- A dialog's label column, its small text field, its buttons' floor. -->
  <x:Double x:Key="SizeDialogLabel">110</x:Double>
  <x:Double x:Key="SizeDialogField">70</x:Double>
  <x:Double x:Key="SizeDialogButton">80</x:Double>

  <!-- ===== Icon sizes ===== -->
  <!-- Every glyph size in use. Named by size: an icon's size is its box, and
       step 3 is where they get collapsed onto fewer steps. -->
  <x:Double x:Key="SizeIcon8">8</x:Double>
  <x:Double x:Key="SizeIcon9">9</x:Double>
  <x:Double x:Key="SizeIcon10">10</x:Double>
  <x:Double x:Key="SizeIcon11">11</x:Double>
  <x:Double x:Key="SizeIcon12">12</x:Double>
  <x:Double x:Key="SizeIcon16">16</x:Double>

  <!-- ===== Radii, by role ===== -->
  <!-- The Tight corner set (Q203): controls and fields 4, containers and
       cards 6, anything nested one step in 2. Previews follow the set at the
       inner radius (owner's call, against squaring them). -->
  <CornerRadius x:Key="RadiusField">4</CornerRadius>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusContainer">6</CornerRadius>
  <CornerRadius x:Key="RadiusInner">2</CornerRadius>
  <!-- Inside a container's 2 px padding: a canvas-bar icon, a menu item, a
       dropdown's item. The container's radius less the padding, so the two
       shapes are concentric rather than two unrelated roundings. -->
  <CornerRadius x:Key="RadiusContainerInner">4</CornerRadius>
  <!-- A docker header strip's top: the container's, square below where the
       content meets it. -->
  <CornerRadius x:Key="RadiusContainerTop">6,6,0,0</CornerRadius>
  <!-- A docker tab: the control's radius on top, square where it joins its panel. -->
  <CornerRadius x:Key="RadiusTab">4,4,0,0</CornerRadius>
  <!-- Handles: a slider's thumb, a switch. Round in every corner set. -->
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- ===== Panels (Q203, step 3) ===== -->
  <!-- Inside a docker, round its content: every row starts and ends here. -->
  <Thickness x:Key="PanelPadding">12,10,12,12</Thickness>
  <!-- The override, for a docker whose content is panes that run to its
       edges (Tool options: a section list beside the settings). Inset, a
       300 px column left its sliders a few pixels wide. -->
  <Thickness x:Key="PanelPaddingFlush">0</Thickness>
  <!-- The docker's header strip: room above the tabs, none below; the active
       tab has to touch the content it belongs to. -->
  <Thickness x:Key="HeaderPadding">8,6,8,0</Thickness>
  <Thickness x:Key="TabPadding">14,6</Thickness>
  <!-- Text and icons inside a list row, from its own edge. -->
  <Thickness x:Key="ItemPadding">8,0</Thickness>
  <!-- Between one docker and the next in a column. -->
  <Thickness x:Key="DockerGap">0,0,0,6</Thickness>

  <!-- ===== Icons ===== -->
  <!-- The icon line (owner, 2026-10-07: slightly thinner than the old 1.5). -->
  <x:Double x:Key="IconStroke">1.25</x:Double>
</ResourceDictionary>
