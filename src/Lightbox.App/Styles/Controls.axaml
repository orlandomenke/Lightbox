<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Lightbox.App.Controls">

  <!--
    B126 / B255. Every tooltip opens to the right of the pointer rather than
    below it, and this is an experiment with a measurement attached rather
    than a style preference.

    Avalonia's default placement flips when the tip would collide with a
    boundary; AvaloniaUI/Avalonia#20980 and #15486 report that the flip
    invalidates the :pointerover state that triggered it, which re-runs the
    placement, forever. On a pen tablet whose driver already trades the
    pointer between two devices ~97 times a second, that loop has something
    to spin on constantly - and this application sets no placement anywhere,
    so all 345 tooltips in MainWindow.axaml alone take the flipping default.

    `Right` does not flip in the reported cycle. One setter here rather than
    345 attributes, which also makes it one line to revert if the next trace
    says it changed nothing.

    **Not claimed as the fix.** The residual UI-thread stalls appeared in a
    trace with zero popups, so the cause is not established; this tests one
    named hypothesis and the trace says whether it was right.
  -->
  <Style Selector="Control">
    <Setter Property="ToolTip.Placement" Value="Right" />
  </Style>
  <!--
    The control treatments from the design, in one place.

    Two axes, and keeping them apart is the whole reason this file is separate
    from Density.axaml. **Size is a role** — icon, text, tool — and lives there,
    because it is about hitting a control. **Emphasis is a rank** — primary,
    secondary, tertiary, ghost — and lives here, because it is about which
    control an artist should reach for first.

    They compose: `Classes="text primary"` is a text-sized button carrying the
    primary treatment. That is why the ranks below set no sizes at all. A rank
    that also set a height would silently override the role beside it, and the
    row it sat in would stop lining up — the failure DESIGN.md calls "the most
    common way this app has looked unfinished".
  -->

  <!-- ===== Buttons: four ranks ======================================== -->
  <!--
    One primary per view, and usually none. The gradient is loud on purpose:
    it means "this is the thing you came here to do", and a screen with three
    of them has told the artist nothing.
  -->
  <!-- The primary is a plain full-contrast fill (Q203): light on Dark-lit,
       near-black on Studio grey, with the text colour that reads on it. The
       coral-to-magenta gradient is the brand's, on the logo and the splash. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <!-- The ordinary button, and what most things are. -->
  <!--
    Flat (Q203, owner 2026-10-07): a quiet fill one step up from the panel, no
    rim and no shadow, on any rank or state. Rank is fill against outline
    against text, never light. The same as every unranked button (the themes'
    ButtonBackground), restated so the rank survives a theme change.
  -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter, ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- Outlined: present, clearly not the answer. -->
  <Style Selector="Button.tertiary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!--
    No box until you touch it. For the ones that would otherwise turn a panel
    into a wall of buttons — and for anything destructive, which should not be
    the most eye-catching thing in the room.
  -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!--
    A faint edge of light on text buttons (Q203, owner 2026-10-07): chrome in
    Dark-lit, prism in Studio grey, at about 40%. Icon-only, ghost and canvas
    bar buttons stay bare: an edge round a lone glyph is louder than the glyph.
    Set on the presenter in every state too, because Fluent's state styles set
    the presenter's border and outrank a plain style on the button.
  -->
  <Style Selector="Button.text:not(.ghost)">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeSubtleBrush}" />
  </Style>
  <Style Selector="Button.text:not(.ghost) /template/ ContentPresenter#PART_ContentPresenter, Button.text:not(.ghost):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.text:not(.ghost):pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeSubtleBrush}" />
  </Style>
  <Style Selector="ToggleSwitch /template/ Border#OuterBorder, ToggleSwitch /template/ Border#SwitchKnobBounds">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeSubtleBrush}" />
  </Style>

  <!--
    The active field (Q203): a field being typed in and a dropdown that is open
    take the edge light at FULL strength. Focus has to be found at a glance,
    and the faint version reads as decoration. Thickness stays 1, so focusing
    moves nothing. Number fields too: their typing surface is a TextBox.
  -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- A field is a well: shade at the top, where the light does not reach. -->
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="{DynamicResource InsetShadow}" />
  </Style>
  <!-- A dropdown is text at rest (the themes give it no ground): no border. -->
  <Style Selector="ComboBox">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    "On" is flat (Q203, owner 2026-10-07, after trying a glow, rim and
    indicator and rejecting them): the tool in hand, a toggle that is on, the
    layer being drawn on, the menu item opened, all take one quiet lighter
    fill, ActiveFillBrush, so "on" reads the same everywhere. Hover is the same
    shape at half that fill (HoverTintBrush). A glyph toggle is excluded: its
    drawing is the state.
  -->
  <Style Selector="ToggleButton:checked:not(.glyph) /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:not(.glyph):pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ActiveFillBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- A tool at rest is its icon alone. -->
  <Style Selector="ToggleButton.tool:not(:checked) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.tool:pointerover:not(:checked) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
  </Style>
  <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusContainerInner}" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot, MenuItem:open /template/ Border#PART_LayoutRoot, MenuItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ActiveFillBrush}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusContainerInner}" />
  </Style>
  <Style Selector="ComboBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusContainerInner}" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusInner}" />
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
  </Style>

  <!-- ===== Badges ==================================================== -->
  <!--
    Four meanings, named for the meaning rather than the colour. A badge is a
    label with a state, not a button: it never takes a click, so it never
    carries a hover.

    Tinted grounds rather than filled ones. A solid amber block beside a solid
    red one reads as two warnings shouting; the text carries the message and
    the colour only says which kind it is.
  -->
  <!-- Badges follow the corner set with the controls (owner, 2026-10-07). -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource TypeDense}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    A sentence the artist should read before pressing the button under it: a
    tinted ground and a one-pixel border in the state's colour. Not a surface —
    see StatusInfoSurfaceBrush for why a surface cannot work inside a dialog.
  -->
  <Style Selector="Border.notice">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{DynamicResource StatusWarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
  </Style>
  <Style Selector="Border.notice.info">
    <Setter Property="Background" Value="{DynamicResource StatusInfoSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
  </Style>

  <Style Selector="Border.badge.info">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
  </Style>
  <Style Selector="Border.badge.info > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
  </Style>

  <Style Selector="Border.badge.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
  </Style>
  <Style Selector="Border.badge.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
  </Style>

  <Style Selector="Border.badge.error">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
  </Style>
  <Style Selector="Border.badge.error > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
  </Style>

  <Style Selector="Border.badge.success">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBrush}" />
  </Style>
  <Style Selector="Border.badge.success > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
  </Style>

  <!-- ===== Tabs ====================================================== -->
  <!--
    The docker headers that tabbing just introduced, and any tab strip after
    them. Scoped by the strip rather than by a class on each item, because the
    items are generated and `Classes` cannot be set from a Setter — it is a
    collection, and trying produces a XAML load failure at runtime rather than
    a build error. The active tab is the one carrying full-strength text; the others
    step back rather than being greyed out — a tab you can barely read looks
    disabled, and these are all reachable.

    **The design has two kinds of tab and they are not interchangeable.** The
    reference in `docs/design/` shows both, and the difference is what they
    divide:

    * **Panel tabs** — Layers / Channels / History, and these docker headers.
      The active one is a piece of its panel rising into the header strip
      (v.2, below). No accent anywhere.
    * **Section tabs** — PAINT / ANIMATE / COMPOSITING, and the timeline's
      modes. No ground at all, and an underline. They divide a *mode*
      rather than a stack of panels, so there is nothing behind them to be
      behind.
  -->
  <!--
    The tab's shape and its bottom rule, as a style rather than as attributes in
    the template below: a template value outranks a plain style, so a look tried
    in tools/Lightbox.Gallery (Q203) could not change a resting tab. Same values.
    The :selected styles further down were always able to override them — a
    style with a state in its selector outranks the template — which is why the
    active tab already behaved and the resting ones did not.
  -->
  <!--
    v.2 (Q203, owner 2026-10-07), and it replaces the sheet-edge treatment
    described above: the header is a darker strip (AppStyles.axaml), and the
    active tab is a piece of the panel rising into it, the same surface as the
    content, rounded on top, no line between them. A tab means "this panel's
    content is showing", and v.2 draws exactly that. Resting tabs are words on
    the strip; hover is the active tab's own shape at half its weight. Chosen
    over a pill bar because the pill is the segmented selector, and a tab that
    looked like one would blur "switch view" with "pick a value". No outline,
    no rule, no violet line: the surface is the whole statement.
  -->
  <Style Selector="ListBox.tabs > ListBoxItem /template/ Border#PART_Tab">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusTab}" />
    <!-- An edge nobody sees, and it is the click target. A border rounded on
         top only, with no border at all, took no hit over its fill: a resting
         tab answered only on its word (DockerDragRoutingTests found it, and a
         near-transparent ground did not help). One transparent pixel along the
         bottom, in every state so the tabs stay one height. -->
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- A docker's tabs are clicked, never keyboard-walked: a focused tab took
       Left/Right for itself, swallowing the timeline's frame step and
       switching the docker to its neighbouring panel instead. -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ListBox.tabs > ListBoxItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="{StaticResource TabPadding}" />
    <Setter Property="MinHeight" Value="{StaticResource SizeRow}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!--
          Named and always present, rather than a border added on selection. A
          box that appears on click changes the strip's height as tabs are
          picked; one that is always there and only changes colour does not.
        -->
        <Border Name="PART_Tab"
                Background="{TemplateBinding Background}">
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- Hover is the active tab's own shape at half its weight, so the strip
       never shows a differently rounded block (Q203). -->
  <Style Selector="ListBox.tabs > ListBoxItem:pointerover /template/ Border#PART_Tab">
    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
  </Style>
  <!--
    After the hover rules, not before. Avalonia takes the last matching style,
    so a selected tab under the pointer would otherwise lose its ground to the
    hover tint — the active tab going *dimmer* when you point at it, which
    looks like a click that failed.
  -->
  <Style Selector="ListBox.tabs > ListBoxItem:selected /template/ Border#PART_Tab, ListBox.tabs > ListBoxItem:selected:pointerover /template/ Border#PART_Tab">
    <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
  </Style>
  <!--
    Both halves, and the second is the one that does the work: the theme sets a
    selected item's Foreground on the ContentPresenter, which beats anything
    inherited from the ListBoxItem. Setting only the item leaves the active tab
    looking right by the theme's accident rather than by this rule, and the day
    the theme changes its selected colour the tab strip changes with it for no
    reason anybody can find.
  -->
  <Style Selector="ListBox.tabs > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.tabs > ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <!--
    No hover tint on the presenter: the tab's own shape (PART_Tab) carries
    hover, and a tint behind the word would be a second box inside it.
  -->
  <Style Selector="ListBox.tabs > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===== Glyph toggles ============================================= -->
  <!--
    The eye, the lock, the onion skin: buttons whose STATE is the icon.

    The old treatment was Fluent's — a checked toggle fills with the accent —
    so a layers panel was a column of purple boxes that said "on" in colour
    and nothing in shape. The owner's call: one button colour with a hover,
    the glyph swaps (open eye / closed eye), the off state dims, and the
    only purple left is a subtle press flash. State you can read at a
    glance without decoding a colour scheme, and it survives the accent
    being retuned.

    The recipe composes with `.icon` (the 26px square from Density.axaml):
    `Classes="icon glyph eye"` is a square, quiet, stateful eye button.
  -->
  <Style Selector="ToggleButton.glyph">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.glyph /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.glyph:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
  </Style>
  <Style Selector="ToggleButton.glyph:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.glyph:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
  </Style>
  <Style Selector="ToggleButton.glyph:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressTintBrush}" />
  </Style>
  <Style Selector="ToggleButton.glyph:checked:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressTintBrush}" />
  </Style>

  <Style Selector="ToggleButton.glyph Path">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="{StaticResource IconStroke}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <!-- Off is dimmer AND a different drawing; either alone is squintable. -->
  <Style Selector="ToggleButton.glyph:not(:checked) Path">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="ToggleButton.eye Path">
    <Setter Property="Data" Value="{StaticResource IconEyeClosed}" />
  </Style>
  <Style Selector="ToggleButton.eye:checked Path">
    <Setter Property="Data" Value="{StaticResource IconEyeOpen}" />
  </Style>
  <!-- Inside a hidden folder: the row's own switch may well be on, and it
       draws nothing all the same. The eye says what the canvas does — shut,
       and as quiet as an eye that was turned off — while IsChecked keeps what
       the artist set, so showing the folder again puts every eye back.
       After `:checked` above, because of two styles at one level the later
       wins. -->
  <Style Selector="ToggleButton.eye.gated Path">
    <Setter Property="Data" Value="{StaticResource IconEyeClosed}" />
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.lock Path">
    <Setter Property="Data" Value="{StaticResource IconLockOpen}" />
  </Style>
  <Style Selector="ToggleButton.lock:checked Path">
    <Setter Property="Data" Value="{StaticResource IconLockClosed}" />
  </Style>
  <Style Selector="ToggleButton.alpha Path">
    <Setter Property="Data" Value="{StaticResource IconAlphaLock}" />
  </Style>
  <Style Selector="ToggleButton.onion Path">
    <Setter Property="Data" Value="{StaticResource IconOnionOff}" />
  </Style>
  <Style Selector="ToggleButton.onion:checked Path">
    <Setter Property="Data" Value="{StaticResource IconOnionOn}" />
  </Style>

  <!--
    Any drawn icon that is not part of a stateful pair: the Path opts in with
    Classes="icon" and gets the set's one stroke treatment. The size is the
    Path's, not the button's — a 13px drawing sits in a 26px tile, a caption
    ✕ shrinks itself inline — so the button keeps whatever role (icon, text,
    tool) it already had. The default size lives in Density.axaml with the
    rest of the scale.
  -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="{StaticResource IconStroke}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <!-- Text content dims itself through Foreground when a button disables;
       a stroked Path has to be told. -->
  <Style Selector="Button:disabled Path.icon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="ToggleButton:disabled Path.icon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!--
    Overlay-bar glyphs: the shortcut bar's tiles all share one chrome, so a
    stateful glyph there keeps the TILE look of its neighbours — only the
    drawing swaps. The .glyph chrome (transparent, dim-when-off) is for rows
    whose ground carries the colour; a tile carries its own.
  -->
  <Style Selector="controls|CanvasOverlayBar ToggleButton Path">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="{StaticResource IconStroke}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <!--
    The canvas bar (Q203, owner 2026-10-07): only icons are visible. No fill,
    rim or glow at rest; the one that is on gets the flat active fill, fitting
    the bar exactly, its corners one padding smaller than the bar's so the two
    shapes are concentric. Set on the control as well as the presenter: the
    presenter's background is a template binding, which outranks a style.
  -->
  <Style Selector="controls|CanvasOverlayBar Button, controls|CanvasOverlayBar ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="controls|CanvasOverlayBar Button /template/ ContentPresenter#PART_ContentPresenter, controls|CanvasOverlayBar ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusContainerInner}" />
  </Style>
  <Style Selector="controls|CanvasOverlayBar Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, controls|CanvasOverlayBar ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
  </Style>
  <Style Selector="controls|CanvasOverlayBar ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter, controls|CanvasOverlayBar ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ActiveFillBrush}" />
  </Style>
  <!-- The bars' plain buttons (zoom, rotate, play) wear the same 15px drawing
       as the tiles beside them, so the grid keeps one weight throughout. -->
  <Style Selector="controls|CanvasOverlayBar Button Path">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="{StaticResource IconStroke}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!--
    The corner mark for a tool with variants: hold the button and the list
    opens. A filled notch rather than a glyph, because it is a property of the
    button, not part of the icon.
  -->
  <Style Selector="Path.variantmark">
    <!-- A wedge whose outer edge follows the button's own rounded corner, so
         it reads as part of the button rather than a sticker on it. Violet:
         it is an affordance, and affordances wear the accent. -->
    <Setter Property="Data" Value="M8,0 L8,4 A4,4 0 0 1 4,8 L0,8 Z" />
    <Setter Property="Fill" Value="{DynamicResource AccentVioletBrush}" />
    <Setter Property="Stroke" Value="{x:Null}" />
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Stretch" Value="Fill" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <!-- The mark pins to the BUTTON's corner, not the content box: the
         button pads its content 4px horizontally, so without the negative
         margin the wedge floated toward the centre. -3 backs out the
         padding and leaves the same 1px breath it has vertically. -->
    <Setter Property="Margin" Value="0,0,-3,1" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- The tool rail's glyphs: quiet at rest, full-strength on the active tool. -->
  <Style Selector="ToggleButton.tool Path:not(.variantmark)">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="{StaticResource IconStroke}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="ToggleButton.tool:checked Path:not(.variantmark)">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked Path.variantmark">
    <Setter Property="Fill" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <!-- ===== Floating chrome =========================================== -->
  <!--
    Context menus and flyouts are cards too: same radius as the dockers, so
    everything that floats shares one shape language. The elevated surface
    they already have; this is the missing half of the card.
  -->
  <Style Selector="MenuFlyoutPresenter, FlyoutPresenter, ContextMenu, ToolTip">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}" />
  </Style>
  <!-- What floats takes the edge light (Q203): it is above everything else. -->
  <Style Selector="MenuFlyoutPresenter, FlyoutPresenter, ContextMenu">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
  </Style>

  <!--
    The brush editor's popup is as wide as the editor and never scrolls.

    A flyout's presenter is a ScrollViewer with Fluent's ceiling on it — 456
    wide — and scroll bars for whatever does not fit. The editor is 780 by
    design: an option list, the chosen option and a scratchpad, side by side.
    So the popup showed the left 454 pixels of it with a horizontal scroll bar
    underneath and the scratchpad out of sight to the right (the owner's
    report, 2026-10-09).

    The editor sets its own width, and scrolls the one part of itself that can
    be long — the chosen option — so sideways the popup has nothing left to
    decide and is told to decide nothing.

    Its HEIGHT ceiling and its vertical scroll bar are left exactly as Fluent
    has them, on purpose. The editor stops at 600, under that ceiling, so the
    bar never shows; but it is the only thing that would make the foot of the
    editor reachable on a screen too short for it, and taking it away to be
    tidy would trade a scroll bar nobody sees for a popup nobody can finish.
  -->
  <Style Selector="FlyoutPresenter.brushEditor">
    <Setter Property="MaxWidth" Value="Infinity" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- ===== Section tabs ============================================== -->
  <!--
    The second tab kind: flush text with a bottom highlight, for strips that
    divide a MODE rather than a stack of panels — the workspace picker first,
    the timeline's modes when they arrive. No ground, no box; the underline is
    the whole statement, which is why it is the accent.
  -->
  <Style Selector="ListBox.sectiontabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.sectiontabs > ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="{StaticResource TypeDense}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
          <Border Name="PART_Underline" Height="2" Margin="4,0"
                  VerticalAlignment="Bottom" CornerRadius="{StaticResource RadiusPill}"
                  Background="Transparent" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <!--
    Transparent in every state, set here because Fluent sets Background ON THE
    ITEM when it is selected and the template binds it — without these the
    "flush text" tab wears the theme's violet pill, which is the exact box
    this treatment exists to not have.
  -->
  <Style Selector="ListBox.sectiontabs > ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sectiontabs > ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sectiontabs > ListBoxItem:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sectiontabs > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <!-- Fluent paints its selection colour straight onto any presenter named
         PART_ContentPresenter, template ownership notwithstanding — the same
         way the docker tabs learned it. -->
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sectiontabs > ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sectiontabs > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Full-strength text colour, not violet: the chrome is grey (Q203). -->
  <Style Selector="ListBox.sectiontabs > ListBoxItem:selected /template/ Border#PART_Underline">
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.sectiontabs > ListBoxItem:pointerover /template/ Border#PART_Underline">
    <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
  </Style>

  <!-- ===== Sliders =================================================== -->
  <!--
    The filled part of the track carries the accent gradient, so a glance says
    roughly where the value sits without reading the number beside it. The
    number is still there — DESIGN.md's rule is slider *plus* field, because a
    value explored by feel still has to be typed exactly sometimes.

    **The gradient spans the filled part, not the whole track**, which is what a
    brush on `Foreground` gives without retemplating the control. The trade is
    that the colours travel as the value changes rather than staying put; at the
    widths these sliders actually are — a docker column, not a page — that reads
    as one warm bar rather than as a moving smear, which is why it is not worth
    a template to fix. If a slider ever gets long enough for it to show, the fix
    is a track-spanning gradient in the template, not a flat colour here.

    The thumb is the theme's, and now agrees, because the theme's accent is
    ours. Before it was #0078D7 against a coral track — one control wearing two
    colour systems, and the clearest evidence that repointing the theme was the
    missing half of the palette rather than a polish item.
  -->
  <!-- The value side of a track: the theme's neutral fill (Q203: the chrome
       is grey; colour is for data). -->
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource SliderTrackValueFill}" />
  </Style>

  <!-- ===== Toggles and checks ======================================== -->
  <!--
    Only the label. The checked grounds used to be set here — the switch to the
    gradient, the box to violet — and both are gone, because the theme's accent
    is now violet and it already paints them. Two rules had to hold at once and
    the setters broke the second: **one colour means "on"**, and a switch
    wearing the gradient while the checkbox beside it wore violet said "on" in
    two voices. Leaving it to the accent is also what makes the next control
    nobody has styled yet come out right by default.
  -->
  <!--
    Caption buttons are FLAT — no rim light, no card: they are part of the
    window's edge, not controls sitting on a surface. The close button's
    hover is the one red in the chrome, because "this ends the session" is
    the one meaning strong enough to earn it.
  -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.caption /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <!-- The docker's float button: a window-with-arrow floats a docked panel,
       and on a floating one the same button reads as an arrow into the corner
       and docks it back where it came from. Content is a placeholder for the
       template to bite on; the drawing lives in the ContentTemplate because a
       style cannot hand the same Path instance to every docker. -->
  <Style Selector="controls|Docker /template/ Button#PART_Float">
    <Setter Property="Content" Value="" />
    <Setter Property="ContentTemplate">
      <DataTemplate>
        <Path Classes="icon" Width="11" Height="11" Data="{StaticResource IconFloat}" />
      </DataTemplate>
    </Setter>
    <Setter Property="ToolTip.Tip" Value="Float this panel in its own window" />
  </Style>
  <Style Selector="controls|Docker[IsFloating=True] /template/ Button#PART_Float">
    <Setter Property="ContentTemplate">
      <DataTemplate>
        <Path Classes="icon" Width="11" Height="11" Data="{StaticResource IconDock}" />
      </DataTemplate>
    </Setter>
    <Setter Property="ToolTip.Tip" Value="Dock this panel back where it came from" />
  </Style>

  <!-- A layer row in a multi-selection is styled in LayerRows.axaml, beside
       the row's base and active styles: B400 records why it cannot live here. -->

  <!--
    The layer row's mask chip: a small pane beside the thumbnail. Solid while
    the mask applies, hollow while disabled, and outlined in cyan while
    strokes are landing on it — the mode must never be invisible, or the next
    mark goes somewhere the artist did not mean. Deliberately not a glyph
    toggle like the eye and the lock: those switch a state, this is a second
    *surface* you draw on, and it reads as a pane for that reason. Cyan is
    the chosen-state accent, the lockedLayer precedent. Here beside
    `.selected` for the same reason it is: the row template stays in
    MainWindow.axaml, whose ratchet is why no style joins it that can live
    application-wide.
  -->
  <Style Selector="Border.maskChip">
    <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource FieldGroundHoverBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.maskChip.disabledMask">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.maskChip.editing">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- The fx chip: the mask chip's pattern for the effect stack — filled
       while the stack runs, hollow while its master switch is off (Q158). -->
  <Style Selector="Border.fxChip">
    <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource FieldGroundHoverBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.fxChip.disabledFx">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!--
    A clipped layer indents behind an accent bar, Photoshop's own visual: the
    bar says "this rides on the layer below". 10px because it is an indent,
    not a control — wide enough to read as one, narrower than the 14px folder
    indent so the two stay tellable apart.
  -->
  <Style Selector="Border.clipBar">
    <Setter Property="Width" Value="10" />
  </Style>

  <!-- The effects docker's selected row — the stack entry whose sliders are
       showing. The weak selection tint, like a docker row that is selected
       but not active. -->
  <Style Selector="Border.selectedFx">
    <Setter Property="Background" Value="{DynamicResource SelectionWeakBrush}" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!--
    Every numeric field does arithmetic: type 50+10 or 128 / 2 and commit.
    One style rather than ninety-six attributes, and any field added later
    gets it without having heard of it. The behaviour lives in FieldMath;
    this is only the registration.
  -->
  <Style Selector="NumericUpDown">
    <Setter Property="(controls:FieldMath.Enabled)" Value="True" />
  </Style>
</Styles>
