<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lightbox.App.ViewModels"
             xmlns:render="using:Lightbox.App.Rendering"
             x:Class="Lightbox.App.Views.ChannelsPanel"
             x:DataType="vm:MainViewModel">
  <!--
    The Channels docker's content, extracted when the silhouette tile pushed
    MainWindow.axaml over its ratchet — the budget forcing the arrangement it
    exists to force. Five tiles, one shape: a thumbnail, a name, and the one
    ToggleChannelSolo command with the tile's enum member as its parameter.
    Everything here is view-only (invariant 5): the record never hears which
    channel the canvas is showing.
  -->
  <StackPanel Spacing="4" Margin="2">
    <ToggleButton IsChecked="{Binding IsRedSolo, Mode=OneWay}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Padding="4"
                  Command="{Binding ToggleChannelSoloCommand}"
                  CommandParameter="{x:Static render:ChannelSolo.Red}"
                  ToolTip.Tip="View the red channel alone — click again for all channels">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="64" Height="36" CornerRadius="3"
                ClipToBounds="True" Margin="0,0,8,0">
          <Image Source="{Binding ChannelThumbRed}" Stretch="Uniform" />
        </Border>
        <TextBlock Text="Red" VerticalAlignment="Center" FontSize="12" />
      </DockPanel>
    </ToggleButton>
    <ToggleButton IsChecked="{Binding IsGreenSolo, Mode=OneWay}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Padding="4"
                  Command="{Binding ToggleChannelSoloCommand}"
                  CommandParameter="{x:Static render:ChannelSolo.Green}"
                  ToolTip.Tip="View the green channel alone — click again for all channels">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="64" Height="36" CornerRadius="3"
                ClipToBounds="True" Margin="0,0,8,0">
          <Image Source="{Binding ChannelThumbGreen}" Stretch="Uniform" />
        </Border>
        <TextBlock Text="Green" VerticalAlignment="Center" FontSize="12" />
      </DockPanel>
    </ToggleButton>
    <ToggleButton IsChecked="{Binding IsBlueSolo, Mode=OneWay}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Padding="4"
                  Command="{Binding ToggleChannelSoloCommand}"
                  CommandParameter="{x:Static render:ChannelSolo.Blue}"
                  ToolTip.Tip="View the blue channel alone — click again for all channels">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="64" Height="36" CornerRadius="3"
                ClipToBounds="True" Margin="0,0,8,0">
          <Image Source="{Binding ChannelThumbBlue}" Stretch="Uniform" />
        </Border>
        <TextBlock Text="Blue" VerticalAlignment="Center" FontSize="12" />
      </DockPanel>
    </ToggleButton>
    <ToggleButton IsChecked="{Binding IsAlphaSolo, Mode=OneWay}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Padding="4"
                  Command="{Binding ToggleChannelSoloCommand}"
                  CommandParameter="{x:Static render:ChannelSolo.Alpha}"
                  ToolTip.Tip="View coverage alone — transparent is black, solid is white. Click again for all channels">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="64" Height="36" CornerRadius="3"
                ClipToBounds="True" Margin="0,0,8,0">
          <Image Source="{Binding ChannelThumbAlpha}" Stretch="Uniform" />
        </Border>
        <TextBlock Text="Alpha" VerticalAlignment="Center" FontSize="12" />
      </DockPanel>
    </ToggleButton>
    <ToggleButton IsChecked="{Binding IsSilhouette, Mode=OneWay}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Padding="4"
                  Command="{Binding ToggleChannelSoloCommand}"
                  CommandParameter="{x:Static render:ChannelSolo.Silhouette}"
                  ToolTip.Tip="View the ink as solid black on white — does the pose read from the shape alone? Paper, references and ghosts are left out. Click again for the normal view">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="64" Height="36" CornerRadius="3"
                ClipToBounds="True" Margin="0,0,8,0">
          <Image Source="{Binding ChannelThumbSilhouette}" Stretch="Uniform" />
        </Border>
        <TextBlock Text="Silhouette" VerticalAlignment="Center" FontSize="12" />
      </DockPanel>
    </ToggleButton>
    <TextBlock Text="Viewing only — the drawing is untouched." FontSize="11" Opacity="0.55"
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
