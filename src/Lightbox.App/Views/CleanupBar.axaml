<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lightbox.App.ViewModels"
             x:Class="Lightbox.App.Views.CleanupBar"
             x:DataType="vm:MainViewModel">
  <!--
    The line cleaner on the timeline bar (Q292-Q295). One button, with the
    verbs and the opt-in behind it, because a cleanup is an occasional verb
    and the bar is crowded; and the strip that offers Apply and Cancel while a
    preview waits. The control sits last on the bar so that the strip,
    appearing, pushes nothing the artist was aiming at (ui-critic).
  -->
  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
    <Button Content="Clean ▾" ToolTip.Tip="Tidy this drawing's lines — previewed first, nothing changes until you apply">
      <Button.Flyout>
        <Flyout Placement="Top">
          <StackPanel Width="{StaticResource SizeSettingsCombo}" Spacing="{StaticResource Space8}">
            <TextBlock Text="Clean lines" FontWeight="SemiBold" FontSize="{StaticResource TypeBody}" />
            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TypeHint}" Opacity="0.6"
                       Text="Smooths wobble and kinks, trims overshoots, closes small gaps and removes specks. Smoothing moves no line further than it is wide; lines are never merged or added." />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
              <ComboBox ItemsSource="{Binding CleanupStrengths}" SelectedItem="{Binding CleanupStrength}"
                        MinWidth="{StaticResource SizeDialogLabel}"
                        ToolTip.Tip="How hard the cleaner smooths a drawing on its own" />
              <Button Content="Clean lines…" Command="{Binding CleanLinesCommand}"
                      ToolTip.Tip="The drawing under the playhead, or the cels picked on this layer" />
            </StackPanel>
            <Button Content="Clean lines toward keys…" Command="{Binding CleanLinesTowardKeysCommand}"
                    ToolTip.Tip="Clean toward the key or breakdown either side: as smooth as they are, lines meeting the way theirs meet" />
            <CheckBox Content="Clean new inbetweens" IsChecked="{Binding CleanNewInbetweens}"
                      ToolTip.Tip="Clean each inbetween toward its keys as it is made, in the same undo step. Keys and breakdowns are never touched" />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" IsVisible="{Binding IsCleanupPending}">
      <TextBlock Text="{Binding CleanupSummary}" VerticalAlignment="Center" MaxWidth="{StaticResource SizeDialogWidth}"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CleanupSummary}" />
      <Button Content="Apply" Command="{Binding ApplyCleanupCommand}" Classes="primary" ToolTip.Tip="Write the cleanup — one undo step" />
      <Button Content="Cancel" Command="{Binding CancelCleanupCommand}" Classes="tertiary" ToolTip.Tip="Leave the drawing exactly as it is (Esc)" />
    </StackPanel>
  </StackPanel>
</UserControl>
