<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Lightbox.App.Views"
        x:Class="Lightbox.App.Views.UpdateFromTemplateWindow"
        Title="Update from template"
        Icon="/Assets/lightbox.ico"
        Width="460" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource Space10}">

    <TextBlock Text="Pull forward from the template" FontWeight="SemiBold" />
    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TypeDense}" Opacity="0.7"
               Text="Your drawings and your timing are never touched. Tick what you want to bring over." />

    <StackPanel x:Name="NothingPanel" Spacing="{StaticResource Space6}" IsVisible="False">
      <TextBlock TextWrapping="Wrap"
                 Text="Nothing to pull — this document already matches its template." />
    </StackPanel>

    <StackPanel x:Name="ChangesPanel" Spacing="{StaticResource Space8}">
      <CheckBox x:Name="NewLayersBox" IsChecked="True" />
      <CheckBox x:Name="LayerPropertiesBox" IsChecked="True" />
      <CheckBox x:Name="GuidesBox" IsChecked="True" />
      <CheckBox x:Name="FpsBox" IsChecked="True" />
      <CheckBox x:Name="CameraBox" IsChecked="True" />

      <!-- The load-bearing part of the design: a layer with work on it is
           skipped unless the artist says otherwise, one layer at a time. -->
      <StackPanel x:Name="DrawnOnPanel" Spacing="{StaticResource Space4}" IsVisible="False">
        <TextBlock Text="Layers you have drawn on" FontWeight="SemiBold" FontSize="{StaticResource TypeBody}" Margin="{StaticResource SubsectionGap}" />
        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TypeHint}" Opacity="0.6"
                   Text="Skipped by default, because a pull should not rename or re-blend a layer you have been painting on. Tick one to include it anyway." />
        <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="DrawnOnList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="views:TemplatePullRow">
                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" Content="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>

    <UniformGrid x:Name="ButtonRow" Rows="1" ColumnSpacing="8" HorizontalAlignment="Right" Margin="{StaticResource SubsectionGap}">
      <Button Classes="tertiary" Content="Cancel" Click="OnCancel" IsCancel="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
      <Button Classes="primary" x:Name="ApplyButton" Content="Update" Click="OnApply" IsDefault="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
    </UniformGrid>
  </StackPanel>
</Window>
