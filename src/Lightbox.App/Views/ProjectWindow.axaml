<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lightbox.App.ViewModels"
        xmlns:proj="using:Lightbox.Core.Projects"
        x:Class="Lightbox.App.Views.ProjectWindow"
        x:DataType="vm:ProjectWindowViewModel"
        Width="1080" Height="700" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        Icon="/Assets/lightbox.ico">

  <!--
    Q41. Its own window rather than a docker: the whole point is columns —
    tags, status, assignee, length — and a docker strip is 200 pixels. It can
    also sit on a second monitor while the canvas keeps the first, which is
    what "between drawings" means in practice.
  -->

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="Background" Value="{StaticResource HoverTintBrush}" />
    </Style>
    <Style Selector="Border.bar">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="{StaticResource BandTintBrush}" />
    </Style>
    <!--
      Where a drag would land: a line above the row it would be placed
      before, a tint on the folder it would be filed into. The classes are
      bound to the row's DropAbove/DropInto, which the drag-over handling
      sets — so the indicator is state the row shows, not an adorner the
      window has to place.
    -->
    <Style Selector="Border.rowShell">
      <Setter Property="BorderThickness" Value="0,2,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.rowShell.dropAbove">
      <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
    </Style>
    <Style Selector="Border.rowShell.dropInto">
      <Setter Property="Background" Value="{StaticResource HoverTintBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!--
      The one thing on every tab: what the project holds and what is wrong
      with it, which is the sentence somebody opens this window to read. One
      place counting, because three would drift.
    -->
    <Border DockPanel.Dock="Bottom" Classes="bar">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="dim" Text="{Binding Status}"
                   TextTrimming="CharacterEllipsis" MaxWidth="420" />
        <TextBlock Classes="dim" Text="{Binding Summary}" />
      </DockPanel>
    </Border>

    <!--
      Filters sit above the tabs rather than inside one, because narrowing to
      a tag is a question about the project and every tab should answer the
      same question the same way. Filtering the tree and then finding the
      board showing something else would be two projects on screen.
    -->
    <Border DockPanel.Dock="Top" Classes="bar">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="head" VerticalAlignment="Center" Text="TAG" />
        <ComboBox MinWidth="140" ItemsSource="{Binding TagsInUse}"
                  SelectedItem="{Binding TagFilter}"
                  PlaceholderText="every tag" />
        <Button Command="{Binding ClearTagFilterCommand}"
                ToolTip.Tip="Show every row again">
          <Path Classes="icon" Width="10" Height="10" Data="{StaticResource IconClose}" />
        </Button>
        <TextBlock Classes="head" VerticalAlignment="Center" Margin="10,0,0,0" Text="WHO" />
        <ComboBox MinWidth="140" ItemsSource="{Binding People}"
                  SelectedItem="{Binding AssigneeFilter}"
                  PlaceholderText="everybody">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PersonChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Command="{Binding ClearAssigneeFilterCommand}"
                ToolTip.Tip="Show everybody's rows again">
          <Path Classes="icon" Width="10" Height="10" Data="{StaticResource IconClose}" />
        </Button>
      </StackPanel>
    </Border>

    <TabControl>

      <!-- ============================ STRUCTURE ============================ -->
      <TabItem Header="Structure">
        <DockPanel>

          <!--
            Bulk edits. The docker deliberately has no multi-select — a bulk
            operation is what you do between drawings rather than during one —
            so this bar is the difference between the two surfaces made
            visible. Q44: no undo, so every one of these says what it did.
          -->
          <Border DockPanel.Dock="Bottom" Classes="bar"
                  IsVisible="{Binding HasSelection}">
            <WrapPanel>
              <TextBlock Classes="head" VerticalAlignment="Center" Margin="0,0,6,0"
                         Text="{Binding SelectionLabel}" />
              <ComboBox MinWidth="120" Margin="0,0,6,0"
                        ItemsSource="{Binding StatusChoices}"
                        SelectedItem="{Binding StatusToApply}"
                        PlaceholderText="set status…">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StatusChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox MinWidth="120" Margin="0,0,6,0"
                        ItemsSource="{Binding AssignChoices}"
                        SelectedItem="{Binding PersonToApply}"
                        PlaceholderText="assign to…">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PersonChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Width="130" Margin="0,0,4,0" Text="{Binding TagToApply}"
                       Watermark="tag…" />
              <Button Content="Tag" Margin="0,0,4,0"
                      Command="{Binding TagSelectionCommand}"
                      CommandParameter="{Binding TagToApply}" />
              <Button Content="Untag"
                      Command="{Binding UntagSelectionCommand}"
                      CommandParameter="{Binding TagToApply}" />
              <!--
                Q25 re-answered: the window is where a sheet is re-assigned.
                Only offered while a sheet is selected — a document is moved in
                the docker, and offering two movers for one thing invites the
                question of why they differ.
              -->
              <ComboBox MinWidth="150" Margin="6,0,0,0"
                        IsVisible="{Binding HasSheetSelection}"
                        ItemsSource="{Binding SheetHomeChoices}"
                        SelectedItem="{Binding SheetHomeToApply}"
                        PlaceholderText="file sheet in…">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SheetHomeChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </WrapPanel>
          </Border>

          <!--
            Q39 put the facet list behind a click and kept it off every row so a
            tree of forty stays scannable. This is the other half of that trade:
            the place the facets are *edited*, which is what makes read-only rows
            an acceptable cost rather than a gap.
          -->
          <Border DockPanel.Dock="Right" Width="250" Classes="bar"
                  IsVisible="{Binding IsEditingFolder}">
            <ScrollViewer>
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding EditingFolderName}" FontWeight="SemiBold" />

                <StackPanel Spacing="2">
                  <TextBlock Classes="head" Text="NOTES" />
                  <TextBox Text="{Binding FolderNotes}" AcceptsReturn="True"
                           MinHeight="54" TextWrapping="Wrap"
                           Watermark="what this folder is, in your words" />
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Classes="head" Text="PIVOT" />
                  <CheckBox IsChecked="{Binding FolderHasPivot}"
                            Command="{Binding TogglePivotCommand}"
                            Content="Asset export registers on a pivot"
                            ToolTip.Tip="Without one, frames register on the canvas instead" />
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Classes="head" Text="READING" />
                  <TextBlock Classes="dim" TextWrapping="Wrap"
                             Text="{Binding FolderReadingLabel}"
                             IsVisible="{Binding FolderHasReading}" />
                  <TextBlock Classes="dim" TextWrapping="Wrap"
                             IsVisible="{Binding !FolderHasReading}"
                             Text="Nothing has read this folder. Right-click it in the Project panel to." />
                  <CheckBox IsVisible="{Binding FolderHasReading}"
                            Command="{Binding MarkReadingReviewedCommand}"
                            Content="This reading is mine"
                            ToolTip.Tip="A re-read refuses rather than overwriting it" />
                  <!--
                    Q35: the specific list, never a bare "are you sure". With the
                    facets behind a click this sentence is the only place an
                    artist is told, and it is told at the moment of the act.
                  -->
                  <TextBlock Classes="dim" TextWrapping="Wrap" Foreground="{StaticResource StatusWarningBrush}"
                             Text="{Binding WhatClearingCosts}"
                             IsVisible="{Binding FolderHasReading}" />
                  <Button Content="Clear the reading" HorizontalAlignment="Left"
                          IsVisible="{Binding FolderHasReading}"
                          Command="{Binding ClearReadingCommand}" />
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Classes="head" Text="VARIANTS" />
                  <ItemsControl ItemsSource="{Binding FolderVariantRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:VariantRow">
                        <StackPanel Spacing="2">
                          <Grid ColumnDefinitions="*,auto" MinHeight="24">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding $parent[ItemsControl].((vm:ProjectWindowViewModel)DataContext).RemoveVariantCommand}"
                                    CommandParameter="{Binding Variant}">
                              <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconClose}" />
                            </Button>
                          </Grid>
                          <!--
                            Q143. What the variant wears: a symbol riding a rig
                            anchor through every animation of the subject. The
                            numbers are the fine adjustment; the coarse one is
                            moving and aiming the anchor itself, per drawing,
                            in the rig overlay.
                          -->
                          <ItemsControl ItemsSource="{Binding Attachments}" Margin="10,0,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AttachmentRow">
                                <StackPanel Spacing="2" Margin="0,0,0,4">
                                  <Grid ColumnDefinitions="*,auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Summary}" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding $parent[ItemsControl].((vm:VariantRow)DataContext).RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Stop wearing it. The symbol stays in the library.">
                                      <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconClose}" />
                                    </Button>
                                  </Grid>
                                  <!-- Two short rows rather than one long one: this
                                       list nests inside the ~250px details panel,
                                       and a single row of four numerics scrolls
                                       sideways there. Classes="value" takes the
                                       scale's numeric width; the coarse adjustment
                                       is the anchor itself, on the canvas. -->
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="dim" Text="offset" VerticalAlignment="Center" />
                                    <NumericUpDown Classes="value" Increment="1" FormatString="0.#"
                                                   Value="{Binding OffsetX, Mode=TwoWay}" />
                                    <NumericUpDown Classes="value" Increment="1" FormatString="0.#"
                                                   Value="{Binding OffsetY, Mode=TwoWay}" />
                                    <TextBlock Classes="dim" Text="scale" VerticalAlignment="Center" />
                                    <NumericUpDown Classes="value" Increment="0.05" FormatString="0.##"
                                                   Value="{Binding Scale, Mode=TwoWay}" />
                                    <TextBlock Classes="dim" Text="angle" VerticalAlignment="Center" />
                                    <NumericUpDown Classes="value" Increment="5" FormatString="0.#"
                                                   Value="{Binding AngleDeg, Mode=TwoWay}" />
                                  </StackPanel>
                                  <CheckBox Content="Turn with the anchor" FontSize="11"
                                            IsChecked="{Binding FollowAngle, Mode=TwoWay}"
                                            ToolTip.Tip="Follow the anchor's aim (drag its stalk in the rig overlay). Off for things that stay upright however the limb turns." />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <!-- Fixed widths rather than the scale's: the pair
                               has to share the details panel's ~240px with the
                               button, and a symbol name that outgrows its box
                               is readable in the summary line above. -->
                          <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,0,4">
                            <ComboBox Width="130" ItemsSource="{Binding Symbols}"
                                      SelectedItem="{Binding NewSymbol}"
                                      PlaceholderText="Symbol…">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SymbolChoice">
                                  <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Width="110" Text="{Binding NewAnchor}" Watermark="anchor name…"
                                     ToolTip.Tip="The anchor's name as the rig declares it — the same name the export sidecar uses." />
                            <Button Content="Wear" Command="{Binding AddAttachmentCommand}"
                                    ToolTip.Tip="The symbol rides this anchor through every animation of the subject while the variant is viewed." />
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="140" Text="{Binding NewVariantName}" Watermark="Winter Armour…" />
                    <Button Content="Add" Command="{Binding AddVariantCommand}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!--
            Creating from here rather than only from the docker, because the
            window is where a production is structured — and structuring means
            making the folders as well as arranging them. Same rule as the
            docker's ＋ New (B85/B65): it lands where the selection is, the
            name is asked first, and cancelling creates nothing. What is made
            here is saved at once, so the docker and the disk both show it.
          -->
          <Border DockPanel.Dock="Top" Classes="bar">
            <!--
              A WrapPanel, like the bulk bar below: five buttons and a sentence
              do not fit the 720-pixel minimum width, and a StackPanel would
              clip the sentence rather than move it to a second line.
            -->
            <WrapPanel>
              <Button Content="＋ New ▾" Margin="0,0,6,0"
                      ToolTip.Tip="Create something in this project">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="🗀  Folder…" Click="OnNewFolder"
                              ToolTip.Tip="A folder you name, inside the selected one" />
                    <MenuItem Header="▣  Document…" Click="OnNewDocument"
                              ToolTip.Tip="A drawing, in the selected folder" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Content="✎ Rename project…" Margin="0,0,6,0"
                      Command="{Binding RenameProjectCommand}"
                      ToolTip.Tip="Renames the project and its folder on disk">
              </Button>
              <!--
                The two ways out of this window, and they are different
                gestures rather than one with a guess in it: a document is
                artwork, so it opens in Lightbox; a folder is a place, so it
                opens in the file manager. Opening a document closes this
                window — it is modal, and a tab behind it is a tab nobody sees.
              -->
              <Button Content="⏵ Open" Margin="0,0,6,0"
                      Command="{Binding OpenSelectedInLightboxCommand}"
                      ToolTip.Tip="Open the selected documents in Lightbox as tabs. Closes this window." />
              <Button Content="🗀 Show on disk" Margin="0,0,6,0"
                      Command="{Binding RevealSelectedCommand}"
                      ToolTip.Tip="Show the selected row in the file manager — a folder opened, a document selected inside its folder" />
              <Button Content="🗁 Project folder" Margin="0,0,6,0"
                      Command="{Binding RevealProjectFolderCommand}"
                      ToolTip.Tip="Show the project's own folder in the file manager, whatever is selected" />
              <TextBlock Classes="dim" VerticalAlignment="Center"
                         Text="＋ New, ⏵ Open and 🗀 Show on disk act on the selection — right-click a row does the same." />
            </WrapPanel>
          </Border>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,190,110,120,90,120,200" Margin="8,6,8,2">
            <TextBlock Grid.Column="0" Classes="head" Text="NAME" />
            <TextBlock Grid.Column="1" Classes="head" Text="TAGS" />
            <TextBlock Grid.Column="2" Classes="head" Text="STATUS" />
            <TextBlock Grid.Column="3" Classes="head" Text="WHO" />
            <TextBlock Grid.Column="4" Classes="head" Text="LENGTH" />
            <TextBlock Grid.Column="5" Classes="head" Text="VERSIONS" />
            <TextBlock Grid.Column="6" Classes="head" Text="CARRIES" />
          </Grid>

          <ListBox x:Name="StructureRows" ItemsSource="{Binding Rows}"
                   SelectionMode="Multiple"
                   Background="Transparent" BorderThickness="0" Margin="4"
                   DragDrop.AllowDrop="True"
                   DragDrop.DragOver="OnTreeListDragOver"
                   DragDrop.Drop="OnTreeListDrop">
            <!-- Click rather than Command, the docker's rule: a flyout's items
                 live in a popup, where a window binding resolves to nothing. -->
            <ListBox.ContextFlyout>
              <MenuFlyout>
                <!-- Opening first: it is what you came to a row to do, and the
                     two entries are the split the window is built on — artwork
                     opens in Lightbox, a place opens in the file manager. -->
                <MenuItem Header="⏵  Open in Lightbox" Click="OnOpenRowInLightbox"
                          ToolTip.Tip="Open the selected documents as tabs. Closes this window." />
                <MenuItem Header="🗀  Show in file manager" Click="OnRevealRow"
                          ToolTip.Tip="Open the folder on disk, or show the document's file inside its folder" />
                <MenuItem Header="🕘  Version history…" Click="OnRowHistory"
                          ToolTip.Tip="The versions kept of the selected document or sheet — revert puts one back" />
                <Separator />
                <MenuItem Header="🗀  New folder…" Click="OnNewFolder"
                          ToolTip.Tip="A folder you name, inside the selected one" />
                <MenuItem Header="▣  New document…" Click="OnNewDocument"
                          ToolTip.Tip="A drawing, in the selected folder" />
                <Separator />
                <!-- The docker's two operations, in its order and its words —
                     constructive first, destructive last, never one gesture
                     told apart by a held key (B87). -->
                <MenuItem Header="Remove from project" Click="OnRemoveRow"
                          ToolTip.Tip="Take it out of the index. The file stays on disk." />
                <MenuItem Header="Delete permanently…" Click="OnDeleteRow"
                          ToolTip.Tip="Remove it from the project and delete it from disk" />
              </MenuFlyout>
            </ListBox.ContextFlyout>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="4,1" />
                <Setter Property="MinHeight" Value="22" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BoardRow">
                <!-- A drag source and a drop target, with the indicator on the
                     shell. Background set or the empty part of the row is not
                     hit-testable and neither the press nor the drop arrives. -->
                <Border Classes="rowShell"
                        Classes.dropAbove="{Binding DropAbove}"
                        Classes.dropInto="{Binding DropInto}"
                        PointerPressed="OnTreeRowPressed"
                        PointerMoved="OnTreeRowMoved"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnTreeRowDragOver"
                        DragDrop.Drop="OnTreeRowDrop">
                <Grid ColumnDefinitions="*,190,110,120,90,120,200">

                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                    <Border Width="{Binding Indent}" />
                    <TextBlock Text="{Binding Glyph}" />
                    <Panel>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding !IsRenaming}"
                                 Background="Transparent"
                                 DoubleTapped="OnTreeNameDoubleTapped"
                                 ToolTip.Tip="Double-click to rename" />
                      <TextBox Text="{Binding Name, Mode=OneWay}" FontSize="11" MinWidth="140"
                               IsVisible="{Binding IsRenaming}"
                               LostFocus="OnTreeNameLostFocus"
                               KeyDown="OnTreeNameKeyDown" />
                    </Panel>
                    <!-- The kind's own word, automatic (AssetKinds), so an
                         asset is recognisable as what it is before reading
                         the row it happens to sit in. -->
                    <Border Classes="chip" VerticalAlignment="Center"
                            IsVisible="{Binding HasDesignation}">
                      <TextBlock Text="{Binding Designation}" FontSize="10" />
                    </Border>
                  </StackPanel>

                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="chip">
                          <TextBlock Text="{Binding}" FontSize="10" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Grid.Column="2" Classes="chip" HorizontalAlignment="Left"
                          IsVisible="{Binding HasStatus}"
                          Background="{Binding StatusColor}">
                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" />
                  </Border>

                  <TextBlock Grid.Column="3" Classes="dim" Text="{Binding AssigneeName}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="4" Classes="dim" Text="{Binding Length}" />
                  <!-- The history at a glance: how many, the newest milestone
                       in the board's own colour, and ✎ when the file moved on
                       past it. One tooltip carries the sentence; the history
                       itself is the row's right-click. -->
                  <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                              IsVisible="{Binding HasVersions}"
                              ToolTip.Tip="{Binding VersionHint}">
                    <TextBlock Classes="dim" Text="{Binding VersionCountLabel}" />
                    <Border Classes="chip" VerticalAlignment="Center"
                            IsVisible="{Binding HasMilestone}"
                            Background="{Binding MilestoneColor}">
                      <TextBlock Text="{Binding MilestoneLabel}" FontSize="10" />
                    </Border>
                    <TextBlock Classes="dim" Text="✎"
                               IsVisible="{Binding ChangedSinceMilestone}" />
                  </StackPanel>
                  <TextBlock Grid.Column="6" Classes="dim" Text="{Binding Carries}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ============================== STATUS ============================== -->
      <TabItem Header="Status">
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Columns}" Margin="6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatusColumn">
                <!--
                  A column is a drop target and a card is a drag source, so a
                  status change is the gesture the board is shaped for. The
                  command behind it is `MoveToStatus`, which is drivable without
                  a pointer — synthetic input through Xvfb is unreliable here, so
                  a gesture that only exists in a handler is a gesture nothing
                  can check.
                -->
                <Border Width="190" Margin="3" Padding="6"
                        Background="{StaticResource BandTintBrush}" CornerRadius="4"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnStatusDragOver"
                        DragDrop.Drop="OnStatusDrop">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                      <TextBlock DockPanel.Dock="Right" Classes="dim"
                                 Text="{Binding Count}" />
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Width="8" Height="8" CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{Binding Color}" />
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11" />
                      </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BoardRow">
                          <Border Padding="5,3" Margin="0,0,0,3" CornerRadius="3"
                                  Background="{StaticResource HoverTintBrush}"
                                  PointerPressed="OnStatusCardPressed">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="11"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="dim" Text="{Binding AssigneeName}"
                                         IsVisible="{Binding HasAssignee}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== ASSETS ============================== -->
      <TabItem Header="Assets">
        <DockPanel>
          <!--
            The tab a context menu cannot be: a menu declares on one scope at a
            time and shows nothing about the others, so "why is this drawing
            painting from the studio palette" is answerable only by reasoning.
            Project, folders and documents are rows of one table here.
          -->
          <Border DockPanel.Dock="Top" Classes="bar">
            <TextBlock Classes="dim" TextWrapping="Wrap"
                       Text="Every scope in the project, and what it declares. Nearest wins: a document beats its folder, a folder beats the project, the project beats your own defaults. Select a row to give it something; drag an asset from the library onto a row; ✕ on a chip takes it back, ⤒ publishes it project-wide." />
          </Border>
          <!--
            The library: what the project *has*, beside the table of what each
            scope *declares*. Sheets, palettes, gradients, brush tips and
            symbols — the things an artist recognises as things — each wearing
            the designation and glyph AssetKinds gives its kind. Dragging one
            onto a row connects the two: the folder it lands on feeds every
            document below it (a sheet is refiled, everything else declared).
          -->
          <Border DockPanel.Dock="Right" Width="230" Classes="bar"
                  IsVisible="{Binding HasLibrary}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="head" Text="ASSETS" Margin="0,0,0,4" />
              <TextBlock DockPanel.Dock="Top" Classes="dim" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="Everything the project has. Drag one onto a scope — the folder it lands on feeds every document below it." />
              <ListBox ItemsSource="{Binding Library}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="MinHeight" Value="24" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssetEntry">
                    <Border Background="Transparent" PointerPressed="OnAssetPressed">
                      <Border.ContextFlyout>
                        <MenuFlyout>
                          <MenuItem Header="Delete permanently…" Click="OnDeleteAsset"
                                    ToolTip.Tip="Deletes the asset and everywhere it is shared. Sheets and templates are files, so their files go too — it asks first." />
                        </MenuFlyout>
                      </Border.ContextFlyout>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}"
                                   Margin="0,0,5,0" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Designation}" FontSize="10" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Classes="bar" IsVisible="{Binding HasAssetScope}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="head" VerticalAlignment="Center"
                         Text="{Binding AssetScopeLabel}" />
              <ComboBox MinWidth="260" ItemsSource="{Binding OfferChoices}"
                        SelectedItem="{Binding OfferToDeclare}"
                        PlaceholderText="share something here…">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OfferChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedScope}"
                   Background="Transparent" BorderThickness="0" Margin="6"
                   DragDrop.AllowDrop="True"
                   DragDrop.DragOver="OnTreeListDragOver"
                   DragDrop.Drop="OnTreeListDrop">
            <!-- The tab's right-click makes assets, where Structure's makes
                 structure. Click rather than Command — a flyout's items live
                 in a popup, where a window binding resolves to nothing. -->
            <ListBox.ContextFlyout>
              <MenuFlyout>
                <!-- The same pair the Structure tab's menu opens with. These
                     rows are the same folders and documents, so leaving the
                     gesture out here would make one tab able to do a thing the
                     other cannot for no reason an artist could work out. -->
                <MenuItem Header="⏵  Open in Lightbox" Click="OnOpenScopeInLightbox"
                          ToolTip.Tip="Open the selected document as a tab. Closes this window." />
                <MenuItem Header="🗀  Show in file manager" Click="OnRevealScope"
                          ToolTip.Tip="Open the folder on disk — the project row shows the project's own folder" />
                <MenuItem Header="🕘  Version history…" Click="OnScopeHistory"
                          ToolTip.Tip="The versions kept of the selected document — revert puts one back" />
                <Separator />
                <MenuItem Header="▤  New reference sheet…" Click="OnNewSheet"
                          ToolTip.Tip="A blank sheet, filed on the selected folder — every drawing under it can consult it" />
                <MenuItem Header="🎨  New palette…" Click="OnNewPalette"
                          ToolTip.Tip="A new project palette. Made on a folder row, it is shared there at once." />
                <MenuItem Header="◧  New gradient…" Click="OnNewGradient"
                          ToolTip.Tip="A new project gradient. Made on a folder row, it is shared there at once." />
                <MenuItem Header="📄  New template…" Click="OnNewTemplate"
                          ToolTip.Tip="A blank document already marked as a template, filed where the selection is" />
                <Separator />
                <MenuItem Header="Remove from project" Click="OnRemoveScope"
                          ToolTip.Tip="Take the selected row out of the index. The file stays on disk." />
                <MenuItem Header="Delete permanently…" Click="OnDeleteScope"
                          ToolTip.Tip="Remove it from the project and delete it from disk" />
              </MenuFlyout>
            </ListBox.ContextFlyout>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="MinHeight" Value="24" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AssetScope">
                <!-- A drag source and a drop target: the library's assets land
                     here, and the hierarchy itself rearranges by the same
                     gesture the Structure tab has. Background must be set or
                     the empty part of the row is not hit-testable and neither
                     the press nor the drop arrives. -->
                <Border Classes="rowShell"
                        Classes.dropAbove="{Binding DropAbove}"
                        Classes.dropInto="{Binding DropInto}"
                        PointerPressed="OnScopeRowPressed"
                        PointerMoved="OnScopeRowMoved"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnScopeDragOver"
                        DragDrop.Drop="OnScopeDrop">
                <Grid ColumnDefinitions="260,*" MinHeight="22"
                      Background="Transparent">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Border Width="{Binding Indent}" />
                    <TextBlock Text="{Binding Name}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding All}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:Declaration">
                        <Border Classes="chip">
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock FontSize="10">
                              <Run Text="{Binding Glyph}" />
                              <Run Text="{Binding Designation}" FontWeight="SemiBold" />
                              <Run Text="{Binding Name}" />
                            </TextBlock>
                            <!-- The docker's Reach menu, as one click on the
                                 chip it is about. Hidden on a document
                                 declaration, which has nothing below it. -->
                            <Button Padding="2,0"
                                    Background="Transparent" BorderThickness="0"
                                    IsVisible="{Binding CanReach}"
                                    Command="{Binding $parent[ListBox].((vm:ProjectWindowViewModel)DataContext).ToggleReachCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding ReachHint}">
                              <!-- The arrow carries the state: up to the bar
                                   publishes, down from it takes back. -->
                              <Panel>
                                <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconArrowUpToBar}"
                                      IsVisible="{Binding !IsPublished}" />
                                <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconArrowDownToBar}"
                                      IsVisible="{Binding IsPublished}" />
                              </Panel>
                            </Button>
                            <Button Padding="2,0"
                                    Background="Transparent" BorderThickness="0"
                                    IsVisible="{Binding CanRemove}"
                                    Command="{Binding $parent[ListBox].((vm:ProjectWindowViewModel)DataContext).UndeclareOnScopeCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Stop sharing this here">
                              <Path Classes="icon" Width="9" Height="9" Data="{StaticResource IconClose}" />
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ============================== EXPORT ============================== -->
      <TabItem Header="Export">
        <DockPanel>
          <!--
            `ExportPlan` already produced this and only a confirmation dialog
            read it. A plan you can see only in the half-second before it runs is
            a plan nobody checks — and the count is the thing worth checking, as
            the way you learn most of a scope is held back by status before
            wondering why the sheet came out half empty.

            And it runs from here now (owner's ask): the plan is read where the
            grouped artifacts live, through the docker's own resolution and the
            one runner, so the two surfaces cannot disagree about what export
            means.
          -->
          <Border DockPanel.Dock="Top" Classes="bar">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="▶ Run export…" Click="OnRunExport"
                      ToolTip.Tip="Export every artifact below into a folder you pick — grouped scopes become one sheet with a tagged clip per document" />
              <TextBlock Classes="dim" Text="{Binding ExportSummary}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ExportRows}" Margin="6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectWindowViewModel+ExportRow">
                  <Border Padding="6" Margin="0,0,0,4" CornerRadius="3"
                          Background="{StaticResource BandTintBrush}">
                    <StackPanel Spacing="2">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="dim" Text="{Binding Preset}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Scope}" FontWeight="SemiBold" FontSize="11" />
                          <TextBlock Classes="dim" Text="{Binding Count}" />
                          <TextBlock Classes="dim" Foreground="{StaticResource StatusWarningBrush}"
                                     Text="empty" IsVisible="{Binding IsEmpty}" />
                        </StackPanel>
                      </DockPanel>
                      <TextBlock Classes="dim" Text="{Binding Contents}" TextWrapping="Wrap" />
                      <TextBlock Classes="dim" Foreground="{StaticResource StatusWarningBrush}"
                                 Text="{Binding Excluded}" IsVisible="{Binding HasExcluded}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ============================== PEOPLE ============================== -->
      <TabItem Header="People">
        <DockPanel>
          <!--
            Q45: a name and an id. No role, no rights, ever — the manifest is
            plain JSON on disk, so a permission here is one a text editor
            defeats, and a permission that cannot be enforced is a UI that lies
            about what it enforces.
          -->
          <Border DockPanel.Dock="Top" Classes="bar">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Width="200" Text="{Binding NewPersonName}" Watermark="name…" />
              <Button Content="Add" Command="{Binding AddPersonCommand}" />
              <TextBlock Classes="dim" VerticalAlignment="Center"
                         Text="Names only. Lightbox has no accounts, and a role here would grant nothing." />
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding People}" Background="Transparent"
                   BorderThickness="0" Margin="6">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PersonChoice">
                <Grid ColumnDefinitions="*,auto,auto" MinHeight="26">
                  <TextBox Grid.Column="0" Text="{Binding Name}" BorderThickness="0"
                           Background="Transparent" />
                  <TextBlock Grid.Column="1" Classes="dim" VerticalAlignment="Center"
                             Margin="0,0,8,0" Text="{Binding Cost}" />
                  <Button Grid.Column="2" Content="Remove"
                          Command="{Binding $parent[ListBox].((vm:ProjectWindowViewModel)DataContext).RemovePersonCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
