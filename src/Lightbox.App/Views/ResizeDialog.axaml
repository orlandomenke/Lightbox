<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lightbox.App.ViewModels"
        xmlns:controls="using:Lightbox.App.Controls"
        x:Class="Lightbox.App.Views.ResizeDialog"
        x:DataType="vm:ResizeDialogViewModel"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Resize">

  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space12}">

    <!-- Pixel size. Both modes have it; only the labels around it differ. -->
    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Width" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="0" Grid.Column="1"
                     Value="{Binding Width}" Minimum="1" Maximum="30000" Increment="1"
                     FormatString="0" />
      <TextBlock Grid.Row="0" Grid.Column="2" Text="Height" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="0" Grid.Column="3"
                     Value="{Binding Height}" Minimum="1" Maximum="30000" Increment="1"
                     FormatString="0" />
      <Button Grid.Row="0" Grid.Column="4" Classes="icon" Click="OnSwap"
              VerticalAlignment="Center" ToolTip.Tip="Swap width and height">
        <Path Classes="icon" Data="{StaticResource IconSwapHorizontal}" />
      </Button>

      <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                IsChecked="{Binding Linked}" Content="Keep proportions" />

      <!--
        PPI sits beside the pixel size rather than under it, because it is a
        second reading of the same thing rather than a second resize: it says
        how big these pixels print. Image mode only — paper does not change
        how big a pixel is.
      -->
      <TextBlock Grid.Row="1" Grid.Column="2" Text="PPI"
                 VerticalAlignment="Center" IsVisible="{Binding IsImage}" />
      <NumericUpDown Grid.Row="1" Grid.Column="3"
                     Value="{Binding Ppi}" Minimum="1" Maximum="2400" Increment="1"
                     FormatString="0" IsVisible="{Binding IsImage}" />
    </Grid>

    <!--
      The anchor grid: nine buttons, because the answer is a direction and a
      direction is faster to point at than to read out of a list. Canvas mode
      only — rescaling artwork has no corner to hold still.

      Beside it, the outline preview: the current paper dashed, the new paper
      solid, the part a crop cuts away dimmed. It is the same height as the
      grid so the two read as one control — point at a direction, see the
      paper go that way.
    -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
          ColumnSpacing="{StaticResource Space12}" RowSpacing="{StaticResource Space6}"
          IsVisible="{Binding IsCanvas}">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Anchor" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="Preview" />
      <UniformGrid Grid.Row="1" Grid.Column="0" x:Name="AnchorGrid" Rows="3" Columns="3"
                   Width="{StaticResource SizeResizeAnchor}" Height="{StaticResource SizeResizeAnchor}"
                   HorizontalAlignment="Left" />
      <controls:ResizeOutlinePreview Grid.Row="1" Grid.Column="1" x:Name="OutlinePreview"
                                     Height="{StaticResource SizeResizeAnchor}" Outline="{Binding Outline}" />
    </Grid>

    <!--
      The preview, as a sentence. It names the one consequence an artist cannot
      see coming and cannot undo by eye: whether the marks are about to change.
    -->
    <Border Background="{DynamicResource SurfaceElevated}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
    </Border>

    <UniformGrid x:Name="ButtonRow" Rows="1" ColumnSpacing="8" HorizontalAlignment="Right">
      <Button Classes="tertiary" Content="Reset" Click="OnReset"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
      <Button Classes="tertiary" Content="Cancel" Click="OnCancel" IsCancel="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
      <Button Classes="primary" Content="Resize" Click="OnApply" IsDefault="True" IsEnabled="{Binding CanApply}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
    </UniformGrid>
  </StackPanel>
</Window>
