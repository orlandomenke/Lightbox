<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lightbox.App.ViewModels"
        x:Class="Lightbox.App.Views.LibraryWindow"
        x:DataType="vm:LibraryViewModel"
        Title="Character library"
        Icon="/Assets/lightbox.ico"
        Width="560" Height="460"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="12">

    <!-- Where libraries live. At the bottom, set once and left — the shelf is
         what the window is for. -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
      <TextBlock Text="Library folders" FontWeight="SemiBold" FontSize="12" />
      <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                 Text="A library is an ordinary project whose type is Asset library. Point this at one, or at a folder holding several." />
      <ListBox x:Name="RootList" ItemsSource="{Binding Roots}" MaxHeight="80" FontSize="11" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="text" Content="Add folder…" Click="OnAddRoot" />
        <Button Classes="text" Content="Remove" Click="OnRemoveRoot" />
        <Button Classes="text" Content="Rescan" Click="OnRescan" />
      </StackPanel>
    </StackPanel>

    <!-- Import bar. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button DockPanel.Dock="Right" Content="Import" Click="OnImport" IsDefault="True" Classes="primary"
              ToolTip.Tip="Copy the character into the open project — animations, palette and variants. Importing again later updates the copies you have not edited and never touches your own work." />
      <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="11" Opacity="0.7"
                 TextWrapping="Wrap" />
    </DockPanel>

    <!-- The shelf. -->
    <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" DoubleTapped="OnImport">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryEntryRow">
          <StackPanel Margin="2">
            <TextBlock Text="{Binding Name}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding LibraryName}" FontSize="11" Opacity="0.6" />
              <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.6" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
