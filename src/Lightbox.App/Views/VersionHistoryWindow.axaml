<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lightbox.App.ViewModels"
        x:Class="Lightbox.App.Views.VersionHistoryWindow"
        x:DataType="vm:VersionHistoryViewModel"
        Title="{Binding Title}"
        Icon="/Assets/lightbox.ico"
        Width="480" Height="420" MinWidth="380" MinHeight="260"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">

    <!-- The status line carries the one reassurance that makes revert usable:
         nothing is ever lost, the replaced state becomes a version itself. -->
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
               TextWrapping="Wrap" FontSize="11" Opacity="0.7"
               Text="{Binding Status}" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Close" Click="OnClose" IsCancel="True" />
      <Button Classes="primary" Content="Revert to selected"
              Command="{Binding RevertCommand}"
              CommandParameter="{Binding Selected}"
              IsEnabled="{Binding Selected.CanRevert, FallbackValue=False}" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold"
               Text="Versions, newest first" />
    <TextBlock DockPanel.Dock="Top" Margin="0,2,0,8"
               TextWrapping="Wrap" FontSize="11" Opacity="0.7"
               Text="Greyed lines record an action — a revert — and hold no file to go back to." />

    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:VersionRow">
          <StackPanel Spacing="2" Opacity="{Binding Opacity}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.6"
                         Text="{Binding When}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Number}" />
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <Border IsVisible="{Binding HasMilestone}"
                        Background="{Binding MilestoneColor}" CornerRadius="3" Padding="4,0">
                  <TextBlock FontSize="10" Foreground="White" Text="{Binding Milestone}" />
                </Border>
                <TextBlock IsVisible="{Binding IsActive}" FontSize="10" Opacity="0.6"
                           VerticalAlignment="Center" Text="● active" />
              </StackPanel>
            </DockPanel>
            <TextBlock IsVisible="{Binding HasNotes}" FontSize="11" Opacity="0.7"
                       TextWrapping="Wrap" Text="{Binding Notes}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
