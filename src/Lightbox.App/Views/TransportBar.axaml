<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lightbox.App.ViewModels"
             x:Class="Lightbox.App.Views.TransportBar"
             x:DataType="vm:MainViewModel">
  <!--
    The transport, once. The track timeline and the X-sheet both carry it —
    they are two views over one playback — and two hand-copied rows of seven
    buttons is exactly the "second place to look" this codebase argues
    against. DataContext flows in from the window, so the bindings are the
    ones the timeline bar always had.
  -->
  <StackPanel Orientation="Horizontal" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="2">
      <Button Command="{Binding GoToStartFrameCommand}"
              ToolTip.Tip="To start frame (the set start frame, else the first)">
        <Path Classes="icon" Data="{StaticResource IconSkipToStart}" />
      </Button>
      <Button Command="{Binding PreviousKeyframeCommand}" ToolTip.Tip="Previous keyframe">
        <Path Classes="icon" Data="{StaticResource IconFastRewind}" />
      </Button>
      <Button Command="{Binding PlayBackwardsCommand}" ToolTip.Tip="Play backwards">
        <Path Classes="icon" Data="{StaticResource IconPlayReverse}" />
      </Button>
      <Button Command="{Binding PauseCommand}" ToolTip.Tip="Pause">
        <Path Classes="icon" Data="{StaticResource IconPause}" />
      </Button>
      <Button Command="{Binding PlayCommand}" ToolTip.Tip="Play (Space toggles)">
        <Path Classes="icon" Data="{StaticResource IconPlay}" />
      </Button>
      <Button Command="{Binding NextKeyframeCommand}" ToolTip.Tip="Next keyframe">
        <Path Classes="icon" Data="{StaticResource IconFastForward}" />
      </Button>
      <Button Command="{Binding GoToEndFrameCommand}"
              ToolTip.Tip="To end frame (the set end frame, else the last)">
        <Path Classes="icon" Data="{StaticResource IconSkipToEnd}" />
      </Button>
    </StackPanel>
    <ToggleButton IsChecked="{Binding LoopPlayback}" Padding="6,2"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Loop playback. Off plays once and stops on the last frame.">
      <Path Classes="icon" Data="{StaticResource IconLoop}" />
    </ToggleButton>
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
      <TextBlock Text="fps" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding Fps}" Minimum="1" Maximum="60" Increment="1"
                     FormatString="0" Width="48" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
      <TextBlock Text="Speed %" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding PlaybackSpeedPercent}" Minimum="10" Maximum="400" Increment="10"
                     FormatString="0" Width="50" VerticalAlignment="Center"
                     ToolTip.Tip="Playback speed as a percentage of real time" />
    </StackPanel>
  </StackPanel>
</UserControl>
