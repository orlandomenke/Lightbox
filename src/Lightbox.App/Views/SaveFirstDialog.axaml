<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lightbox.App.Views.SaveFirstDialog"
        Title="Save this drawing first"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <!--
    Two buttons and no third, on purpose. There is no "do it anyway": an export of a
    drawing that was never written down, or a Ready flag on one, is a claim to somebody
    else about a file that does not exist. Offering it would be offering a mistake.

    The refusal is named after what it undoes rather than "Cancel", because by the time
    this appears the artist has already clicked a status and the honest question is
    whether that click stands.
  -->
  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space12}">
    <TextBlock x:Name="Message" TextWrapping="Wrap" />
    <UniformGrid x:Name="ButtonRow" Rows="1" ColumnSpacing="8" HorizontalAlignment="Right">
      <Button Classes="tertiary" x:Name="RevertButton" IsCancel="True" Click="OnRevertClicked"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
      <Button Classes="primary" x:Name="SaveButton" Content="Save file as…" IsDefault="True" Click="OnSaveAsClicked"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
    </UniformGrid>
  </StackPanel>
</Window>
