<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lightbox.App.ViewModels"
        xmlns:render="using:Lightbox.App.Rendering"
        xmlns:controls="using:Lightbox.App.Controls"
        x:Class="Lightbox.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Lightbox"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.layerRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Border.layerRow.active">
      <Setter Property="Background" Value="#33507a" />
    </Style>
    <Style Selector="Button.cel">
      <Setter Property="Background" Value="#2a2a2a" />
    </Style>
    <Style Selector="Button.cel.current">
      <Setter Property="Background" Value="#4a6ea9" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open…" Click="OnOpenClicked" />
        <MenuItem Header="_Save…" Click="OnSaveClicked" />
        <Separator />
        <MenuItem Header="_Export PNGs…" Click="OnExportClicked" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Sidebar" ToggleType="CheckBox" IsChecked="{Binding SidebarVisible}" />
        <MenuItem Header="Timeline" ToggleType="CheckBox" IsChecked="{Binding TimelineVisible}" />
      </MenuItem>
    </Menu>

    <!-- Dynamic tool options bar: contents depend on the selected tool -->
    <Border DockPanel.Dock="Top" Padding="8,6" Background="#1f1f1f">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Content="Brush" IsChecked="{Binding !IsEraser}" IsEnabled="{Binding IsEraser}" />
          <ToggleButton Content="Eraser" IsChecked="{Binding IsEraser}" />
        </StackPanel>

        <!-- Brush options -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding !IsEraser}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Color" VerticalAlignment="Center" />
            <TextBox Text="{Binding ColorHex}" Width="80" ToolTip.Tip="Hex color, e.g. #1a1a1a" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Size" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushSize}" Minimum="1" Maximum="60" Width="110" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushSize}" Minimum="1" Maximum="60" Increment="1"
                           FormatString="0.#" Width="100" VerticalAlignment="Center"
                           ToolTip.Tip="Brush size (type an exact value)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Hardness" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushHardness}" Minimum="0" Maximum="1" Width="90" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushHardness}" Minimum="0" Maximum="1" Increment="0.05"
                           FormatString="0.00" Width="110" VerticalAlignment="Center"
                           ToolTip.Tip="Brush hardness (type an exact value, 0–1)" />
          </StackPanel>
          <CheckBox Content="Smooth" IsChecked="{Binding SmoothStrokes}" VerticalAlignment="Center"
                    ToolTip.Tip="Smooth strokes when you finish them" />
        </StackPanel>

        <!-- Eraser options -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsEraser}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Size" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushSize}" Minimum="1" Maximum="60" Width="110" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushSize}" Minimum="1" Maximum="60" Increment="1"
                           FormatString="0.#" Width="100" VerticalAlignment="Center"
                           ToolTip.Tip="Eraser size (type an exact value)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Hardness" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushHardness}" Minimum="0" Maximum="1" Width="90" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushHardness}" Minimum="0" Maximum="1" Increment="0.05"
                           FormatString="0.00" Width="110" VerticalAlignment="Center"
                           ToolTip.Tip="Eraser hardness (type an exact value, 0–1)" />
          </StackPanel>
          <CheckBox Content="Smooth" IsChecked="{Binding SmoothStrokes}" VerticalAlignment="Center"
                    ToolTip.Tip="Smooth strokes when you finish them" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- AI bar -->
    <Border DockPanel.Dock="Top" Padding="8,4" Background="#232323"
            ToolTip.Tip="{Binding AiUnavailableHint}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="✦ AI Inbetween"
                Command="{Binding AiInbetweenCommand}"
                IsEnabled="{Binding CanUseAi}"
                ToolTip.Tip="Ask Claude to draw the inbetweens between this key and the next" />
        <TextBox Text="{Binding AiPrompt}" Width="320" PlaceholderText="Describe what Claude should draw…"
                 IsEnabled="{Binding CanUseAi}" />
        <Button Content="✦ AI Draw"
                Command="{Binding AiDrawCommand}"
                IsEnabled="{Binding CanUseAi}"
                ToolTip.Tip="Claude paints strokes onto the current frame" />
        <Button Content="✕" Command="{Binding CancelAiCommand}" IsVisible="{Binding AiBusy}"
                ToolTip.Tip="Cancel the AI request" />
        <ProgressBar IsIndeterminate="True" Width="90" IsVisible="{Binding AiBusy}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding AiStatus}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- Timeline docker (its ✕ collapses it downward; reopen via View menu) -->
    <controls:Docker DockPanel.Dock="Bottom" Title="Timeline" Margin="4"
                     IsVisible="{Binding TimelineVisible}"
                     CloseCommand="{Binding ToggleTimelineCommand}">
      <controls:Docker.TopBar>
        <Border Classes="dockerBar">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="＋" Command="{Binding AddFrameCommand}" ToolTip.Tip="Add empty frame after current" />
            <Button Content="⧉" Command="{Binding DuplicateFrameCommand}" ToolTip.Tip="Duplicate current frame" />
            <Button Content="🗑" Command="{Binding DeleteFrameCommand}" ToolTip.Tip="Delete current frame" />
            <Button Content="↶" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)" />
            <Button Content="↷" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)" />
            <TextBlock Text="{Binding FrameLabel}" VerticalAlignment="Center" Margin="8,0" />
            <CheckBox Content="Onion skin" IsChecked="{Binding OnionSkin}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding OnionDepth}" Minimum="1" Maximum="3" Increment="1"
                           FormatString="0" Width="100" VerticalAlignment="Center"
                           ToolTip.Tip="Onion skin depth (frames each side)" />
            <NumericUpDown Value="{Binding TweenCount}" Minimum="1" Maximum="9" Increment="1"
                           FormatString="0" Width="110" VerticalAlignment="Center"
                           ToolTip.Tip="Number of inbetween frames to generate" />
            <ComboBox ItemsSource="{Binding EasingChoices}" SelectedItem="{Binding TweenEasing}" Width="110" />
            <Button Content="＋ Inbetween" Command="{Binding InsertInbetweensCommand}"
                    ToolTip.Tip="Insert interpolated frames between this key and the next" />
          </StackPanel>
        </Border>
      </controls:Docker.TopBar>

      <controls:Docker.BottomBar>
        <Border Classes="dockerBar">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="▶ / ⏸" Command="{Binding TogglePlaybackCommand}" ToolTip.Tip="Play / pause (Space)" />
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="fps" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding Fps}" Minimum="1" Maximum="60" Increment="1"
                             FormatString="0" Width="100" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Speed %" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding PlaybackSpeedPercent}" Minimum="10" Maximum="400" Increment="10"
                             FormatString="0" Width="110" VerticalAlignment="Center"
                             ToolTip.Tip="Playback speed as a percentage of real time" />
            </StackPanel>
          </StackPanel>
        </Border>
      </controls:Docker.BottomBar>

      <!-- One row per layer: onion toggle, name, then the layer's cels -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
        <ItemsControl ItemsSource="{Binding LayerRows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LayerRow">
              <Border Classes="layerRow" Classes.active="{Binding IsActive}" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <ToggleButton Content="◉" IsChecked="{Binding OnionEnabled}" Width="32"
                                ToolTip.Tip="Onion skinning for this layer" />
                  <Button Content="{Binding Name}" Width="110" Height="50"
                          HorizontalContentAlignment="Left"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActivateLayerCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Select this layer" />
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FrameCell">
                        <Button Width="40" Height="50" Classes="cel"
                                Classes.current="{Binding IsCurrent}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectFrameCommand}"
                                CommandParameter="{Binding}"
                                Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                          <StackPanel>
                            <Image Source="{Binding Thumb}" Width="32" Height="18" Stretch="Uniform"
                                   IsVisible="{Binding IsKeyed}" />
                            <TextBlock Text="{Binding Display}" HorizontalAlignment="Center" FontSize="11" />
                            <TextBlock Text="—" HorizontalAlignment="Center" FontSize="10" IsVisible="{Binding !IsKeyed}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </controls:Docker>

    <!-- Closable sidebar of dockers (dock side is switched from code-behind) -->
    <Border x:Name="Sidebar" DockPanel.Dock="Right" Width="250" Background="#1c1c1c"
            IsVisible="{Binding SidebarVisible}">
      <StackPanel Spacing="4" Margin="4">
        <!-- Layer docker (its ✕ collapses the sidebar to its side; ⇄ switches sides) -->
        <controls:Docker Title="Layers"
                         CloseCommand="{Binding ToggleSidebarCommand}">
          <controls:Docker.TitleBarExtra>
            <Button Content="⇄" FontSize="11" Padding="6,2"
                    Command="{Binding SwitchSidebarSideCommand}"
                    ToolTip.Tip="Move the sidebar to the other side" />
          </controls:Docker.TitleBarExtra>
            <controls:Docker.TopBar>
              <Border Classes="dockerBar">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="＋" Command="{Binding AddLayerOfSelectedKindCommand}"
                          ToolTip.Tip="Add a new layer of the selected kind" />
                  <ComboBox ItemsSource="{Binding NewLayerKindChoices}" SelectedItem="{Binding NewLayerKind}"
                            Width="110" ToolTip.Tip="Kind of layer the + button creates" />
                </StackPanel>
              </Border>
            </controls:Docker.TopBar>

            <!-- Topmost layer first: visibility, then the renamable name -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
              <ItemsControl ItemsSource="{Binding LayerRows}" Margin="4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LayerRow">
                    <Border Classes="layerRow" Classes.active="{Binding IsActive}" Padding="2"
                            PointerPressed="OnLayerRowPressed">
                      <DockPanel>
                        <ToggleButton DockPanel.Dock="Left" Content="👁" IsChecked="{Binding Visible}"
                                      Width="34" ToolTip.Tip="Layer visibility" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" Width="16"
                                   VerticalAlignment="Center" Opacity="0.5" FontSize="11"
                                   ToolTip.Tip="R = raster, V = vector" />
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Margin="4,0" BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center"
                                 GotFocus="OnLayerRowFocused"
                                 ToolTip.Tip="Click to rename" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
        </controls:Docker>

        <!-- Color docker: one color, several representations -->
        <controls:Docker Title="Color">
          <controls:Docker.TopBar>
            <Border Classes="dockerBar">
              <ComboBox ItemsSource="{Binding ColorPicker.ModeChoices}" SelectedItem="{Binding ColorPicker.Mode}"
                        Width="120" ToolTip.Tip="Color picker representation" />
            </Border>
          </controls:Docker.TopBar>
          <controls:Docker.BottomBar>
            <Border Classes="dockerBar">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="3"
                        BorderBrush="#555" BorderThickness="1"
                        Background="{Binding ColorPicker.SwatchBrush}"
                        ToolTip.Tip="Current color" />
                <TextBox Text="{Binding ColorHex}" Margin="8,0,0,0" VerticalAlignment="Center"
                         ToolTip.Tip="Hex color, e.g. #1a1a1a" />
              </DockPanel>
            </Border>
          </controls:Docker.BottomBar>

          <StackPanel Margin="8" Spacing="8">

            <!-- Krita-style wheel: hue ring + value slider -->
            <StackPanel Spacing="8" IsVisible="{Binding ColorPicker.IsWheelMode}">
              <ColorSpectrum Shape="Ring" Components="HueSaturation" Height="190"
                             HsvColor="{Binding ColorPicker.WheelHsv, Mode=TwoWay}" />
              <ColorSlider ColorModel="Hsva" ColorComponent="Component3"
                           HsvColor="{Binding ColorPicker.WheelHsv, Mode=TwoWay}"
                           ToolTip.Tip="Value (brightness)" />
            </StackPanel>

            <!-- HSV sliders -->
            <StackPanel Spacing="4" IsVisible="{Binding ColorPicker.IsHsvMode}">
              <DockPanel>
                <TextBlock Text="H" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Hue}" Minimum="0" Maximum="360"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Hue}" Minimum="0" Maximum="360" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="S" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.HsvSaturation}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.HsvSaturation}" Minimum="0" Maximum="100" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="V" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.HsvValue}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.HsvValue}" Minimum="0" Maximum="100" Margin="4,0" />
              </DockPanel>
            </StackPanel>

            <!-- HSL sliders -->
            <StackPanel Spacing="4" IsVisible="{Binding ColorPicker.IsHslMode}">
              <DockPanel>
                <TextBlock Text="H" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Hue}" Minimum="0" Maximum="360"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Hue}" Minimum="0" Maximum="360" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="S" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.HslSaturation}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.HslSaturation}" Minimum="0" Maximum="100" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="L" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.HslLightness}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.HslLightness}" Minimum="0" Maximum="100" Margin="4,0" />
              </DockPanel>
            </StackPanel>

            <!-- RGB sliders -->
            <StackPanel Spacing="4" IsVisible="{Binding ColorPicker.IsRgbMode}">
              <DockPanel>
                <TextBlock Text="R" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Red}" Minimum="0" Maximum="255"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Red}" Minimum="0" Maximum="255" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="G" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Green}" Minimum="0" Maximum="255"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Green}" Minimum="0" Maximum="255" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="B" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Blue}" Minimum="0" Maximum="255"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Blue}" Minimum="0" Maximum="255" Margin="4,0" />
              </DockPanel>
            </StackPanel>

            <!-- CMYK sliders -->
            <StackPanel Spacing="4" IsVisible="{Binding ColorPicker.IsCmykMode}">
              <DockPanel>
                <TextBlock Text="C" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Cyan}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Cyan}" Minimum="0" Maximum="100" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="M" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Magenta}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Magenta}" Minimum="0" Maximum="100" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="Y" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Yellow}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Yellow}" Minimum="0" Maximum="100" Margin="4,0" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="K" Width="16" VerticalAlignment="Center" />
                <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Black}" Minimum="0" Maximum="100"
                               Increment="1" FormatString="0" Width="94" />
                <Slider Value="{Binding ColorPicker.Black}" Minimum="0" Maximum="100" Margin="4,0" />
              </DockPanel>
            </StackPanel>

          </StackPanel>
        </controls:Docker>
      </StackPanel>
    </Border>

    <!-- Canvas -->
    <render:CanvasControl x:Name="Canvas" BrushCursorSize="{Binding BrushSize}" />

  </DockPanel>
</Window>
