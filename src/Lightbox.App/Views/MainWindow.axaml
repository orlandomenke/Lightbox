<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lightbox.App.ViewModels"
        xmlns:services="using:Lightbox.App.Services"
        xmlns:geo="using:Lightbox.Core.Geometry"
        xmlns:render="using:Lightbox.App.Rendering"
        xmlns:controls="using:Lightbox.App.Controls"
        xmlns:docs="using:Lightbox.Core.Documents"
        xmlns:docking="using:Lightbox.App.Docking"
        xmlns:views="using:Lightbox.App.Views"
        x:Class="Lightbox.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Lightbox"
        Icon="/Assets/lightbox.ico"
        Width="1280" Height="800"
        Background="{StaticResource BackgroundPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Project tree: a character reads as a heading, its animations indent under it. -->
    <Style Selector="DockPanel.characterRow > TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DockPanel.animationRow">
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <!--
      A row is as tall as its icon tile and no taller.

      `Padding="2,0"` rather than `2`: the horizontal 2 keeps the first icon off
      the edge, the vertical 0 is the density. The tile is already 26 with the
      glyph centred in it, so vertical padding was buying nothing but height —
      4 px a row, which is a whole extra row every eight layers.

      Declared here rather than on each template, which is also why the three
      inline copies are gone. They were identical by luck: the layers docker,
      the group row and the timeline's layer column each wrote their own, so a
      change to one silently split the lists that are meant to line up.
    -->
    <Style Selector="Border.layerRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="2,0" />
    </Style>
    <Style Selector="Border.layerRow.active">
      <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
    </Style>
    <Style Selector="Border.layerRow.hiddenLayer">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <!-- Cyan, not the warning amber: locked is a STATE the artist chose, not
         a problem the app is reporting, and amber made every locked layer read
         as something going wrong. -->
    <Style Selector="Border.layerRow.lockedLayer">
      <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.groupRow.lockedLayer">
      <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.groupRow">
      <Setter Property="Background" Value="{StaticResource GroupRowBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="2,0" />
    </Style>
    <Style Selector="Border.groupRow.hiddenLayer">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.layerRow.grouped">
      <Setter Property="Margin" Value="14,0,0,0" />
    </Style>
    <Style Selector="Button.cel">
      <Setter Property="Background" Value="{StaticResource CelBrush}" />
    </Style>
    <!-- Frame-role colors: key (default), breakdown, inbetween -->
    <Style Selector="Button.cel.breakdown">
      <Setter Property="Background" Value="{StaticResource CelBreakdownBrush}" />
    </Style>
    <Style Selector="Button.cel.tween">
      <Setter Property="Background" Value="{StaticResource CelTweenBrush}" />
    </Style>
    <Style Selector="Button.cel.virtualCell">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.cel.dim">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.cel.current">
      <Setter Property="Background" Value="{StaticResource CelCurrentBrush}" />
    </Style>
    <Style Selector="Button.cel.sel">
      <Setter Property="Background" Value="{StaticResource CelSelectedBrush}" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{StaticResource BackgroundPrimaryBrush}" />
    </Style>
    <!-- Headroom meter: amber once the document is costing the machine real time -->
    <Style Selector="ProgressBar.strained /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="#e0a030" />
    </Style>
    <!--
      One tab treatment everywhere: the document tabs wear exactly what the
      docker tabs wear — outlined at rest, the lit fading ground and the
      purple gradient top line when active. Two tab languages in one window
      was the app telling the artist these strips are different kinds of
      thing, when both answer "which of these is in front".
    -->
    <Style Selector="Border.docTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4,4,0,0" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.docTab.active">
      <Setter Property="Background" Value="{StaticResource TabActiveGroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <!-- ToggleButton.tool is sized by Density.axaml. Only the alignment
         changes here: the toolbar's "labels" class (set from code-behind at a
         width threshold) reveals the names beside the icons, and a name reads
         left rather than centred. -->
    <Style Selector="Border#Toolbar.labels ToggleButton.tool">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <!-- The tool options bar is a fixed 30px row of controls that each default
         to VerticalAlignment=Stretch. A stretched Slider puts its track at the
         top of whatever height it is given, so it sat above the label beside
         it; a stretched CheckBox does the same with its box. Centring them
         here rather than on ~40 individual controls is the only version of
         this that stays fixed when a control is added. -->
    <Style Selector="controls|OverflowBar > Slider">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|OverflowBar CheckBox">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|OverflowBar Slider">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|OverflowBar TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Icon buttons are sized by Density.axaml, which now carries the square
         and the reason for it. This block declared 26 against the scale's 24
         and won, so the scale described a size no control in this window had. -->
    <Style Selector="TextBlock.toolname">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#Toolbar.labels TextBlock.toolname">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </Window.Styles>

  <!-- Padded by the window's own off-screen margin so a maximised window
       does not clip its first pixel rows under the screen edge. -->
  <DockPanel Margin="{Binding OffScreenMargin, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">

    <!--
      The chrome is ours: the title bar carries the brand mark, the menu, a
      drag region and the caption buttons, and saves the ~30px a system bar
      would have added above all of that. Owner-approved after the logo
      landed. The drag/double-click handlers live in code-behind; presses
      that land on the menu or a button stay theirs.
    -->
    <Border DockPanel.Dock="Top" x:Name="TitleBar" Height="34"
            Background="{StaticResource BackgroundSecondaryBrush}"
            BorderBrush="{StaticResource BackgroundPrimaryBrush}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed" DoubleTapped="OnTitleBarDoubleTapped">
      <DockPanel>
        <Image DockPanel.Dock="Left" Source="{StaticResource BrandIconDrawing}"
               Width="17" Height="21" Margin="10,0,6,0" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Classes="caption" Content="&#x2500;" Click="OnMinimiseClicked" ToolTip.Tip="Minimise" />
          <Button Classes="caption" x:Name="MaximiseButton" Content="&#x25A1;" Click="OnMaximiseClicked" ToolTip.Tip="Maximise" />
          <Button Classes="caption close" Content="&#x2715;" Click="OnCloseClicked" ToolTip.Tip="Close" />
        </StackPanel>

    <!-- Menu bar -->
    <Menu DockPanel.Dock="Left" VerticalAlignment="Center" x:Name="MainMenu"
          Background="Transparent" BorderThickness="0">
      <MenuItem Header="_File" Classes="top">
        <MenuItem Header="_New…" Click="OnNewClicked" />
        <MenuItem Header="_Open…" Click="OnOpenClicked" />
        <!--
          Files and projects in one list, newest first, because "what was I
          working on" does not sort itself by kind. The items are built on
          open: a menu declared here would need bindings that a popup cannot
          resolve, and the list changes every time anything is opened anyway.
        -->
        <MenuItem x:Name="RecentMenu" Header="Open _recent" />
        <!--
          No InputGesture on either: both live in ShortcutMap so they show up in the
          shortcut editor and can be rebound. The labels come from the map for the same
          reason — a remapped key that still advertises Ctrl+S is worse than no label.
        -->
        <!--
          Everything from here down needs a document. With nothing open they are
          disabled rather than hidden: a File menu that changes shape depending
          on whether something is loaded is harder to learn than one where Save
          is always in the same place and greyed.
        -->
        <MenuItem x:Name="SaveMenu" Header="_Save" Click="OnSaveInPlaceClicked"
                  IsEnabled="{Binding HasDocument}" />
        <MenuItem x:Name="SaveAsMenu" Header="Save _as…" Click="OnSaveClicked"
                  IsEnabled="{Binding HasDocument}" />
        <Separator />
        <MenuItem Header="New _project…" Click="OnNewProjectClicked" />
        <MenuItem Header="Open p_roject…" Click="OnOpenProjectClicked" />
        <!--
          Q29's other surface, in its own window by Q41. Absent unless a project
          is open, because everything it shows is a question about one — and the
          gesture is registered in ShortcutMap rather than written onto this
          item, which is the trap Ctrl+S fell into.
        -->
        <!-- Present even without a project — invisible was how the owner
             never found it ("I have not found the project manager window in
             the application whatsoever"). Disabled with the reason instead:
             discoverable, and not a dead click. -->
        <MenuItem Header="Pro_ject manager…" Click="OnProjectWindowClicked"
                  IsEnabled="{Binding HasProject}"
                  ToolTip.Tip="Structure, status, tags, assets and people — what you do between drawings. Needs an open project." />
        <!--
          Conversion is a change of intent, not a migration: no document is
          read, rewritten or recreated. Absent unless a project is open, since
          there is nothing to convert otherwise.
        -->
        <MenuItem x:Name="ConvertProjectMenu" Header="{Binding ProjectTypeLabel}"
                  IsVisible="{Binding HasProject}" />
        <!--
          Templates. Absent unless a project is open, because without one a
          template is a file you Open and then Save as — which has always
          worked. What a project adds is being able to *list* them.
        -->
        <Separator IsVisible="{Binding HasProject}" />
        <MenuItem x:Name="TemplatesMenu" Header="New from _template…"
                  IsVisible="{Binding HasProject}" />
        <MenuItem Header="{Binding TemplateLabel}" ToggleType="CheckBox"
                  IsChecked="{Binding IsActiveDocumentTemplate, Mode=TwoWay}"
                  IsVisible="{Binding HasProject}"
                  IsEnabled="{Binding HasDocument}"
                  ToolTip.Tip="A template is an ordinary document with a flag. It does not move and does not change; it starts appearing in New from template…" />
        <MenuItem Header="_Update from template…" Click="OnUpdateFromTemplateClicked"
                  IsVisible="{Binding HasProject}"
                  IsEnabled="{Binding CanUpdateFromTemplate}"
                  ToolTip.Tip="Pull layers, guides, fps and a camera forward from the template this document came from. Never touches your drawings or your timing." />
        <Separator />
        <MenuItem Header="Export _document…" Click="OnExportDocumentClicked"
                  IsEnabled="{Binding HasDocument}"
                  ToolTip.Tip="A standalone .lightbox.json with every shared palette and gradient it uses inlined" />
        <MenuItem Header="_Export PNGs…" Click="OnExportClicked"
                  IsEnabled="{Binding HasDocument}"
                  ToolTip.Tip="A numbered frame sequence — with the scratch track beside it as audio.wav when there is one" />
        <MenuItem Header="Export _video…" Click="OnExportVideoClicked"
                  IsEnabled="{Binding HasDocument}"
                  ToolTip.Tip="H.264 MP4 for review, ProRes 422 MOV for editorial — the scratch track muxed in" />
        <MenuItem Header="Export for a _game engine…" Click="OnExportSheetClicked"
                  IsEnabled="{Binding HasDocument}"
                  ToolTip.Tip="Sprite sheet, sidecar and optional Unity importer. Trim, layout and background handling live here." />
      </MenuItem>
      <MenuItem Header="_Edit" Classes="top">
        <MenuItem Header="_Configure…" Click="OnConfigureClicked" />
        <MenuItem Header="Brush _library…" Click="OnBrushLibraryClicked" />
        <MenuItem Header="Brush _tips…" Click="OnBrushTipsClicked" />
        <Separator />
        <!-- Autosave. Zero is a real answer, not a mistake — someone working
             on a network drive may well want it off. -->
        <MenuItem Header="{Binding AutosaveLabel}">
          <MenuItem Header="Off" Click="OnAutosaveOff" />
          <MenuItem Header="Every 30 seconds" Click="OnAutosaveHalfMinute" />
          <MenuItem Header="Every minute" Click="OnAutosaveMinute" />
          <MenuItem Header="Every 5 minutes" Click="OnAutosaveFiveMinutes" />
          <MenuItem Header="Every 15 minutes" Click="OnAutosaveFifteenMinutes" />
          <Separator />
          <MenuItem Header="Also write over the file itself" ToggleType="CheckBox"
                    IsChecked="{Binding AutosaveInPlace, Mode=TwoWay}"
                    ToolTip.Tip="Off by default: silently rewriting the file you opened takes away closing without saving" />
        </MenuItem>
        <Separator />
        <!--
          Rulers and guides. Under Edit rather than View because these four
          decide what you can *change* — the rulers are where a guide is made,
          and the lock is what stops one moving under your hand. What guides
          there are, and what they do to a stroke, stays under View.
        -->
        <MenuItem Header="Show rulers" ToggleType="CheckBox"
                  IsChecked="{Binding Workspace.RulersVisible, Mode=TwoWay}"
                  InputGesture="Ctrl+R"
                  ToolTip.Tip="Drag out of a ruler to place a guide. While they are up, guides can be picked up and moved." />
        <MenuItem Header="Show guides" ToggleType="CheckBox"
                  IsChecked="{Binding Workspace.GuidesVisible, Mode=TwoWay}"
                  ToolTip.Tip="Hiding the rig still leaves it snapping — see View ▸ Guides ▸ Snap to guides" />
        <MenuItem Header="Lock guides" ToggleType="CheckBox"
                  IsChecked="{Binding Workspace.GuidesLocked, Mode=TwoWay}"
                  ToolTip.Tip="Pin them where they are, so working near one cannot nudge it" />
        <Separator />
        <MenuItem Header="Ask what to open on start-up" ToggleType="CheckBox"
                  IsChecked="{Binding ShowStartScreen, Mode=TwoWay}"
                  ToolTip.Tip="The start screen. Escape on it opens nothing — you can always ask again from the empty canvas or File ▸ New." />
      </MenuItem>
      <MenuItem Header="_View" Classes="top">
        <!--
          Guides are document data, like the camera, so they live under View
          next to the other things you turn on rather than in a panel that
          would cost a strip to everybody who never places one.
        -->
        <MenuItem Header="Guides">
          <MenuItem Header="Add horizontal ruler" Click="OnAddHorizontalGuide" />
          <MenuItem Header="Add vertical ruler" Click="OnAddVerticalGuide" />
          <MenuItem Header="Add grid" Click="OnAddGridGuide" />
          <MenuItem Header="Add isometric guide" Click="OnAddIsometricGuide" />
          <MenuItem Header="Add vanishing point" Click="OnAddVanishingPoint"
                    ToolTip.Tip="One is one-point perspective, two is two-point, three is three" />
          <Separator />
          <MenuItem Header="Snap to guides" ToggleType="CheckBox"
                    IsChecked="{Binding SnapToGuides, Mode=TwoWay}" />
          <MenuItem Header="Clear all guides" Command="{Binding ClearGuidesCommand}" />
        </MenuItem>
        <!--
          B58. The rig — sockets and collision shapes — beside the guides, for the
          same reason: it is document data you turn on rather than a panel that
          costs a strip to everybody who never places one.

          This item existing is most of the fix. `RigEditMode`, `RigMarks`,
          `AddAnchorAt` and the rest had no menu, no shortcut and no binding, so an
          artist could not switch the mode on and therefore could not reach any of
          the editing behind it. Ctrl+K, registered in `ShortcutMap` so it can be
          found and rebound.
        -->
        <MenuItem Header="Rig">
          <MenuItem Header="Edit anchors and hitboxes" ToggleType="CheckBox"
                    InputGesture="Ctrl+K"
                    IsChecked="{Binding RigEditMode, Mode=TwoWay}"
                    ToolTip.Tip="Drag on the canvas to place and move sockets and collision shapes instead of drawing" />
          <Separator />
          <MenuItem Header="Add anchor at centre" Click="OnAddRigAnchor"
                    IsEnabled="{Binding RigEditMode}"
                    ToolTip.Tip="A named point — a socket, or an extra pivot" />
          <MenuItem Header="Add collision shape at centre" Click="OnAddRigShape"
                    IsEnabled="{Binding RigEditMode}"
                    ToolTip.Tip="A rectangle — a hurtbox, hitbox or physics body" />
          <MenuItem Header="Delete selected" Click="OnDeleteRigMark"
                    IsEnabled="{Binding RigEditMode}" />
        </MenuItem>
        <Separator />
        <!-- Every docker toggle in one submenu (Q56): twelve checkable items
             inline made View a list to scan past to reach anything else. -->
        <MenuItem Header="_Dockers">
          <!-- MenuItem.IsChecked binds one-way by default: without Mode=TwoWay the
               click only flips the checkmark locally and the docker never reopens. -->
          <!-- Project and Symbols need a project to have anything to show, and
               `IsPanelUsable` keeps them out of the layout without one. The menu
               items have to be absent for the same reason: an item you can tick
               that then does nothing is worse than one that is not there. -->
          <MenuItem Header="Project" ToggleType="CheckBox" IsVisible="{Binding HasProject}"
                    IsChecked="{Binding Workspace.ProjectPanelVisible, Mode=TwoWay}" />
          <MenuItem Header="Layers" ToggleType="CheckBox" IsChecked="{Binding Workspace.LayersPanelVisible, Mode=TwoWay}" />
          <MenuItem Header="Timeline" ToggleType="CheckBox" IsChecked="{Binding TimelineVisible, Mode=TwoWay}" />
          <MenuItem Header="X-sheet" ToggleType="CheckBox" IsChecked="{Binding Workspace.XsheetDockerVisible, Mode=TwoWay}" />
          <MenuItem Header="Graph editor" ToggleType="CheckBox" IsChecked="{Binding Workspace.GraphEditorDockerVisible, Mode=TwoWay}" />
          <MenuItem Header="Color" ToggleType="CheckBox" IsChecked="{Binding ColorDockerVisible, Mode=TwoWay}" />
          <MenuItem Header="Palette" ToggleType="CheckBox" IsChecked="{Binding PaletteDockerVisible, Mode=TwoWay}" />
          <MenuItem Header="Gradient" ToggleType="CheckBox" IsChecked="{Binding GradientDockerVisible, Mode=TwoWay}" />
          <MenuItem Header="Reference sheets" ToggleType="CheckBox" IsChecked="{Binding SheetsDockerVisible, Mode=TwoWay}" />
          <MenuItem Header="Reference" ToggleType="CheckBox" IsChecked="{Binding ReferenceDockerVisible, Mode=TwoWay}" />
          <MenuItem Header="Tool options" ToggleType="CheckBox"
                    IsChecked="{Binding Workspace.ToolOptionsDockerVisible, Mode=TwoWay}"
                    ToolTip.Tip="The full brush parameters as a panel — the same pages the toolbar's gear opens" />
          <MenuItem Header="Symbols" ToggleType="CheckBox"
                    IsChecked="{Binding Workspace.SymbolsPanelVisible, Mode=TwoWay}"
                    ToolTip.Tip="A drawing stored once and placed many times. Your own library is here with no project open; project symbols need a project." />
        </MenuItem>
        <Separator />
        <!-- The bars that sit on the canvas. Separate from the panels above
             because they are a different trade: a panel takes room away from
             the drawing, a bar sits on top of it. -->
        <MenuItem Header="View bar" ToggleType="CheckBox"
                  IsChecked="{Binding Workspace.ViewBarVisible, Mode=TwoWay}"
                  ToolTip.Tip="Zoom, rotate and mirror, on the canvas" />
        <MenuItem Header="Shortcut bar" ToggleType="CheckBox"
                  IsChecked="{Binding Workspace.ShortcutBarVisible, Mode=TwoWay}"
                  ToolTip.Tip="Onion skin, camera and playback, on the canvas" />
        <Separator />
        <!-- Workspaces are global, never stored in a project: a layout is a
             property of the person, not of the artwork. Opening someone
             else's file must not rearrange your screen. -->
        <MenuItem Header="_Workspace">
          <MenuItem Header="Save current workspace" Click="OnSaveWorkspace"
                    ToolTip.Tip="Update the selected workspace with the arrangement on screen" />
          <MenuItem Header="Save as new workspace…" Click="OnSaveWorkspaceAs" />
          <MenuItem Header="Reset to saved" Click="OnResetWorkspace"
                    ToolTip.Tip="Discard the changes and go back to what this workspace says" />
        </MenuItem>
      </MenuItem>

      <!--
        Help, and the first thing under it is not documentation.

        The app writes a crash report and a survivable-failure log to disk, and
        a file nobody can find helps nobody — so the folder is one click from
        the menu bar rather than a path in the manual. The console is the live
        half of the same question, and it is remembered across restarts because
        the way it gets used is "turn it on, restart, reproduce".
      -->
      <MenuItem Header="_Help" Classes="top">
        <MenuItem Header="Open the diagnostics folder" Click="OnOpenDiagnosticsFolder"
                  ToolTip.Tip="Crash reports and the log of problems Lightbox survived" />
        <MenuItem Header="Show a console while drawing" ToggleType="CheckBox"
                  IsChecked="{Binding ShowDiagnosticsConsole, Mode=TwoWay}"
                  ToolTip.Tip="Opens a console window at the next start, carrying the diagnostic traces" />
        <!--
          Always visible, unlike the crash scenarios below: this one is how a
          performance report gets made, and asking somebody to turn diagnostics
          on first is a step they will not know to take when the app feels slow.
          A short version is written on every start; this is the full one, with
          what has been measured since and an upload probe timed on the real GPU.
        -->
        <MenuItem Header="Write a render report" Click="OnWriteRenderReport"
                  ToolTip.Tip="Measures this machine's drawing path and writes it to the diagnostics folder" />
        <!--
          Absent unless diagnostics are on, the same way the Project menu items
          are absent without a project: an item you can click that then does
          something nobody wanted is worse than one that is not there.

          Bound to the same setting as the console, so turning diagnostics on
          brings both. Unlike the console — which needs a restart, because one
          opened mid-session has missed everything — this appears the moment the
          box is ticked.
        -->
        <MenuItem Header="Trigger a test failure" IsVisible="{Binding ShowDiagnosticsConsole}"
                  ToolTip.Tip="Deliberate failures, so the crash report and the console can be seen working">
          <!--
            The Tag is the scenario's key, and CrashScenarios owns what each one
            does. Spelled out here rather than generated from the list because
            every other menu in this file is spelled out, and a menu that builds
            itself is harder to read than the seven lines it saves. A test holds
            the two sides together.
          -->
          <MenuItem Header="A failure the app survives" Tag="survivable" Click="OnRunCrashScenario" />
          <MenuItem Header="Write a line to the console" Tag="console" Click="OnRunCrashScenario" />
          <MenuItem Header="A background task nobody waited for" Tag="unobserved-task" Click="OnRunCrashScenario" />
          <Separator />
          <MenuItem Header="Crash on the drawing thread" Tag="ui-thread" Click="OnRunCrashScenario" />
          <MenuItem Header="Crash on a background thread" Tag="background-thread" Click="OnRunCrashScenario" />
          <MenuItem Header="Crash with a cause underneath" Tag="inner-exception" Click="OnRunCrashScenario" />
          <Separator />
          <MenuItem Header="Kill the process outright" Tag="hard-kill" Click="OnRunCrashScenario" />
        </MenuItem>

        <Separator />
        <MenuItem Header="{Binding BuildLabel}" Click="OnCopyBuildLabel"
                  ToolTip.Tip="Click to copy — a bug report is far more useful with the build in it" />
      </MenuItem>
    </Menu>
        <!-- Whatever the menu and the buttons leave of the row is grip. -->
        <Border Background="Transparent" />
      </DockPanel>
    </Border>

    <!-- Dynamic tool options bar: contents depend on the selected tool -->
    <Border DockPanel.Dock="Top" Padding="8,2" Background="{StaticResource BackgroundSecondaryBrush}">
      <DockPanel>

        <!--
          Workspace picker, pinned to the right.

          Here rather than buried in a menu because switching workspaces is a
          thing you do between tasks, several times a session, and a menu two
          levels deep is where a feature goes to be forgotten. Saved
          workspaces carry a bin; the built-ins do not, because a built-in is
          what "reset" falls back to and deleting one would take the fallback
          with it.
        -->
        <!-- A rule between the two, because the bar's overflow control ends up
             directly beside this one and without a divider the pair reads as
             one group belonging to the workspace. -->
        <Border DockPanel.Dock="Right" Width="1" Margin="10,3" Background="{StaticResource BorderBrush}" />
        <!-- Flush text with a bottom highlight — the section-tab treatment,
             because switching workspace changes what the whole window is for.
             Deleting a saved workspace moved to the right-click menu on its
             name; the built-ins never offered it. -->
        <ListBox x:Name="WorkspacePicker" DockPanel.Dock="Right" Classes="sectiontabs"
                 ItemsSource="{Binding Workspace.WorkspaceChoices}"
                 SelectedValue="{Binding Workspace.SelectedName, Mode=OneWay}"
                 SelectedValueBinding="{Binding Name, DataType=vm:WorkspaceRow}"
                 SelectionChanged="OnWorkspacePicked"
                 VerticalAlignment="Center"
                 ToolTip.Tip="Switch workspace — panel arrangements, saved globally">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="0" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceRow">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                <TextBlock.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Delete this workspace" IsVisible="{Binding CanDelete}"
                              Click="OnDeleteWorkspace" Tag="{Binding Name}" />
                  </ContextMenu>
                </TextBlock.ContextMenu>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      <!--
        The tool options scroll rather than push. A brush row is wide, and
        without this the DockPanel gives it everything and crushes the
        workspace picker beside it into a sliver.
      -->
      <!--
        A fixed height. Each tool contributes a different set of controls, and
        letting the bar size to whichever is tallest meant the canvas jumped
        every time you changed tool — the one piece of chrome that must never
        move, because it is directly above the thing you are aiming at.
      -->
      <!--
        Never scrolls. Whatever does not fit goes into the ▾ at the end — a
        horizontal scrollbar hides controls behind a gesture nobody tries, and
        a vertical one changes the bar's height, which moves the canvas.
      -->
      <!--
        B77. Colour, pinned to the left of the bar and never conditional.

        It lived inside the brush panel, so `IsVisible="{Binding IsBrushTool}"`
        hid it for the fill and the shape tools — which paint with the
        foreground colour. Changing colour for a fill meant selecting the brush,
        changing it, and selecting the fill again.

        Persistent rather than shown per tool, which is both what the reporter
        asked for and the simpler rule: a control that is always there needs no
        table of which tools use colour, and a table like that is the thing that
        drifts. `ShortcutMap` exists for the same reason one level up.

        Outside the OverflowBar on purpose. The bar's job is to drop what does
        not fit into its ▾, and colour is the last thing that should go there —
        it is the one control every painting tool shares. Docked left so the
        tool's own options begin after it, in a fixed place, whatever tool is
        selected.
      -->
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4"
                  VerticalAlignment="Center" Margin="0,0,10,0">
        <!--
          Foreground over background, the arrangement every painting tool
          has had for thirty years. One pair, shared by the brush, the fill
          and the gradient: reaching for the same colour in three tools and
          finding three answers is what this prevents. X swaps, D resets.
        -->
        <Panel Width="32" Height="26" VerticalAlignment="Center"
               ToolTip.Tip="Foreground over background — click to pick, drag onto the canvas to fill. X swaps them, D resets to black over white">
          <Border x:Name="BackgroundSwatch" Tag="background"
                  Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  CornerRadius="3" BorderBrush="#555" BorderThickness="1"
                  Background="{Binding BackgroundColorHex}"
                  PointerPressed="OnColorSwatchPressed" Cursor="Hand">
            <FlyoutBase.AttachedFlyout>
              <Flyout Placement="Bottom">
                <ContentControl Content="{Binding BackgroundPicker}"
                                ContentTemplate="{StaticResource ColorPickerBody}" />
              </Flyout>
            </FlyoutBase.AttachedFlyout>
          </Border>
          <Border x:Name="ForegroundSwatch" Tag="foreground"
                  Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                  CornerRadius="3" BorderBrush="#888" BorderThickness="1"
                  Background="{Binding ColorPicker.SwatchBrush}"
                  PointerPressed="OnColorSwatchPressed" Cursor="Hand">
            <FlyoutBase.AttachedFlyout>
              <Flyout Placement="Bottom">
                <ContentControl Content="{Binding ColorPicker}"
                                ContentTemplate="{StaticResource ColorPickerBody}" />
              </Flyout>
            </FlyoutBase.AttachedFlyout>
          </Border>
        </Panel>
        <!--
          The dropdown beside the pair. The swatches themselves are a
          press-and-maybe-drag gesture, and a gesture is a bad place to hang
          the only way to reach the picker: a press that turns into a drag has
          to decide *not* to open it, so the picker is one committed click
          away and never the accidental result of a hand that moved.
        -->
        <Button x:Name="ColorPickerDropdown" Classes="icon" Content="▾" FontSize="9"
                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                ToolTip.Tip="Colour picker">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <ContentControl Content="{Binding ColorPicker}"
                              ContentTemplate="{StaticResource ColorPickerBody}" />
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Classes="icon" Content="⇄" FontSize="10" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Command="{Binding SwapColorsCommand}" ToolTip.Tip="Swap foreground and background (X)" />
        <!-- A rule, so the tool's own options read as a separate group rather
             than as more colour controls. -->
        <Border Width="1" Margin="6,3,0,3" Background="{StaticResource BorderBrush}" />
      </StackPanel>

      <controls:OverflowBar Spacing="14" VerticalAlignment="Center"
                            MoreLabel="More tool options  &#x25BE;">

        <!-- Transform session (Ctrl+T): shown above whatever tool was active -->
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding TransformActive}">
          <TextBlock Text="Transform" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding TransformScopeChoices}" SelectedItem="{Binding TransformScope}"
                    Width="150" VerticalAlignment="Center"
                    ToolTip.Tip="What the transform applies to: this cel, all layers at this frame, the selected cel range, or the whole animation" />
          <ComboBox ItemsSource="{Binding TransformSamplingChoices}" SelectedItem="{Binding TransformSampling}"
                    Width="98" VerticalAlignment="Center"
                    ToolTip.Tip="Pixel solver for raster baselines: Bilinear (smooth), Nearest (pixel art), Bicubic (highest quality). Strokes are geometry and never resample." />
          <ToggleButton x:Name="TransformPerspectiveToggle" Content="Perspective" FontSize="12"
                        Click="OnTransformPerspectiveToggled"
                        ToolTip.Tip="Drag the four corners freely instead of the affine box" />
          <Button Content="⇋" FontSize="13" Click="OnTransformMirrorH"
                  ToolTip.Tip="Mirror horizontally in place (around the pivot)" />
          <Button Content="⇵" FontSize="13" Click="OnTransformMirrorV"
                  ToolTip.Tip="Mirror vertically in place (around the pivot)" />
          <Button Content="Reset" FontSize="12" Click="OnTransformReset"
                  ToolTip.Tip="Back to the untransformed drawing (session stays open)" />
          <Button Content="Apply" FontSize="12" FontWeight="SemiBold" Click="OnTransformApply"
                  ToolTip.Tip="Commit the transform (Enter)" />
          <Button Content="Cancel" FontSize="12" Click="OnTransformCancel"
                  ToolTip.Tip="Discard the transform (Esc)" />
        </StackPanel>

        <!--
          The preset picker and the ⚙ that opens every parameter, together,
          because the ⚙ configures the brush the picker names and sat at the
          far right of the bar past the effect and shape groups.

          The group is IsPaintTool and the picker inside it is IsBrushTool, which
          is not redundant: the ⚙ has always served the eraser too, so binding the
          pair to IsBrushTool would have taken the eraser's parameters away. The
          cost is that with the eraser held the ⚙ sits where the picker would be.
          A second copy for the eraser was the alternative and is what this file
          argues against elsewhere — two copies of one control buys a second place
          to look.
        -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    IsVisible="{Binding IsPaintTool}">
          <!--
            The badge is the whole point of the list being ordered the way it
            is: fast brushes first, expressive ones after, so the two kinds are
            contiguous rather than interleaved. ◈ marks a brush that reads the
            canvas, simulates a medium or blends the layers underneath — not a
            warning, a price tag, and the tooltip names what you are paying
            for. Derived from the settings, so editing a brush moves it.
          -->
          <!--
            A flyout rather than a dropdown, because a dropdown is a list and
            what an artist has is a collection. Once there are forty brushes
            scrolling is the wrong verb: you search for the one you mean, or
            you go to the tag you filed it under.
          -->
          <Button x:Name="BrushPickerButton" Width="150" VerticalAlignment="Center" Padding="6,3"
                  IsVisible="{Binding IsBrushTool}"
                  Click="OnBrushPickerOpen"
                  ToolTip.Tip="Brush preset (B returns to the last configured brush). ◈ marks an expressive brush — richer mark, more cost.">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="▾" FontSize="10" Opacity="0.6"
                         VerticalAlignment="Center" Margin="4,0,0,0" />
              <!-- The dot says the brush has drifted from the preset named beside it -->
              <TextBlock DockPanel.Dock="Right" Text="{Binding BrushModifiedBadge}" Foreground="{StaticResource StatusWarningBrush}"
                         FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"
                         ToolTip.Tip="{Binding BrushModifiedTip}" />
              <TextBlock x:Name="BrushPickerName" Text="Brush" VerticalAlignment="Center"
                         FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <DockPanel Width="404" MaxHeight="500">
                  <TextBox x:Name="BrushSearchBox" DockPanel.Dock="Top" Watermark="Search brushes"
                           Margin="0,0,0,6" TextChanged="OnBrushFilterChanged" />
                  <!--
                    Tags as chips rather than a second dropdown: the whole set
                    is small, and seeing which ones exist is most of the value
                    — an artist who has forgotten what they filed things under
                    cannot search for it.
                  -->
                  <ItemsControl x:Name="BrushTagChips" DockPanel.Dock="Top" Margin="0,0,0,6"
                                IsVisible="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock x:Name="BrushFilterEmpty" DockPanel.Dock="Bottom" IsVisible="False"
                             Text="No brush matches." Opacity="0.5" FontSize="11" Margin="0,6,0,0" />
                  <!--
                    The way out of the picker, same as the tip picker's own. It
                    is where you are when you notice you have brushes you do not
                    want, so it is where the button to deal with them belongs.
                  -->
                  <Button DockPanel.Dock="Bottom" Content="Brush library…" Click="OnBrushLibraryClicked"
                          HorizontalAlignment="Stretch" Margin="0,6,0,0"
                          ToolTip.Tip="Import, rename and remove brushes" />
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!--
                      A grid of marks, not a list of names. The names in an
                      imported collection were chosen by somebody else — "Wet
                      bristle 04" and "Wet bristle 07" are genuinely different
                      brushes and nothing in the words says how — so the mark
                      is the control and the name is the caption under it. The
                      same reasoning as the tip picker above, one level up.
                    -->
                    <ListBox x:Name="BrushPresetList" Background="Transparent"
                             SelectionChanged="OnBrushPresetPicked">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <!-- Three columns: enough to compare neighbours without the mark getting too small to read -->
                          <WrapPanel Orientation="Horizontal" ItemWidth="126" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:BrushChoice">
                          <StackPanel Margin="0,2" Spacing="2" ToolTip.Tip="{Binding Tip}">
                            <Panel>
                              <Border Height="44" Background="{StaticResource CanvasPaperBrush}" CornerRadius="3">
                                <Image Source="{Binding Preview}" Stretch="None"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <!--
                                The cost badge sits on the picture rather than
                                beside the name: the tile is what somebody is
                                looking at, and a price tag off to the side of
                                a grid is read as decoration.
                              -->
                              <TextBlock Text="{Binding CostBadge}" Foreground="{StaticResource StatusWarningBrush}" FontSize="11"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,3,0" />
                              <!-- The one thing the picture cannot carry: the brush's real size -->
                              <Border Background="{StaticResource CanvasPaperBrush}" CornerRadius="2" Padding="3,0"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                                <TextBlock Text="{Binding SizeLabel}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                              </Border>
                            </Panel>
                            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </ScrollViewer>
                </DockPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- Full brush parameters (brush + eraser): now a docker, per the
               owner — "a tool options docker instead of keeping it in the
               rail". The gear stays as the way in, and always OPENS. -->
          <Button Content="⚙" VerticalAlignment="Center"
                  ToolTip.Tip="All brush parameters (opens the Tool options panel)"
                  IsVisible="{Binding IsPaintTool}"
                  Command="{Binding OpenToolOptionsCommand}" />
        </StackPanel>

        <!-- Brush options -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsBrushTool}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Size" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushSize}" Minimum="1" Maximum="300" Classes="param" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushSize}" Minimum="1" Maximum="500" Increment="1"
                           FormatString="0.#" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Brush size (type an exact value)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Hardness" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushHardness}" Minimum="0" Maximum="1" Classes="param" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushHardness}" Minimum="0" Maximum="1" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Brush hardness (type an exact value, 0–1)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Opacity" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushOpacity}" Minimum="0.01" Maximum="1" Classes="param" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushOpacity}" Minimum="0.01" Maximum="1" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Brush transparency (0–1)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Stabilizer" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding SmoothingChoices}" SelectedItem="{Binding SmoothingMode}"
                      Width="140" VerticalAlignment="Center"
                      ToolTip.Tip="Input smoothing: Laplacian = light touch-up, MovingAverage = steady, Ema = low lag, PulledString = lazy mouse, SavitzkyGolay = keeps corners" />
            <NumericUpDown Value="{Binding SmoothingWindow}" Minimum="3" Maximum="25" Increment="2"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           IsVisible="{Binding IsWindowSmoothing}"
                           ToolTip.Tip="Window size — higher smooths more" />
            <NumericUpDown Value="{Binding SmoothingStrength}" Minimum="0" Maximum="0.95" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           IsVisible="{Binding IsEmaSmoothing}"
                           ToolTip.Tip="Strength — higher smooths more (slightly laggier)" />
            <NumericUpDown Value="{Binding LazyRadius}" Minimum="4" Maximum="200" Increment="2"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           IsVisible="{Binding IsPulledStringSmoothing}"
                           ToolTip.Tip="String length in pixels — the brush trails the cursor by this much" />
            <!--
              Which settings the controls beside this are pointed at. Ticking it
              copies whatever is in effect, so it never changes how the brush
              draws — only what the sliders now belong to. An inking brush wants
              heavy lazy-mouse and a pencil wants none, and that is the whole
              reason stabilisation is worth setting at all.
            -->
            <CheckBox Content="Per brush" VerticalAlignment="Center" FontSize="11"
                      MinHeight="0" Height="22" Padding="4,0,0,0"
                      IsChecked="{Binding BrushHasOwnStabilisation}"
                      ToolTip.Tip="On, this brush carries its own stabilisation and keeps it in its preset. Off, it follows the application-wide setting." />
          </StackPanel>
        </StackPanel>

        <!--
          Effect brushes get their own row.

          Smudge and blur rework pixels that are already there, so most of the
          brush row is beside the point for them — a smudge has no opacity in
          the usual sense. What you reach for is how hard it bites and how wide
          an area each dab samples, and those were three clicks deep in the
          parameters flyout.
        -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    IsVisible="{Binding ShowsEffectOptions}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Strength" VerticalAlignment="Center" />
            <Slider Value="{Binding EffectStrength}" Minimum="0.01" Maximum="1" Classes="param" VerticalAlignment="Center" />
            <!--
              Steps of 0.01, not 0.05, and that is a consequence of B90 rather
              than a preference. The shipped effect brushes are Smudge 0.08 and
              Blender 0.06 — flow on an effect brush compounds about ten dabs
              deep — so at the old 0.05 step an artist could not dial the value
              their own brush ships with. Blur's useful range is coarser and
              loses nothing by the finer step.
            -->
            <NumericUpDown Value="{Binding EffectStrength}" Minimum="0.01" Maximum="1" Increment="0.01"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="How hard each dab pulls (smudge and blender), or how much softening (blur). Effect-brush dabs overlap about ten deep, so small values go a long way." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Radius" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushSmudgeRadius}" Minimum="0.05" Maximum="1" Classes="param" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushSmudgeRadius}" Minimum="0.05" Maximum="1" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="How wide an area each dab samples. Wider blends more and keeps less detail." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding IsSmudgeBrush}">
            <TextBlock Text="Colour" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushColorRate}" Minimum="0" Maximum="1" Classes="param" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushColorRate}" Minimum="0" Maximum="1" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="How much of the brush's own colour it adds while smudging. Zero is a pure blender." />
            <!--
              Smearing-versus-dulling deliberately does NOT live here.

              It was a bare ComboBox among label-slider-value groups, so it sat
              at a different height from everything beside it and there was
              nowhere to put its label — and it is the same control the ⚙
              Effects page already carries, aligned with its neighbours because
              that page is a column of labelled rows. Two copies of one setting
              buys a misaligned bar and a second place to look.

              It also is not the thing you reach for mid-stroke. Strength,
              radius and colour rate are adjusted constantly; whether a smudge
              smears or dulls is what makes it that brush, and it belongs with
              the brush rather than on the bar.
            -->
          </StackPanel>
        </StackPanel>

        <!--
          The gradient tool's own row. The preview IS the editor: click it for
          the ramp, with opacity markers above and colour markers below.

          A list of rows with position spinners describes a gradient; this is
          the gradient. Where a change happens is a spatial judgement, and a
          number is a poor way to make one.
        -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    IsVisible="{Binding IsGradientTool}">
          <ComboBox ItemsSource="{Binding GradientDocker.Gradients}"
                    SelectedItem="{Binding GradientDocker.SelectedGradient}"
                    Width="130" VerticalAlignment="Center" ToolTip.Tip="Gradient">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="docs:Gradient">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button x:Name="GradientPreviewButton"
                  Padding="0" Height="22" Width="90" VerticalAlignment="Center"
                  BorderBrush="#666" BorderThickness="1"
                  Background="{Binding GradientDocker.Preview}"
                  ToolTip.Tip="Edit this gradient — click the ramp to add stops">
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <StackPanel Width="300" Spacing="8">
                  <controls:GradientRamp x:Name="RampEditor"
                                         Gradient="{Binding GradientDocker.SelectedGradient}" />
                  <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                             Text="Click above the ramp for an opacity stop, below it for a colour stop. Drag to move, middle-click to remove." />

                  <!-- An opacity stop: a number and a slider, nothing else. -->
                  <StackPanel Spacing="4" IsVisible="{Binding GradientDocker.HasAlphaStop}">
                    <TextBlock Text="Opacity stop" FontSize="10" Opacity="0.6" />
                    <DockPanel>
                      <NumericUpDown DockPanel.Dock="Right" Classes="value" FontSize="11"
                                     Value="{Binding GradientDocker.SelectedAlpha}"
                                     Minimum="0" Maximum="100" Increment="5" FormatString="0" />
                      <Slider Value="{Binding GradientDocker.SelectedAlpha}"
                              Minimum="0" Maximum="100" Margin="0,0,4,0" />
                    </DockPanel>
                  </StackPanel>

                  <!-- A colour stop: the picker, the same one as everywhere. -->
                  <StackPanel Spacing="4" IsVisible="{Binding GradientDocker.HasStop}">
                    <TextBlock Text="Colour stop" FontSize="10" Opacity="0.6" />
                    <controls:ColorField Hex="{Binding GradientDocker.SelectedStop.Color, Mode=TwoWay}"
                                         HorizontalAlignment="Left" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <ComboBox ItemsSource="{Binding GradientDocker.KindChoices}"
                              SelectedItem="{Binding GradientDocker.Kind}" Width="92" FontSize="11"
                              ToolTip.Tip="Linear runs along the drag; radial takes the drag as its radius" />
                    <ComboBox ItemsSource="{Binding GradientDocker.SpreadChoices}"
                              SelectedItem="{Binding GradientDocker.Spread}" Width="92" FontSize="11"
                              ToolTip.Tip="What happens beyond the ends of the ramp" />
                    <Button Classes="icon" Content="＋" FontSize="10"
                            Command="{Binding GradientDocker.AddGradientCommand}"
                            ToolTip.Tip="New gradient" />
                    <Button Classes="icon" Content="✕" FontSize="10"
                            Command="{Binding GradientDocker.RemoveGradientCommand}"
                            IsEnabled="{Binding GradientDocker.HasGradient}"
                            ToolTip.Tip="Delete this gradient" />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Opacity" VerticalAlignment="Center" />
            <Slider Value="{Binding GradientOpacity}" Minimum="0" Maximum="1" Classes="param"
                    VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding GradientOpacity}" Minimum="0" Maximum="1" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Opacity the gradient tool lays the ramp down at" />
          </StackPanel>
        </StackPanel>

        <!-- Shape options -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsShapeTool}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Shape" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ShapeChoices}" SelectedItem="{Binding ActiveShape}"
                      Width="110" VerticalAlignment="Center"
                      ToolTip.Tip="Shift squares it, Alt grows it from the centre" />
          </StackPanel>
          <!-- Only a polygon has a side count, and a disabled field is one
               more thing to read past on every other shape. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding IsPolygonShape}">
            <TextBlock Text="Sides" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding PolygonSides}" Minimum="3" Maximum="64" Increment="1"
                           FormatString="0" Classes="value" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Drawn with the current brush" FontSize="11" Opacity="0.55"
                     VerticalAlignment="Center"
                     ToolTip.Tip="A shape is a stroke, so it takes the brush you have loaded — and erases and re-renders like any other mark" />
        </StackPanel>


        <!-- Eraser options -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsEraserTool}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Size" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushSize}" Minimum="1" Maximum="300" Classes="param" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushSize}" Minimum="1" Maximum="500" Increment="1"
                           FormatString="0.#" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Eraser size (type an exact value)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Hardness" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushHardness}" Minimum="0" Maximum="1" Classes="param" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushHardness}" Minimum="0" Maximum="1" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Eraser hardness (type an exact value, 0–1)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Opacity" VerticalAlignment="Center" />
            <Slider Value="{Binding BrushOpacity}" Minimum="0.01" Maximum="1" Classes="param" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushOpacity}" Minimum="0.01" Maximum="1" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Eraser strength (0–1)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Stabilizer" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding SmoothingChoices}" SelectedItem="{Binding SmoothingMode}"
                      Width="140" VerticalAlignment="Center"
                      ToolTip.Tip="Input smoothing: Laplacian = light touch-up, MovingAverage = steady, Ema = low lag, PulledString = lazy mouse, SavitzkyGolay = keeps corners" />
            <NumericUpDown Value="{Binding SmoothingWindow}" Minimum="3" Maximum="25" Increment="2"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           IsVisible="{Binding IsWindowSmoothing}"
                           ToolTip.Tip="Window size — higher smooths more" />
            <NumericUpDown Value="{Binding SmoothingStrength}" Minimum="0" Maximum="0.95" Increment="0.05"
                           FormatString="0.00" Classes="value" VerticalAlignment="Center"
                           IsVisible="{Binding IsEmaSmoothing}"
                           ToolTip.Tip="Strength — higher smooths more (slightly laggier)" />
            <NumericUpDown Value="{Binding LazyRadius}" Minimum="4" Maximum="200" Increment="2"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           IsVisible="{Binding IsPulledStringSmoothing}"
                           ToolTip.Tip="String length in pixels — the brush trails the cursor by this much" />
            <!--
              Which settings the controls beside this are pointed at. Ticking it
              copies whatever is in effect, so it never changes how the brush
              draws — only what the sliders now belong to. An inking brush wants
              heavy lazy-mouse and a pencil wants none, and that is the whole
              reason stabilisation is worth setting at all.
            -->
            <CheckBox Content="Per brush" VerticalAlignment="Center" FontSize="11"
                      MinHeight="0" Height="22" Padding="4,0,0,0"
                      IsChecked="{Binding BrushHasOwnStabilisation}"
                      ToolTip.Tip="On, this brush carries its own stabilisation and keeps it in its preset. Off, it follows the application-wide setting." />
          </StackPanel>
        </StackPanel>

        <!-- Fill options -->
        <!-- The arrow. Nothing to configure yet: what it has to say is what is
             selected, and the actions that need a selection arrive with V3. An
             empty bar would still be right to register now, because a tool with
             no options panel is a tool the bar has never heard of. -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsArrowTool}">
          <TextBlock Text="{Binding StrokeSelectionSummary}" VerticalAlignment="Center"
                     ToolTip.Tip="Click a line to select it, Shift to add. Click empty canvas to let go." />
          <TextBlock Text="Click a line, a guide or a symbol to select it."
                     VerticalAlignment="Center" Opacity="0.6"
                     IsVisible="{Binding !HasStrokeSelection}" />
          <!-- The actions appear with a selection rather than sitting greyed
               out. A bar that is mostly disabled controls reads as a tool that
               is mostly broken; this one says nothing until it can do something. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding HasStrokeSelection}">
            <Button Content="Recolour" Command="{Binding RecolourSelectedLinesCommand}"
                    ToolTip.Tip="Repaint the selected lines in the foreground colour. A line that came from a palette stops following its swatch." />
            <Button Content="Delete" Command="{Binding DeleteSelectedLinesCommand}"
                    ToolTip.Tip="Delete the selected lines (Delete). Undo puts them back in the order they were in." />
            <TextBlock Text="arrow keys nudge, Shift ×10" VerticalAlignment="Center" Opacity="0.6" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsFillTool}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Tolerance" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding FillTolerance}" Minimum="0" Maximum="255" Increment="4"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="How different a pixel may be and still count as the same area" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Gap px" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding FillGapPx}" Minimum="0" Maximum="32" Increment="1"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Openings up to this many pixels still count as closed" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Grow px" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding FillGrowPx}" Minimum="-16" Maximum="16" Increment="1"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Overfill (+) under the line work, or underfill (−) to keep a margin" />
          </StackPanel>
          <CheckBox Content="Smart fill" IsChecked="{Binding SmartFill}" VerticalAlignment="Center"
                    ToolTip.Tip="Sample every visible layer (fill what looks empty) instead of only the active layer" />
          <CheckBox Content="Below line work" IsChecked="{Binding FillBelowLines}" VerticalAlignment="Center"
                    ToolTip.Tip="Tuck the fill under the lines (fills about half the line width so no white shows); off = fill on top, preserving lines" />
        </StackPanel>

        <!-- Selection options -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsSelectTool}">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <RadioButton GroupName="selvar" Content="◌" IsChecked="{Binding IsFreehandVariant, Mode=OneWay}"
                         Command="{Binding SelectVariantOfCommand}" CommandParameter="{x:Static vm:SelectVariant.Freehand}"
                         ToolTip.Tip="Freehand selection" />
            <RadioButton GroupName="selvar" Content="⬠" IsChecked="{Binding IsPolygonVariant, Mode=OneWay}"
                         Command="{Binding SelectVariantOfCommand}" CommandParameter="{x:Static vm:SelectVariant.Polygon}"
                         ToolTip.Tip="Polygon selection (click vertices, double-click to close, Esc cancels)" />
            <RadioButton GroupName="selvar" Content="▭" IsChecked="{Binding IsBoxVariant, Mode=OneWay}"
                         Command="{Binding SelectVariantOfCommand}" CommandParameter="{x:Static vm:SelectVariant.Box}"
                         ToolTip.Tip="Box selection" />
            <RadioButton GroupName="selvar" Content="◯" IsChecked="{Binding IsEllipseVariant, Mode=OneWay}"
                         Command="{Binding SelectVariantOfCommand}" CommandParameter="{x:Static vm:SelectVariant.Ellipse}"
                         ToolTip.Tip="Circle/ellipse selection" />
            <RadioButton GroupName="selvar" Content="🪄" IsChecked="{Binding IsWandVariant, Mode=OneWay}"
                         Command="{Binding SelectVariantOfCommand}" CommandParameter="{x:Static vm:SelectVariant.Wand}"
                         ToolTip.Tip="Magic wand — click to select a connected color region" />
          </StackPanel>
          <!-- Wand-only options -->
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsWandVariant}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Tolerance" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding WandTolerance}" Minimum="0" Maximum="255" Increment="4"
                             FormatString="0" Classes="value" VerticalAlignment="Center"
                             ToolTip.Tip="How different a pixel may be and still join the selection" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Gap px" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding WandGapPx}" Minimum="0" Maximum="32" Increment="1"
                             FormatString="0" Classes="value" VerticalAlignment="Center"
                             ToolTip.Tip="Openings up to this many pixels still count as closed" />
            </StackPanel>
            <CheckBox Content="Sample all layers" IsChecked="{Binding WandSampleAllLayers}" VerticalAlignment="Center"
                      ToolTip.Tip="Select from what you see (all visible layers) instead of only the active layer" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Feather" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding SelectionFeather}" Minimum="0" Maximum="100" Increment="1"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Soften the selection edge by this many pixels" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <NumericUpDown Value="{Binding SelectionAdjustPx}" Minimum="1" Maximum="64" Increment="1"
                           FormatString="0" Classes="value" VerticalAlignment="Center"
                           ToolTip.Tip="Pixels for Grow/Shrink" />
            <Button Content="Grow" Command="{Binding GrowSelectionCommand}"
                    ToolTip.Tip="Enlarge the selection" />
            <Button Content="Shrink" Command="{Binding ShrinkSelectionCommand}"
                    ToolTip.Tip="Shrink the selection" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Content="All" Command="{Binding SelectAllCommand}" ToolTip.Tip="Select the whole canvas (Ctrl+A)" />
            <Button Content="None" Command="{Binding DeselectCommand}" ToolTip.Tip="Deselect (Ctrl+D)" />
            <Button Content="Invert" Command="{Binding InvertSelectionCommand}" ToolTip.Tip="Invert the selection (Ctrl+Shift+I)" />
          </StackPanel>
          <TextBlock Text="Shift adds · Alt subtracts" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
        </StackPanel>
      </controls:OverflowBar>
      </DockPanel>
    </Border>

    <!-- AI bar. Absent, not greyed, when assistance is switched off: a row
         that can never do anything is worse than no row. -->
    <Border DockPanel.Dock="Top" Padding="8,2" Background="{StaticResource SurfacePanelBrush}"
            IsVisible="{Binding AiEnabled}"
            ToolTip.Tip="{Binding AiUnavailableHint}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <!-- Which model is answering. The bar used to say "Claude" in three
             places; now that the provider is the artist's choice, saying it
             once and truthfully beats saying it three times and wrongly. -->
        <TextBlock Text="{Binding AiProviderLabel}" VerticalAlignment="Center" Opacity="0.6" FontSize="12"
                   ToolTip.Tip="Change this in Edit ▸ Configure ▸ AI" />
        <Button Content="✦ AI Inbetween"
                Command="{Binding AiInbetweenCommand}"
                IsEnabled="{Binding CanUseAi}"
                ToolTip.Tip="Ask the model to draw the inbetweens between this key and the next" />
        <Button Content="✕" Command="{Binding CancelAiCommand}" IsVisible="{Binding AiBusy}"
                ToolTip.Tip="Cancel the AI request" />
        <ProgressBar IsIndeterminate="True" Width="90" IsVisible="{Binding AiBusy}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding AiStatus}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- Info strip: what the document is, and how much room the machine has left -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BackgroundSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="10,2">
      <DockPanel LastChildFill="False">
        <!-- One panel for the document facts, so all of them (and their dot
             separators) vanish together when nothing is open: these numbers
             would otherwise describe the internal placeholder document. -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsVisible="{Binding HasDocument}">
          <TextBlock Text="{Binding DocumentSizeLabel}" FontSize="11" Opacity="0.85"
                     VerticalAlignment="Center" ToolTip.Tip="Canvas size and resolution of the open document" />
          <TextBlock Text="·" FontSize="11" Opacity="0.4" Margin="8,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DocumentContentLabel}" FontSize="11" Opacity="0.85"
                     VerticalAlignment="Center" ToolTip.Tip="Layers and distinct drawings in this document" />
          <TextBlock Text="·" FontSize="11" Opacity="0.4" Margin="8,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding MemoryLabel}" FontSize="11" Opacity="0.6"
                     VerticalAlignment="Center" ToolTip.Tip="Image memory held for cached frames and the canvas buffers" />
        </StackPanel>

        <!-- Performance headroom, measured from real repaint times -->
        <TextBlock DockPanel.Dock="Right" Text="{Binding Performance.HealthLabel}" FontSize="11"
                   VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.85" />
        <ProgressBar DockPanel.Dock="Right" Width="90" Height="8" Minimum="0" Maximum="100"
                     Value="{Binding Performance.HeadroomPercent}" VerticalAlignment="Center"
                     Classes.strained="{Binding Performance.NeedsAttention}"
                     ToolTip.Tip="How much of a 60 fps frame is left after repainting the canvas" />
        <TextBlock DockPanel.Dock="Right" Text="Headroom" FontSize="11" Opacity="0.6" Margin="0,0,6,0"
                   VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Performance.Advice}" FontSize="11"
                   Foreground="#e0a030" VerticalAlignment="Center" Margin="0,0,14,0"
                   TextTrimming="CharacterEllipsis" MaxWidth="520"
                   IsVisible="{Binding Performance.NeedsAttention}" />
      </DockPanel>
    </Border>

    <!-- Open documents: click to switch, ✕ to close, • marks unsaved changes -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundSecondaryBrush}" Padding="4,2,4,0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentTab">
              <Border Classes="docTab" Classes.active="{Binding IsActive}" Padding="2,0">
                <Panel>
                  <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button Content="{Binding DisplayTitle}" Background="Transparent" BorderThickness="0" Padding="11,2"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActivateTabCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="icon" Content="✕" FontSize="10" Background="Transparent" BorderThickness="0"
                            Click="OnCloseTabClicked" ToolTip.Tip="Close document" />
                  </StackPanel>
                  <Border Classes="tabline" />
                </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!--
      Working area: canvas + sidebar share the top row (draggable splitter
      between them), the timeline owns the bottom row (draggable splitter
      above it). Grid rows/columns mean dockers can never overlap; min sizes
      are enforced from code-behind, and overflowing content scrolls inside
      its own docker.
    -->
    <!--
      The workspace: four dock strips around the canvas, and a pool the panels
      are parked in.

      The panels are declared once, here, and never rebuilt. Docking moves the
      same control instance from one strip to another, which is what lets a
      panel keep its scroll position, its bindings and a half-typed value
      across a drag. The layout only ever names panels; it never holds one.
      See src/Lightbox.App/Docking/DockLayout.cs.
    -->
    <Grid x:Name="RootGrid">
      <!-- Two rows only: the sides own their full height. The bottom strip
           lives INSIDE the centre column (see CentreColumn), so a docked
           sidebar runs from the top strip to the window's bottom edge and
           the timeline sits between the sidebars rather than under them —
           the owner's call, matching both references. -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="220" />
      </Grid.RowDefinitions>

      <ScrollViewer x:Name="TopHost" Grid.Row="0" Margin="4,4,4,0"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <controls:DockStrip x:Name="TopStrip" />
      </ScrollViewer>
      <GridSplitter x:Name="TopSplitter" Grid.Row="1" Height="5" ResizeDirection="Rows" />

      <Grid x:Name="WorkArea" Grid.Row="2">
        <Grid.ColumnDefinitions>
          <!-- 88: two centred 34px tool columns fit with the border and
               margins paid (Q56). 76 held exactly one. -->
          <ColumnDefinition Width="88" MinWidth="40" MaxWidth="220" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="240" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="300" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Toolbar" Grid.Column="0" Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Margin="4,4,0,4" ClipToBounds="True" SizeChanged="OnToolbarSizeChanged">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Columns are decided in ReflowToolRail (Q56): 1 when the
                 window is tall enough, 2 by default, 3 where width allows —
                 always centred in the rail. -->
            <WrapPanel x:Name="ToolButtons" Margin="3" HorizontalAlignment="Center">
              <ToggleButton Classes="tool" IsChecked="{Binding IsBrushTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Brush}"
                            ToolTip.Tip="Brush (B)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconBrush}" />
                  <TextBlock Text="Brush" Classes="toolname" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsEraserTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Eraser}"
                            ToolTip.Tip="Eraser (E)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconEraser}" />
                  <TextBlock Text="Eraser" Classes="toolname" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsFillTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Fill}"
                            ToolTip.Tip="Fill (F)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconFill}" />
                  <TextBlock Text="Fill" Classes="toolname" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsPickerTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Picker}"
                            ToolTip.Tip="Color picker (I on the canvas) — click to pick the color under the cursor">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconPicker}" />
                  <TextBlock Text="Picker" Classes="toolname" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsGradientTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Gradient}"
                            ToolTip.Tip="Gradient (G) — drag to set the ramp's direction and length">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconGradient}" />
                  <TextBlock Text="Gradient" Classes="toolname" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ShapeToolButton" Classes="tool" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsChecked="{Binding IsShapeTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Shape}"
                            ToolTip.Tip="Shape (U — hold for the list) — drag to draw. Shift squares it or snaps a line to 45°, Alt grows it from the centre.">
                <!-- The mark sits at the BUTTON's corner, so the panel stretches to the
                     content area and the glyph re-centres itself inside it. -->
                <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShapeGlyph}" FontSize="15" />
                    <TextBlock Text="Shape" Classes="toolname" VerticalAlignment="Center" />
                  </StackPanel>
                  <Path Classes="variantmark" />
                </Panel>
                <!-- The same hold-for-variants list the Select tool has. A
                     gesture that works on one tool and not its neighbour is
                     one nobody trusts. -->
                <ToggleButton.ContextFlyout>
                  <Flyout Placement="RightEdgeAlignedTop">
                    <StackPanel Spacing="2">
                      <Button Content="╱ Line" Command="{Binding SelectShapeCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static geo:ShapeKind.Line}" HorizontalAlignment="Stretch" />
                      <Button Content="▭ Rectangle" Command="{Binding SelectShapeCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static geo:ShapeKind.Rectangle}" HorizontalAlignment="Stretch" />
                      <Button Content="◯ Ellipse" Command="{Binding SelectShapeCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static geo:ShapeKind.Ellipse}" HorizontalAlignment="Stretch" />
                      <Button Content="⬠ Polygon" Command="{Binding SelectShapeCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static geo:ShapeKind.Polygon}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Flyout>
                </ToggleButton.ContextFlyout>
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsMoveTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Move}"
                            ToolTip.Tip="Move (V) — drag the drawing. Ctrl moves every drawing on the layer, Shift holds it to one axis. Guides are picked up with this tool.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconMove}" />
                  <TextBlock Text="Move" Classes="toolname" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsArrowTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Arrow}"
                            ToolTip.Tip="Arrow (A) — click to select a whole line, a guide, a placed symbol or a rig anchor. Shift adds. Selects things, not areas of pixels.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="➤" FontSize="15" />
                  <TextBlock Text="Arrow" Classes="toolname" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="SelectToolButton" Classes="tool" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsChecked="{Binding IsSelectTool, Mode=OneWay}"
                            Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:ToolId.Select}"
                            ToolTip.Tip="Select (S — press again to switch variant; hold for the list)">
                <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectVariantGlyph}" FontSize="15" />
                    <TextBlock Text="Select" Classes="toolname" VerticalAlignment="Center" />
                  </StackPanel>
                  <Path Classes="variantmark" />
                </Panel>
                <ToggleButton.ContextFlyout>
                  <Flyout Placement="RightEdgeAlignedTop">
                    <StackPanel Spacing="2">
                      <Button Content="◌ Freehand" Command="{Binding SelectVariantOfCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static vm:SelectVariant.Freehand}" HorizontalAlignment="Stretch" />
                      <Button Content="⬠ Polygon" Command="{Binding SelectVariantOfCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static vm:SelectVariant.Polygon}" HorizontalAlignment="Stretch" />
                      <Button Content="▭ Box" Command="{Binding SelectVariantOfCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static vm:SelectVariant.Box}" HorizontalAlignment="Stretch" />
                      <Button Content="◯ Circle" Command="{Binding SelectVariantOfCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static vm:SelectVariant.Ellipse}" HorizontalAlignment="Stretch" />
                      <Button Content="🪄 Magic wand" Command="{Binding SelectVariantOfCommand}" Click="OnVariantChosen"
                              CommandParameter="{x:Static vm:SelectVariant.Wand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Flyout>
                </ToggleButton.ContextFlyout>
              </ToggleButton>
            </WrapPanel>
          </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />

        <!-- No ScrollViewer: a sidebar never scrolls. Its dockers share the
             height proportionally and their content scrolls inside them. -->
        <Border x:Name="LeftHost" Grid.Column="2" Margin="4,0,0,0">
          <controls:DockStrip x:Name="LeftStrip" />
        </Border>
        <GridSplitter x:Name="LeftSplitter" Grid.Column="3" Width="5" ResizeDirection="Columns" />

        <!-- Column 4, the starred one. It was left on 2 when the docking
             rework renumbered these columns, which put the canvas in the left
             strip's cell: an Auto column, empty by default, so it sized itself
             to the zoom bar and the canvas got no width at all. A zero-width
             canvas draws nothing and takes no pointer events, which reads
             exactly like a broken renderer. -->
        <Grid x:Name="CentreColumn" Grid.Column="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" MinHeight="140" />
          </Grid.RowDefinitions>

        <Panel x:Name="CanvasHost" Grid.Row="0">
          <render:CanvasControl x:Name="Canvas" BrushCursorSize="{Binding BrushCursorDiameter}" LazyRadius="{Binding LazyRadiusForCursor}"
                                BrushCursorTipId="{Binding BrushCursorTipId}"
                                BrushCursorRoundness="{Binding BrushCursorRoundness}"
                                BrushCursorAngle="{Binding BrushCursorAngle}" />
          <!--
            Rulers, on top of the canvas rather than beside it, so turning them
            on cannot renumber the grid columns the docking rework already got
            wrong once. The canvas is inset by their thickness instead (see
            ApplyRulers), which is what makes a strip's own coordinates line up
            with the canvas's along its axis.
          -->
          <controls:RulerStrip x:Name="TopRuler" Orientation="Horizontal" Height="18"
                               VerticalAlignment="Top" HorizontalAlignment="Stretch"
                               Margin="18,0,0,0"
                               IsVisible="{Binding Workspace.RulersVisible}" />
          <controls:RulerStrip x:Name="LeftRuler" Orientation="Vertical" Width="18"
                               HorizontalAlignment="Left" VerticalAlignment="Stretch"
                               Margin="0,18,0,0"
                               IsVisible="{Binding Workspace.RulersVisible}" />
          <Border x:Name="RulerCorner" Width="18" Height="18" Background="{StaticResource BackgroundSecondaryBrush}"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  IsVisible="{Binding Workspace.RulersVisible}" />
          <!--
            Overlay bars. Their edge, position, collapsed and visible state
            live in the workspace; the window only reads that and places them
            (see ApplyOverlayLayout). Each stacks along whichever edge it is
            on, so its icons stay upright — see CanvasOverlayBar.
          -->
          <controls:CanvasOverlayBar x:Name="ViewBar" OverlayId="View" Title="View">
            <StackPanel Spacing="2"
                        Orientation="{Binding IsVertical, RelativeSource={RelativeSource AncestorType=controls:CanvasOverlayBar}, Converter={x:Static docking:OverlayConverters.VerticalToOrientation}}">
              <Button Content="−" Click="OnZoomOut" ToolTip.Tip="Zoom out (mouse wheel)" />
              <!--
                The one wide readout. It turns to fit a narrow bar, with its
                feet towards the canvas, because that is the side you are
                reading it from.

                Its slot is longer than a tile along whichever way the bar runs,
                and it has to be: the rotation is a RenderTransform, which
                happens after layout, so with the tile's 26 px square the text
                was measured and clipped to two characters and only then turned.
                "100%" was unreadable and rotating it changed nothing. The
                length goes on the button and the natural width goes on the
                TextBlock inside, which overhangs the narrow direction — allowed,
                because overlay tiles already turn clipping off for glyphs.
              -->
              <Button x:Name="ZoomLabel" Click="OnResetView"
                      Width="{Binding IsVertical, RelativeSource={RelativeSource AncestorType=controls:CanvasOverlayBar}, Converter={x:Static docking:OverlayConverters.ReadoutWidth}}"
                      Height="{Binding IsVertical, RelativeSource={RelativeSource AncestorType=controls:CanvasOverlayBar}, Converter={x:Static docking:OverlayConverters.ReadoutHeight}}"
                      ToolTip.Tip="Current zoom — click to reset the whole view">
                <TextBlock x:Name="ZoomLabelText" Text="100%" Width="42" FontSize="11"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="{Binding ReadoutAngle, RelativeSource={RelativeSource AncestorType=controls:CanvasOverlayBar}}" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Button>
              <Button Content="＋" Click="OnZoomIn" ToolTip.Tip="Zoom in (mouse wheel)" />
              <Button Content="↺" Click="OnRotateCcw" ToolTip.Tip="Rotate view 15° counter-clockwise (Shift+wheel)" />
              <Button Content="↻" Click="OnRotateCw" ToolTip.Tip="Rotate view 15° clockwise (Shift+wheel)" />
              <Button x:Name="MirrorButton" Content="⇋" Click="OnToggleMirror"
                      ToolTip.Tip="Mirror the view horizontally (M) — a drawing aid, the artwork is untouched" />
              <Button Content="⌂" Click="OnResetView" ToolTip.Tip="Reset zoom, rotation, mirror and pan (0)" />
            </StackPanel>
          </controls:CanvasOverlayBar>

          <!--
            Shortcuts: what you are looking at, rather than how. Each entry is
            absent when it would mean nothing — no camera button without a
            camera, no transport on a document nobody is going to play.
          -->
          <!--
            No Padding on these, deliberately. The tile size is decided in one
            place — Density.axaml's overlay-bar rule, which sets a 26 px square
            and zero padding *because* a 16 px glyph with an ascender does not
            fit anything smaller once the border and line box are paid for.
            Every button in here used to add Padding="6,2" back inline, which
            beats a style, and 12 px of horizontal padding off a 26 px tile
            leaves 14 px for the glyph: the geometric ones fitted and the wide
            emoji (🎥, 🔒) were cut off. The bug was one local override against
            the single place that decides, which is the same shape as a shortcut
            wired past ShortcutMap.
          -->
          <controls:CanvasOverlayBar x:Name="ShortcutBar" OverlayId="Shortcuts" Title="Shortcuts">
            <StackPanel Spacing="2"
                        Orientation="{Binding IsVertical, RelativeSource={RelativeSource AncestorType=controls:CanvasOverlayBar}, Converter={x:Static docking:OverlayConverters.VerticalToOrientation}}">
              <ToggleButton Classes="onion" IsChecked="{Binding ActiveLayerOnion}"
                            ToolTip.Tip="Onion skin on the active layer" ><Path /></ToggleButton>
              <ToggleButton Content="🎥" IsChecked="{Binding ViewThroughCamera}"
                            IsVisible="{Binding HasCamera}"
                            ToolTip.Tip="View through the camera" />
              <Button Content="{Binding PlayPauseGlyph}"
                      Command="{Binding TogglePlaybackCommand}"
                      IsVisible="{Binding ShowsTransport}"
                      ToolTip.Tip="Play / pause (Space)" />
              <!--
                Absent unless there is a reference to edit. A document with no
                sheet imported has nothing for this to switch on, and a toggle
                that cannot change anything is worse than no toggle.
              -->
              <!-- Absent unless a guide has been placed: nothing to snap to
                   means nothing to switch. -->
              <ToggleButton Content="⌗" IsChecked="{Binding SnapToGuides}"
                            IsVisible="{Binding HasGuides}"
                            ToolTip.Tip="Snap to guides" />
              <!--
                Guide visibility and locking, next to the rulers that make
                them. Only while the rulers are up: they are the switch that
                says you are arranging the rig rather than drawing over it,
                and off the rig cannot move, so two buttons about moving it
                would be two dead buttons.
              -->
              <ToggleButton Content="⌐" IsChecked="{Binding Workspace.GuidesVisible}"
                            IsVisible="{Binding Workspace.RulersVisible}"
                            ToolTip.Tip="Show guides (Ctrl+;) — hidden ones still snap" />
              <ToggleButton Content="🔒" IsChecked="{Binding Workspace.GuidesLocked}"
                            IsVisible="{Binding Workspace.RulersVisible}"
                            ToolTip.Tip="Lock guides (Ctrl+Alt+;) — pin them where they are" />
              <ToggleButton Content="⊞" IsChecked="{Binding ReferenceGridEditMode}"
                            IsVisible="{Binding HasReferences}"
                            ToolTip.Tip="Edit the reference grid — drag the boxes, drag a corner to resize, right-click for the pivot. Esc leaves." />
            </StackPanel>
          </controls:CanvasOverlayBar>

        </Panel>

        <GridSplitter x:Name="BottomSplitter" Grid.Row="1" Height="5" ResizeDirection="Rows" />
        <!-- No ScrollViewer: the strip fits, and each panel's bars run
             their overflow against the real width. -->
        <Border x:Name="BottomHost" Grid.Row="2" Margin="4,0,0,4">
          <controls:DockStrip x:Name="BottomStrip" />
        </Border>
        </Grid>

        <GridSplitter x:Name="RightSplitter" Grid.Column="5" Width="5" ResizeDirection="Columns" />
        <Border x:Name="RightHost" Grid.Column="6" Margin="0,0,4,0">
          <controls:DockStrip x:Name="RightStrip" />
        </Border>
      </Grid>

      <!--
        Nothing open. Last child of the whole workspace and spanning every row,
        so it covers the dockers and the timeline as well as the canvas. It
        started out covering only the canvas, and a screenshot of that build
        showed why that is not enough: the Layers docker listed the placeholder
        document's Paint and Background layers and the timeline showed its rows —
        the one document that must never be visible, on screen twice. Covering
        the surfaces beats teaching every docker to ask HasDocument, and it is
        also what the panels' own bindings need: they stay pointed at the
        placeholder, which is fine exactly as long as nobody can see them.

        A real surface with the ways out on it rather than a grey rectangle:
        the New dialog is prompted on the way in and when the last tab closes,
        and if it is dismissed there has to be somewhere to say so again.
      -->
      <Border x:Name="NothingOpen" Grid.Row="0" Grid.RowSpan="5"
              IsVisible="{Binding !HasDocument}"
              Background="{StaticResource BackgroundPrimaryBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="Nothing open" FontSize="18" HorizontalAlignment="Center"
                     Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="Make a document or a project, or open something you already have."
                     FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                     TextAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button x:Name="NothingOpenNew" Content="New…" Click="OnNewClicked"
                    ToolTip.Tip="A new document (Ctrl+N)" />
            <Button x:Name="NothingOpenNewProject" Content="New project…" Click="OnNewProjectClicked" />
            <Button x:Name="NothingOpenOpen" Content="Open…" Click="OnOpenClicked"
                    ToolTip.Tip="Open a document from disk (Ctrl+O)" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Where panels wait when they are not in a strip: closed, or in flight
           during a drag. Never shown. -->
      <Panel x:Name="PanelPool" IsVisible="False">
        <!-- Tool options: the gear flyout grown into a panel, per the owner.
             Same pages, same code-behind category switch; only the host
             changed. -->
        <controls:Docker x:Name="ToolOptionsDocker" PanelId="ToolOptions" Title="Tool options"
                         CloseCommand="{Binding ToggleToolOptionsDockerCommand}">
                <Grid ColumnDefinitions="110,6,*">
                  <ListBox x:Name="BrushCategoryList" Grid.Column="0" SelectedIndex="0"
                           SelectionChanged="OnBrushCategoryChanged" Background="{StaticResource BackgroundSecondaryBrush}">
                    <ListBoxItem Content="General" />
                    <ListBoxItem Content="Effects" />
                    <ListBoxItem Content="Medium" />
                    <ListBoxItem Content="Pen pressure" />
                    <ListBoxItem Content="Presets" />
                  </ListBox>
                  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <Panel>

                      <StackPanel x:Name="BrushPageGeneral" Spacing="6">
                        <TextBlock Text="General" FontWeight="SemiBold" FontSize="12" />
                        <CheckBox Content="Anti-aliasing (global)" IsChecked="{Binding AntiAliasing}"
                                  ToolTip.Tip="Smooth edges on everything that paints (brush, eraser, fill). Recorded per stroke, so existing art never changes." />
                        <DockPanel>
                          <TextBlock Text="Opacity" Width="90" VerticalAlignment="Center" FontSize="12" />
                          <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushOpacity}" Minimum="0.01" Maximum="1"
                                         Increment="0.05" FormatString="0.00" MinWidth="44" />
                          <Slider Value="{Binding BrushOpacity}" Minimum="0.01" Maximum="1" Margin="4,0" />
                        </DockPanel>
                        <DockPanel>
                          <TextBlock Text="Flow" Width="90" VerticalAlignment="Center" FontSize="12" />
                          <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushFlow}" Minimum="0.01" Maximum="1"
                                         Increment="0.05" FormatString="0.00" MinWidth="44" />
                          <Slider Value="{Binding BrushFlow}" Minimum="0.01" Maximum="1" Margin="4,0" />
                        </DockPanel>
                        <DockPanel>
                          <TextBlock Text="Spacing" Width="90" VerticalAlignment="Center" FontSize="12" />
                          <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushSpacing}" Minimum="0.02" Maximum="2"
                                         Increment="0.02" FormatString="0.00" MinWidth="44" />
                          <Slider Value="{Binding BrushSpacing}" Minimum="0.02" Maximum="2" Margin="4,0" />
                        </DockPanel>

                        <DockPanel ToolTip.Tip="How the finished stroke lands on the layer. Applied once, where the stroke meets the layer — so a Multiply brush does not go black where it crosses itself.">
                          <TextBlock Text="Blend" Width="90" VerticalAlignment="Center" FontSize="12" />
                          <ComboBox ItemsSource="{Binding BlendModeChoices}" SelectedItem="{Binding BrushBlend}"
                                    HorizontalAlignment="Stretch" Margin="4,0,0,0" />
                        </DockPanel>

                        <!--
                          The tip, as a picture. A dropdown of names is unusable
                          for shapes: nobody knows what "Cut nib" looks like until
                          they have seen it, and having seen it they recognise the
                          thumbnail and never read the name again.
                        -->
                        <DockPanel Margin="0,4,0,0">
                          <TextBlock Text="Tip" Width="90" VerticalAlignment="Center" FontSize="12" />
                          <Button x:Name="TipPickerButton" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                  Padding="4" Click="OnTipPickerOpen"
                                  ToolTip.Tip="The shape each dab stamps. Painting with one copies it into the drawing.">
                            <DockPanel>
                              <Border DockPanel.Dock="Left" Width="26" Height="26" Background="{StaticResource SurfacePanelBrush}"
                                      CornerRadius="3" Margin="0,0,8,0">
                                <Image x:Name="TipPickerThumb" Stretch="Uniform" Margin="1" />
                              </Border>
                              <TextBlock x:Name="TipPickerName" Text="Round" VerticalAlignment="Center" FontSize="12" />
                            </DockPanel>
                            <Button.Flyout>
                              <Flyout Placement="Bottom">
                                <DockPanel Width="300" MaxHeight="420">
                                  <Button DockPanel.Dock="Bottom" Content="Brush tips…" Click="OnBrushTipsClicked"
                                          HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                          ToolTip.Tip="Make a tip, or bring one in from a scan" />
                                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ListBox x:Name="TipPickerList" Background="Transparent"
                                             SelectionChanged="OnTipPicked">
                                      <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <!-- Two columns, so a tip is a picture rather than a row of text -->
                                          <WrapPanel Orientation="Horizontal" ItemWidth="134" />
                                        </ItemsPanelTemplate>
                                      </ListBox.ItemsPanel>
                                      <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="views:TipChoice">
                                          <StackPanel Margin="0,2" Spacing="2">
                                            <Border Height="60" Background="{StaticResource SurfacePanelBrush}" CornerRadius="3">
                                              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                          </StackPanel>
                                        </DataTemplate>
                                      </ListBox.ItemTemplate>
                                    </ListBox>
                                  </ScrollViewer>
                                </DockPanel>
                              </Flyout>
                            </Button.Flyout>
                          </Button>
                        </DockPanel>
                      </StackPanel>

                      <StackPanel x:Name="BrushPageEffects" Spacing="6" IsVisible="False">
                        <TextBlock Text="Effects" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel Spacing="6" IsVisible="{Binding IsSmudgeBrush}" Margin="0,0,0,8">
                          <TextBlock Text="Smudge" FontWeight="SemiBold" FontSize="11" Opacity="0.8" />
                          <ComboBox ItemsSource="{Binding SmudgeModeChoices}" SelectedItem="{Binding BrushSmudgeMode}"
                                    HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Smearing drags a sample along the stroke, so detail streaks. Dulling lays down the colour under the dab, so detail dissolves — that is a blender." />
                          <DockPanel ToolTip.Tip="How far colour travels before the sample refreshes.">
                            <TextBlock Text="Length" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushSmudgeLength}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushSmudgeLength}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="How wide an area each dab samples. Wider blends more and keeps less detail.">
                            <TextBlock Text="Radius" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushSmudgeRadius}" Minimum="0.05" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushSmudgeRadius}" Minimum="0.05" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="How much of the brush's own colour it adds while smudging. Zero is a pure blender.">
                            <TextBlock Text="Color rate" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushColorRate}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushColorRate}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                        </StackPanel>
                        <TextBlock Text="Shape Dynamics" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,8,0,0" />
                          <DockPanel ToolTip.Tip="How much dab diameter varies. This is the biggest single difference between a digital mark and a natural one.">
                            <TextBlock Text="Size jitter" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushSizeJitter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushSizeJitter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="Floor for jittered size. Without it, jitter produces dabs that vanish and the stroke reads as broken rather than varied.">
                            <TextBlock Text="Minimum size" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushMinimumDiameter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushMinimumDiameter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="1 is circular; lower squashes the dab into a chisel.">
                            <TextBlock Text="Roundness" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushRoundness}" Minimum="0.05" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushRoundness}" Minimum="0.05" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Roundness jitter" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushRoundnessJitter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushRoundnessJitter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Angle jitter" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushRotationJitter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushRotationJitter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                        <CheckBox Content="Angle follows stroke direction" FontSize="12"
                                  IsChecked="{Binding BrushAngleFollowsDirection}"
                                  ToolTip.Tip="Required for any flat or chisel tip to behave like one instead of a repeated stamp." />

                        <TextBlock Text="Scattering" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,8,0,0" />
                          <DockPanel>
                            <TextBlock Text="Scatter" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushScatter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushScatter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>

                        <TextBlock Text="Texture" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,8,0,0" />
                        <DockPanel ToolTip.Tip="Paper surface multiplied into the stroke. Anchored to the document, so the grain stays put as you paint over it.">
                          <TextBlock Text="Surface" Width="100" VerticalAlignment="Center" FontSize="12" />
                          <ComboBox ItemsSource="{Binding TextureSurfaceChoices}" SelectedItem="{Binding BrushTextureSurface}"
                                    HorizontalAlignment="Stretch" IsEnabled="{Binding !HasImportedTexture}" />
                        </DockPanel>
                        <!--
                          An imported paper wins over the built-in surfaces, so
                          the dropdown above goes quiet rather than pretending to
                          still be in charge. The image goes into the document,
                          not a path on disk — a file pointing at somebody's
                          scans folder paints differently on the next machine.
                        -->
                        <DockPanel ToolTip.Tip="Use a scan or photograph of real paper. It goes into the drawing, so the file still paints the right grain anywhere.">
                          <Button DockPanel.Dock="Right" x:Name="ClearTextureButton" Content="✕"
                                  Click="OnClearTextureClicked" Margin="6,0,0,0"
                                  ToolTip.Tip="Back to the built-in surfaces" />
                          <Button Content="Paper image…" Click="OnImportTextureClicked"
                                  HorizontalAlignment="Stretch" />
                        </DockPanel>
                        <TextBlock x:Name="TextureSourceNote" FontSize="10" Opacity="0.6"
                                   IsVisible="False" TextWrapping="Wrap" />
                          <DockPanel>
                            <TextBlock Text="Grain size" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushTextureScale}" Minimum="1" Maximum="128"
                                           Increment="1" FormatString="0" MinWidth="44" />
                            <Slider Value="{Binding BrushTextureScale}" Minimum="1" Maximum="128" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Depth" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushTextureDepth}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushTextureDepth}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="The flat grain used when no texture surface is chosen.">
                            <TextBlock Text="Granulation" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushGranulation}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushGranulation}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Wet edge" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushWetEdge}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushWetEdge}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>

                        <TextBlock Text="Transfer" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,8,0,0" />
                          <DockPanel ToolTip.Tip="Per-dab paint amount varies, giving wash and build-up variation that pressure alone cannot.">
                            <TextBlock Text="Flow jitter" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushFlowJitter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushFlowJitter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>

                        <TextBlock Text="Color Dynamics" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,8,0,0" />
                        <DockPanel ToolTip.Tip="Natural media drifts between two chosen colours rather than randomly around one. Leave empty to vary only hue, saturation and brightness.">
                          <TextBlock Text="Second color" Width="100" VerticalAlignment="Center" FontSize="12" />
                          <controls:ColorField Hex="{Binding BrushSecondaryColor, Mode=TwoWay}"
                                               AllowsNone="True" HorizontalAlignment="Left" />
                        </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Toward second" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushColorJitter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushColorJitter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Hue jitter" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushHueJitter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushHueJitter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Saturation jitter" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushSaturationJitter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushSaturationJitter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Brightness jitter" Width="100" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding BrushBrightnessJitter}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding BrushBrightnessJitter}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>

                        </StackPanel>

                      <StackPanel x:Name="BrushPageMedium" Spacing="6" IsVisible="False">
                        <TextBlock Text="Medium" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                   Text="Simulates how real paint moves, settles and layers. Runs when the stroke is committed, over the region the stroke touched." />
                        <ComboBox ItemsSource="{Binding MediumKindChoices}" SelectedItem="{Binding BrushMedium}"
                                  HorizontalAlignment="Stretch" Margin="0,2,0,6" />

                        <StackPanel Spacing="6" IsVisible="{Binding MediumIsSimulated}">
                          <TextBlock Text="Fluid" FontWeight="SemiBold" FontSize="11" Opacity="0.8" />
                          <DockPanel>
                            <TextBlock Text="Wetness" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumWetness}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumWetness}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Viscosity" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumViscosity}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumViscosity}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Drag" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumDrag}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumDrag}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Absorbency" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumAbsorbency}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumAbsorbency}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="Capillary pull toward the wet boundary — this is what darkens the rim.">
                            <TextBlock Text="Edge pull" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumEdgePull}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumEdgePull}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="Simulation iterations. Cost is linear in this — the one control here that can make a stroke commit feel slow.">
                            <TextBlock Text="Flow steps" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumFlowSteps}" Minimum="0" Maximum="32"
                                           Increment="1" FormatString="0" MinWidth="44" />
                            <Slider Value="{Binding MediumFlowSteps}" Minimum="0" Maximum="32" Margin="4,0" />
                          </DockPanel>

                          <TextBlock Text="Pigment" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,6,0,0" />
                          <DockPanel>
                            <TextBlock Text="Density" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumPigmentDensity}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumPigmentDensity}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="How readily pigment settles into the paper's valleys.">
                            <TextBlock Text="Granularity" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumGranularity}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumGranularity}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="0 is a transparent glaze, 1 fully hides what is underneath.">
                            <TextBlock Text="Hiding" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumHiding}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumHiding}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <CheckBox Content="Mix pigment physically (Kubelka–Munk)" FontSize="12"
                                    IsChecked="{Binding MediumPhysicalMixing}"
                                    ToolTip.Tip="Layer paint the way pigment layers, not the way film layers. A yellow glaze over blue gives green." />

                          <TextBlock Text="Paper" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,6,0,0" />
                          <DockPanel>
                            <TextBlock Text="Surface" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <ComboBox ItemsSource="{Binding PaperKindChoices}" SelectedItem="{Binding MediumPaper}"
                                      HorizontalAlignment="Stretch" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Grain size" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumPaperScale}" Minimum="1" Maximum="128"
                                           Increment="1" FormatString="0" MinWidth="44" />
                            <Slider Value="{Binding MediumPaperScale}" Minimum="1" Maximum="128" Margin="4,0" />
                          </DockPanel>
                          <DockPanel>
                            <TextBlock Text="Influence" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumPaperInfluence}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumPaperInfluence}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>

                          <TextBlock Text="Interaction" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,6,0,0" />
                          <DockPanel ToolTip.Tip="How much a light touch means water rather than pigment. Raise it and light strokes go paler and bloom further.">
                            <TextBlock Text="Light = water" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumPressureWater}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumPressureWater}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="How much pressure governs mixing with the paint already there. At 1 a light touch barely disturbs it.">
                            <TextBlock Text="Pressure mix" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumPressureMix}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumPressureMix}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>
                          <DockPanel ToolTip.Tip="How much this stroke re-wets what is under it. Above zero, earlier paint lifts and travels with the new stroke — wet into wet.">
                            <TextBlock Text="Re-wetting" Width="90" VerticalAlignment="Center" FontSize="12" />
                            <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumRewetting}" Minimum="0" Maximum="1"
                                           Increment="0.05" FormatString="0.00" MinWidth="44" />
                            <Slider Value="{Binding MediumRewetting}" Minimum="0" Maximum="1" Margin="4,0" />
                          </DockPanel>

                          <StackPanel Spacing="6" IsVisible="{Binding MediumHasBody}">
                            <TextBlock Text="Body" FontWeight="SemiBold" FontSize="11" Opacity="0.8" Margin="0,6,0,0" />
                            <DockPanel>
                              <TextBlock Text="Thickness" Width="90" VerticalAlignment="Center" FontSize="12" />
                              <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumBody}" Minimum="0" Maximum="1"
                                             Increment="0.05" FormatString="0.00" MinWidth="44" />
                              <Slider Value="{Binding MediumBody}" Minimum="0" Maximum="1" Margin="4,0" />
                            </DockPanel>
                            <DockPanel ToolTip.Tip="Shades the paint's own height, giving impasto relief.">
                              <TextBlock Text="Relief" Width="90" VerticalAlignment="Center" FontSize="12" />
                              <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumRelief}" Minimum="0" Maximum="1"
                                             Increment="0.05" FormatString="0.00" MinWidth="44" />
                              <Slider Value="{Binding MediumRelief}" Minimum="0" Maximum="1" Margin="4,0" />
                            </DockPanel>
                            <!--
                              Bristle drag and Pickup are deliberately NOT here.

                              Both are the directional advection loop in
                              DESIGN-fluid-media.md piece (3), which is sequenced
                              last and behind two open questions — so the engine
                              reads neither, and a slider bound to one was a
                              control that did nothing. Measured at the time as
                              **0 of 41 600 pixels different** between all-zero
                              and all-one. Charter O7: a setting that does nothing
                              is worse than an absent one, because it teaches an
                              artist that the panel lies.

                              The *look* of a dragged bristle is already reachable
                              by a different route — `TipShape.Bristle` with
                              `AngleFollowsDirection` — which is why only Pickup
                              really needs the loop. B23.
                            -->
                            <DockPanel ToolTip.Tip="Paint on the brush at the start. Below 1 the brush runs out — that is dry-brush.">
                              <TextBlock Text="Paint load" Width="90" VerticalAlignment="Center" FontSize="12" />
                              <NumericUpDown DockPanel.Dock="Right" Value="{Binding MediumPaintLoad}" Minimum="0" Maximum="1"
                                             Increment="0.05" FormatString="0.00" MinWidth="44" />
                              <Slider Value="{Binding MediumPaintLoad}" Minimum="0" Maximum="1" Margin="4,0" />
                            </DockPanel>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel x:Name="BrushPagePressure" Spacing="6" IsVisible="False">
                        <CheckBox Content="Brush ring follows pen pressure" FontSize="12"
                                  IsChecked="{Binding CursorTracksPressure}"
                                  ToolTip.Tip="On, the ring shows the thickness the stroke is laying down right now. Off, it stays at the brush's full size as a stable target. Hovering always shows the maximum." />
                        <TextBlock Text="Pen pressure" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding PenDiagnostic}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="Live report of what Windows delivers while you draw" />
                        <TextBlock Text="Seeing Mouse instead of Pen? Enable “Windows Ink” in your Huion/Wacom driver settings, then restart Lightbox."
                                   FontSize="10" Opacity="0.65" TextWrapping="Wrap" />
                        <CheckBox Content="Use pen pressure" IsChecked="{Binding BrushPressureEnabled}"
                                  ToolTip.Tip="Master switch for this brush — off ignores the tablet's pressure entirely" />
                        <!--
                          A curve per dynamic rather than an exponent. Deciding
                          how a brush answers the pen is a shape judgement — where
                          it should bite, where it level off — and one number
                          cannot say most of what an artist means. It also cannot
                          say anything that rises and then falls, which is what an
                          ink brush that spreads and then floods actually does.

                          Rows are built in code rather than repeated seven times
                          here: they differ only by which dynamic they drive.
                        -->
                        <TextBlock Text="Drag a point to shape the response. Click for a new one, middle-click to remove."
                                   FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
                        <StackPanel x:Name="PressureCurveRows" Spacing="10"
                                    IsEnabled="{Binding BrushPressureEnabled}" />
                      </StackPanel>

                      <StackPanel x:Name="BrushPagePresets" Spacing="6" IsVisible="False">
                        <TextBlock Text="Presets" FontWeight="SemiBold" FontSize="12" />

                        <Border x:Name="PresetModifiedNote" Background="{StaticResource StatusWarningSurfaceBrush}" CornerRadius="4"
                                Padding="8,6" IsVisible="False">
                          <TextBlock x:Name="PresetModifiedText" TextWrapping="Wrap" FontSize="11" />
                        </Border>

                        <DockPanel>
                          <Button x:Name="UpdatePresetButton" DockPanel.Dock="Right" Content="Update"
                                  Click="OnUpdatePresetClicked" Margin="6,0,0,0"
                                  ToolTip.Tip="Write these settings back over the brush you started from" />
                          <Button x:Name="RevertPresetButton" DockPanel.Dock="Right" Content="Revert"
                                  Click="OnRevertPresetClicked"
                                  ToolTip.Tip="Throw away your changes to this shipped brush and get the original back" />
                          <TextBlock x:Name="PresetCurrentName" VerticalAlignment="Center" FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="Save as new" Click="OnSavePresetClicked" />
                          <TextBox x:Name="PresetNameBox" PlaceholderText="New preset name" Margin="0,0,6,0" />
                        </DockPanel>

                        <DockPanel ToolTip.Tip="Comma-separated. Whatever you would look for it under — inking, roughs, hair.">
                          <Button x:Name="ApplyTagsButton" DockPanel.Dock="Right" Content="Tag"
                                  Click="OnApplyTagsClicked" />
                          <TextBox x:Name="PresetTagBox" PlaceholderText="Tags, comma separated" Margin="0,0,6,0" />
                        </DockPanel>

                        <Button x:Name="DeletePresetButton" Content="Delete this brush" Click="OnDeletePresetClicked"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Removes a brush you made. A shipped brush is reverted instead — it is not yours to delete." />
                        <!--
                          Import moved into the library window rather than staying
                          here. This page edits the brush in your hand; importing
                          forty of somebody else's is the other kind of job, it
                          needs a progress bar and somewhere to put the result,
                          and it used to leave you with forty brushes and no way
                          to remove them.
                        -->
                        <Button Content="Brush library…" Click="OnBrushLibraryClicked"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="Everything you have: import Photoshop, GIMP and Krita brushes, rename them, and remove the ones you do not want" />
                      </StackPanel>

                    </Panel>
                  </ScrollViewer>
                </Grid>
        </controls:Docker>

        <!-- Project: characters and the animations under them. Absent unless a
             project exists — the app is document-first, and a session that
             never creates one shows no project UI at all. The workspace keeps
             its slot; ApplyDockLayout leaves it out until there is a project. -->
        <controls:Docker x:Name="ProjectPanel" PanelId="Project"
                         Title="{Binding ProjectDocker.ProjectName}"
                         CloseCommand="{Binding ToggleProjectPanelCommand}">
              <controls:Docker.TopBar>
                <Border Classes="dockerBar">
                  <!--
                    One ＋, with a menu of what to make. New work inside a
                    project should not be "create it, then file it" — each
                    entry lands somewhere specific, under the selected
                    character or on the project itself.
                  -->
                  <DockPanel>
                    <!-- B62. Reveals what is *selected*, which is the useful
                         half and was buried in the right-click menu while this
                         button opened the project folder whatever you had
                         picked. The old behaviour is not lost: the project is
                         the first row, so selecting it and pressing this does
                         exactly what the button used to do — and with nothing
                         selected at all, PathOf falls back to the root. -->
                    <Button Classes="icon" DockPanel.Dock="Right" Content="🗁"
                            Command="{Binding ProjectDocker.RevealSelectedCommand}"
                            ToolTip.Tip="Show the selected item in the file manager" />
                    <!-- B61. The folder is watched, so this is rarely needed —
                         and it is the only way back when the watch could not be
                         armed, which ProjectWatcher allows on purpose so a
                         project on a network share still opens. -->
                    <Button Classes="icon" DockPanel.Dock="Right" Content="⟳"
                            Command="{Binding ProjectDocker.RefreshFromDiskCommand}"
                            ToolTip.Tip="Re-read the project from disk (F5)" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Classes="text" Content="＋ New ▾" ToolTip.Tip="Create something in this project">
                        <Button.Flyout>
                          <!-- Written out rather than generated from
                               NewItemKinds, and Click rather than Command: a
                               flyout's items live in a popup, so a
                               `$parent[Window]` binding has no window to find
                               and every entry is silently dead. -->
                          <MenuFlyout>
                            <!--
                              B63. Grouped: things work goes *inside* first, then
                              the drawings themselves, with the same glyphs the
                              rows use so the menu predicts the tree. The report
                              was that the list "does not distinguish a folder
                              from a work file", and an undifferentiated pile of
                              six words is exactly that.

                              The order and the glyphs both come from
                              ProjectViewModel.NewItemKinds, which is what
                              ProjectCreateMenuTests reads — this flyout is
                              written out (a popup has no window to bind to), so
                              the test is the only thing keeping the two in step.
                            -->
                            <MenuItem Header="🗀  Folder" Click="OnProjectNewFolder"
                                      ToolTip.Tip="A folder you name, inside the selected one" />
                            <Separator />
                            <MenuItem Header="▣  Document" Click="OnProjectNewDocument"
                                      ToolTip.Tip="A drawing, in the selected folder" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button Classes="icon" Content="－"
                              Command="{Binding ProjectDocker.RemoveSelectedCommand}"
                              IsEnabled="{Binding ProjectDocker.HasSelection}"
                              ToolTip.Tip="Remove from the project (the file stays on disk)" />
                      <!--
                        B114. Absent until there is a tree to arrange, rather
                        than until there are scenes: any folder carries a running
                        order now, so hiding these until something is ordered
                        would hide the only way to start ordering it.
                      -->
                      <Button Classes="icon" Content="↑" IsVisible="{Binding ProjectDocker.CanReorder}"
                              Command="{Binding ProjectDocker.MoveSelectedUpCommand}"
                              ToolTip.Tip="Earlier in the running order" />
                      <Button Classes="icon" Content="↓" IsVisible="{Binding ProjectDocker.CanReorder}"
                              Command="{Binding ProjectDocker.MoveSelectedDownCommand}"
                              ToolTip.Tip="Later in the running order" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </controls:Docker.TopBar>
              <controls:Docker.BottomBar>
                <StackPanel>
                  <!--
                    Q39. What the selected folder carries, here rather than on
                    every row: a tree of forty rows has to stay scannable, which
                    is what the panel is for. Absent when it carries nothing, so
                    an ordinary folder costs no line.

                    It lists facets and draws no conclusion from the combination
                    — a folder with a reading and a pivot is a folder with a
                    reading and a pivot, and whether that makes it a character is
                    the artist's to say with its glyph.
                  -->
                  <Border Classes="dockerBar" IsVisible="{Binding ProjectDocker.HasFacets}">
                    <ItemsControl ItemsSource="{Binding ProjectDocker.SelectedFacets}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" FontSize="10" Opacity="0.6" Margin="0,0,8,0" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <Border Classes="dockerBar"
                          IsVisible="{Binding ProjectDocker.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ProjectDocker.Status}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </controls:Docker.BottomBar>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="ProjectRows" ItemsSource="{Binding ProjectDocker.Rows}"
                         SelectedItem="{Binding ProjectDocker.Selected}"
                         Background="Transparent" BorderThickness="0" Margin="2"
                         DragDrop.AllowDrop="True"
                         DragDrop.DragOver="OnProjectRowDragOver"
                         DragDrop.Drop="OnProjectRowDrop"
                         DoubleTapped="OnProjectRowActivated">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="2,0" />
                      <Setter Property="MinHeight" Value="22" />
                    </Style>
                    <!-- B76. Dimmed while there is no file behind the row,
                         whichever of the two reasons it is. The word beside the
                         name says which; this is what makes the distinction
                         scannable without reading every row. -->
                    <Style Selector="TextBlock.offDisk">
                      <Setter Property="Opacity" Value="0.5" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectRow">
                      <!--
                        A row is a drag source and a drop target: pull a
                        document onto a character to re-file it, or onto the
                        project heading to take it out of every character.
                        Background must be set or the empty part of the row is
                        not hit-testable and the drop never arrives.
                      -->
                      <DockPanel Classes.characterRow="{Binding IsHeading}"
                                 Classes.animationRow="{Binding !IsHeading}" MinHeight="22"
                                 Background="Transparent"
                                 PointerPressed="OnProjectRowPressed"
                                 DragDrop.AllowDrop="True">
                        <!-- Right-click selects the row first (see
                             OnProjectRowPressed), so every item here acts on
                             the row under the pointer rather than on whatever
                             happened to be selected before. -->
                        <!--
                          Click rather than Command. A flyout's items live in a
                          popup, not in the window's tree, so the
                          `$parent[Window]` binding the ＋ menu uses resolves to
                          nothing here and every item is silently dead. The
                          handlers act on ProjectDocker.Selected, which the
                          right-click sets before the menu opens.
                        -->
                        <DockPanel.ContextFlyout>
                          <MenuFlyout Opening="OnProjectRowMenuOpening">
                            <MenuItem Header="Open" Click="OnProjectOpen"
                                      ToolTip.Tip="Open as a tab in Lightbox" />                            <MenuItem Header="Open with default app…" Click="OnProjectOpenExternally"
                                      ToolTip.Tip="Hand the file to whatever application the desktop associates with it" />
                            <MenuItem Header="Show in file manager" Click="OnProjectReveal" />
                            <MenuItem Header="Copy path" Click="OnProjectCopyPath" />
                            <Separator />
                            <MenuItem Header="Duplicate" Click="OnProjectDuplicate"
                                      ToolTip.Tip="Copy this animation, art and all — a walk into a limp" />
                            <MenuItem Header="Rename…" Click="OnProjectRowRename" />
                            <!--
                              Q38. The artist says what a folder is; nothing
                              derives it. Deriving a glyph from what a folder
                              carries puts the code back in the business of
                              picking which facet makes it "a character", and a
                              production has props, environments, effects and
                              crowds that no two nouns can name.
                            -->
                            <MenuItem Header="Glyph"
                                      ItemsSource="{Binding Owner.GlyphMenu}"
                                      ToolTip.Tip="What this folder is, in your words. Nothing reads it.">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" FontSize="15" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <MenuItem Header="Glyph — something else…" Click="OnProjectChooseGlyph"
                                      ToolTip.Tip="Type any character. The grid is a starting point, not a vocabulary." />
                            <!--
                              Q30. Where an artist says a palette belongs to this
                              part of the project. On the row rather than in the
                              Colour panel, because the question is "what is this
                              folder for", and the folder is what is under the
                              pointer.
                            -->
                            <!--
                              Q30. Declaring a preset here also says where one
                              deliverable ends — the folder that declares it is
                              the folder whose subtree becomes one file.
                            -->
                            <MenuItem Header="Export this as"
                                      ItemsSource="{Binding Owner.ExportPresetMenu}"
                                      ToolTip.Tip="How this folder is exported, and where one file ends">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <!--
                              Q30. The plan was describable and not runnable:
                              PlanExport, DescribeExportPlan and RecordExport all
                              existed on the view model and no view called any of
                              them. This is the gesture.
                            -->
                            <MenuItem Header="Export this folder…" Click="OnProjectExportFolder"
                                      ToolTip.Tip="Everything under it, grouped the way its preset says. Counts what it would write before writing anything." />
                            <MenuItem Header="Test export" Click="OnProjectTestExport"
                                      ToolTip.Tip="This one drawing, into test-exports/ beside the project. Never over a deliverable." />
                            <Separator />
                            <!--
                              Here rather than in the AI bar because a reading
                              belongs to a folder, and folders live in this
                              panel. The AI bar acts on the open drawing.
                            -->
                            <MenuItem Header="Read this folder…" Click="OnProjectReadSubject"
                                      ToolTip.Tip="Ask the model what this folder holds, from its sheets. Once per folder — the answer is kept and you can edit it." />
                            <!--
                              Q30's declaration surface. Four kinds resolved
                              correctly and could not be declared from anywhere
                              an artist could point at, which reads as the app
                              being inconsistent rather than as four missing
                              menu entries. Same shape each time — a list of the
                              project's own, a command that declares the chosen
                              one — because they are the same gesture.
                            -->
                            <MenuItem Header="Share a palette here"
                                      ItemsSource="{Binding Owner.PaletteMenu}"
                                      ToolTip.Tip="Everything under this folder paints from it">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <MenuItem Header="Share a gradient here"
                                      ItemsSource="{Binding Owner.GradientMenu}"
                                      ToolTip.Tip="Everything under this folder can use it">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <MenuItem Header="Share a symbol here"
                                      ItemsSource="{Binding Owner.SymbolMenu}"
                                      ToolTip.Tip="Narrows which symbols are offered under this folder. Symbols are project-wide until the first one is declared.">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <MenuItem Header="Share a brush tip here"
                                      ItemsSource="{Binding Owner.TipMenu}"
                                      ToolTip.Tip="Narrows which of the project's tips are offered under this folder. Your own library and the built-ins are never narrowed.">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <MenuItem Header="Share guides here"
                                      ItemsSource="{Binding Owner.GuideSetMenu}"
                                      ToolTip.Tip="Drawings under this folder can pull these guides in. The roadmap's character height guide is one of these and a declaration.">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <!-- A default rather than a share: a scope starts new
                                 documents from one template, so this replaces
                                 where the three above accumulate. -->
                            <MenuItem Header="New documents start from"
                                      ItemsSource="{Binding Owner.TemplateMenu}"
                                      ToolTip.Tip="Which template a new drawing made in this folder begins as">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <!--
                              References invert the gesture, and the reason is in
                              ShareSelectedAsReference: the resource is an
                              ordinary drawing, so a list hung off the folder
                              would be every document in the project. You pick
                              the drawing and say how far it reaches — which is
                              also the only place ResourceReach.Project has a
                              gesture, and workflows 3 and 4 are exactly that.
                            -->
                            <MenuItem Header="Use this as reference"
                                      IsVisible="{Binding Owner.CanShareSelectedAsReference}">
                              <MenuItem Header="For everything filed alongside it"
                                        Click="OnShareAsReferenceHere" />
                              <MenuItem Header="For the whole project"
                                        Click="OnShareAsReferenceEverywhere"
                                        ToolTip.Tip="One environment layout every drawing works against, wherever it is filed" />
                            </MenuItem>
                            <!--
                              And the half that makes the rest safe to use.
                              Declaring is one click and it switches a project
                              from every-resource-everywhere to scoped; without
                              this the only way to find out what a folder
                              declared was to open a drawing and notice the
                              picker had changed.
                            -->
            <!--
                              Two flat lists rather than one list of declarations
                              each opening onto its own verbs. A third level
                              cannot carry the row as a CommandParameter through
                              a Styles setter, and the flat form is the pattern
                              every entry above already uses — the header is the
                              verb, the list is what it acts on.
                            -->
                            <MenuItem Header="Stop sharing"
                                      IsVisible="{Binding Owner.HasDeclarations}"
                                      ItemsSource="{Binding Owner.UnshareMenu}"
                                      ToolTip.Tip="What this row declares — not what it inherits from above">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <MenuItem Header="Reach"
                                      IsVisible="{Binding Owner.HasDeclarations}"
                                      ItemsSource="{Binding Owner.ReachMenu}"
                                      ToolTip.Tip="Published reaches every folder in the project; otherwise it reaches this subtree">
                              <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScopeMenuEntry">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </MenuItem.ItemTemplate>
                              <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="vm:ScopeMenuEntry">
                                  <Setter Property="Command" Value="{Binding Command}" />
                                  <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                                </Style>
                              </MenuItem.Styles>
                            </MenuItem>
                            <MenuItem Header="Remove from project" Click="OnProjectRemove"
                                      ToolTip.Tip="Take it out of the index. The file stays on disk." />
                            <!-- B87. Its own entry rather than a modifier on the
                                 one above: two operations with different
                                 consequences should not be one gesture told
                                 apart by a held key. -->
                            <MenuItem Header="Delete permanently…" Click="OnProjectDeletePermanently"
                                      ToolTip.Tip="Remove it from the project and delete it from disk" />
                            <Separator />
                            <!-- Status, and the reason it is here rather than in the
                                 document: marking something Ready must not need the
                                 file open and must not dirty the artwork. -->
                            <MenuItem Header="Status" IsVisible="{Binding !IsHeading}">
                              <MenuItem Header="Not set" Click="OnProjectStatusClear" />
                              <Separator />
                              <MenuItem Header="Design" Tag="Design" Click="OnProjectStatusSet" />
                              <MenuItem Header="Draft" Tag="Draft" Click="OnProjectStatusSet" />
                              <MenuItem Header="In development" Tag="InDevelopment" Click="OnProjectStatusSet" />
                              <MenuItem Header="Review" Tag="Review" Click="OnProjectStatusSet" />
                              <MenuItem Header="Ready" Tag="Ready" Click="OnProjectStatusSet"
                                        ToolTip.Tip="With auto-export on, this is what hands the asset to the engine." />
                              <MenuItem Header="Reopened" Tag="Reopened" Click="OnProjectStatusSet"
                                        ToolTip.Tip="Was Ready and is not any more — the state a linear pipeline cannot express." />
                            </MenuItem>
                          </MenuFlyout>
                        </DockPanel.ContextFlyout>
                        <!-- B104. The depth, on screen. ProjectRow.Indent has
                             computed this since B86 and nothing ever bound to
                             it, so a folder three levels down drew flush left
                             beside the project row and the tree read as a flat
                             list. A left-docked spacer rather than a Margin on
                             the row, because the row's own background is the
                             drop target and indenting it would shrink the area
                             a drag can land on. -->
                        <Border DockPanel.Dock="Left" Width="{Binding Indent}"
                                IsHitTestVisible="False" />
                        <!-- B86. The twisty, on folder rows only. A Button
                             rather than a click on the glyph, because collapsing
                             and selecting are different intentions and one
                             gesture cannot mean both. Empty and hit-test-invisible
                             on every other row, so nothing shifts sideways. -->
                        <Button DockPanel.Dock="Left" Classes="text"
                                Content="{Binding Twisty}" FontSize="9" Width="12" Padding="0"
                                IsVisible="{Binding IsFolder}"
                                VerticalAlignment="Center" Opacity="0.7"
                                Command="{Binding $parent[Window].DataContext.ProjectDocker.ToggleCollapsedCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Show or hide what is in this folder" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7" />
                        <!-- Status as a dot, because the column has to read down at a
                             glance and a word per row would not. The tooltip names it. -->
                        <Border DockPanel.Dock="Right" Width="8" Height="8" CornerRadius="4"
                                VerticalAlignment="Center" Margin="4,0,2,0"
                                IsVisible="{Binding HasStatus}"
                                Background="{Binding StatusColor}"
                                ToolTip.Tip="{Binding StatusLabel}" />
                        <!-- Running time, right-aligned so the column reads
                             down. Absent when nothing knows the length rather
                             than showing a zero somebody might schedule
                             against. -->
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}"
                                   IsVisible="{Binding HasDuration}"
                                   FontSize="10" Opacity="0.55" Margin="6,0,2,0"
                                   VerticalAlignment="Center" />
                        <!--
                          B76, and B61's half that never reached the view. Two
                          different absences, said differently on purpose:
                          "not saved yet" is ordinary and "not on disk" is not,
                          and a row that said the same thing for both would
                          either cry wolf on every new document or bury a
                          deleted file among them. Right-aligned so the column
                          reads down beside the running time, and both are
                          absent on a row whose file is where it should be.
                        -->
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PendingHint}"
                                   IsVisible="{Binding Pending}"
                                   FontSize="10" Opacity="0.5" FontStyle="Italic"
                                   Margin="6,0,2,0" VerticalAlignment="Center"
                                   ToolTip.Tip="In the project, not written to disk yet. Save to write it." />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MissingHint}"
                                   IsVisible="{Binding Missing}"
                                   FontSize="10" Foreground="{StaticResource AccentCoralBrush}" FontWeight="SemiBold"
                                   Margin="6,0,2,0" VerticalAlignment="Center"
                                   ToolTip.Tip="This is in your project and its file cannot be found. Removing it from the project stays your decision." />
                        <Panel MinHeight="20">
                          <!-- Dimmed while it has no file, whichever reason. The
                               word beside it says which; the dimming is what
                               makes the row scannable without reading. -->
                          <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsRenaming}"
                                     Classes.offDisk="{Binding !IsOnDisk}"
                                     VerticalAlignment="Center" FontSize="11" />
                          <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   IsVisible="{Binding IsRenaming}" VerticalAlignment="Center"
                                   FontSize="11" LostFocus="OnProjectNameLostFocus"
                                   KeyDown="OnProjectNameKeyDown" />
                        </Panel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </controls:Docker>

        <controls:Docker x:Name="LayersDocker" PanelId="Layers" Title="Layers"
                         CloseCommand="{Binding ToggleLayersPanelCommand}">
              <controls:Docker.TitleBarExtra>
                <Button Content="⇄" FontSize="11" Padding="6,2"
                        Command="{Binding SwitchSidebarSideCommand}"
                        ToolTip.Tip="Move the sidebar to the other side" />
              </controls:Docker.TitleBarExtra>
              <controls:Docker.TopBar>
                <Border Classes="dockerBar">
                  <!-- What the ACTIVE layer is doing — blend and opacity — at the
                       top, where the reference puts it. The verbs live in the
                       bottom bar: reading is done at the top of a panel,
                       acting at the bottom. -->
                  <DockPanel>
                    <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding BlendModeChoices}"
                              SelectedItem="{Binding ActiveLayerBlendMode}" Width="104" FontSize="12"
                              ToolTip.Tip="Blend mode of the active layer" />
                    <NumericUpDown DockPanel.Dock="Right" Value="{Binding ActiveLayerOpacity}"
                                   Minimum="0" Maximum="100" Increment="5" FormatString="0"
                                   MinWidth="44" FontSize="12"
                                   ToolTip.Tip="Opacity of the active layer (%)" />
                    <Slider Value="{Binding ActiveLayerOpacity}" Minimum="0" Maximum="100" Margin="6,0"
                            VerticalAlignment="Center" ToolTip.Tip="Opacity of the active layer" />
                  </DockPanel>
                </Border>
              </controls:Docker.TopBar>
              <controls:Docker.BottomBar>
                <Border Classes="dockerBar">
                  <DockPanel>
                    <!-- A Raster/Vector picker sat on the right of this bar. It asked
                         the artist to choose a limitation before drawing anything:
                         both kinds painted identical strokes, and Vector only meant
                         "this layer cannot hold imported pixels or a symbol". Q52. -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Content="＋" Command="{Binding AddPaintedLayerCommand}"
                              ToolTip.Tip="Add a new layer" />
                      <Button Content="📁" Command="{Binding CreateLayerFolderCommand}"
                              ToolTip.Tip="New folder containing the active layer" />
                      <Button Content="🗑" Command="{Binding DeleteActiveLayerCommand}"
                              ToolTip.Tip="Delete the active layer (Delete inside this docker; Backspace blanks its content)" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </controls:Docker.BottomBar>

              <!-- Topmost layer first: visibility, then the name (double-click to rename) -->
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LayerPanelItems}" Margin="4">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="vm:GroupRow">
                      <Border Classes="groupRow" Classes.hiddenLayer="{Binding !Visible}"
                              Classes.lockedLayer="{Binding Locked}"
                              BorderBrush="{Binding ColorBrush}" BorderThickness="4,0,0,0" CornerRadius="3">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Rename" Click="OnGroupMenuRename" />
                            <MenuItem Header="Folder color">
                              <MenuItem Header="Blue" Tag="#4a6ea9" Click="OnGroupColorClicked">
                                <MenuItem.Icon><Border Width="14" Height="14" Background="#4a6ea9" CornerRadius="2" /></MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="Green" Tag="#4a9a5e" Click="OnGroupColorClicked">
                                <MenuItem.Icon><Border Width="14" Height="14" Background="#4a9a5e" CornerRadius="2" /></MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="Orange" Tag="#e0a030" Click="OnGroupColorClicked">
                                <MenuItem.Icon><Border Width="14" Height="14" Background="#e0a030" CornerRadius="2" /></MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="Red" Tag="#c25050" Click="OnGroupColorClicked">
                                <MenuItem.Icon><Border Width="14" Height="14" Background="#c25050" CornerRadius="2" /></MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="Purple" Tag="#8a5ac2" Click="OnGroupColorClicked">
                                <MenuItem.Icon><Border Width="14" Height="14" Background="#8a5ac2" CornerRadius="2" /></MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="Gray" Tag="#6a7280" Click="OnGroupColorClicked">
                                <MenuItem.Icon><Border Width="14" Height="14" Background="#6a7280" CornerRadius="2" /></MenuItem.Icon>
                              </MenuItem>
                            </MenuItem>
                            <MenuItem Header="Collapse / expand" Click="OnGroupMenuCollapse" />
                            <Separator />
                            <MenuItem Header="Add active layer to folder" Click="OnGroupMenuAddActive" />
                            <MenuItem Header="Dissolve folder (keep layers)" Click="OnGroupMenuDissolve" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <DockPanel>
                          <Button Classes="icon" DockPanel.Dock="Left" Content="{Binding CollapseGlyph}" FontSize="11"
                                  Background="Transparent" Click="OnGroupCollapseClicked"
                                  ToolTip.Tip="Collapse / expand the folder" />
                          <ToggleButton Classes="icon glyph eye" DockPanel.Dock="Left" IsChecked="{Binding Visible}"
                                        ToolTip.Tip="Folder visibility (gates every layer inside)"><Path /></ToggleButton>
                          <ToggleButton Classes="icon glyph lock" DockPanel.Dock="Left" IsChecked="{Binding Locked}"
                                        ToolTip.Tip="Lock the folder — every layer inside refuses edits, but still renders"><Path /></ToggleButton>
                          <Button Classes="icon" DockPanel.Dock="Right" Content="✕" FontSize="10" Background="Transparent"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DissolveGroupCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Dissolve the folder (layers stay)" />
                          <Button Classes="icon" DockPanel.Dock="Right" Content="＋" FontSize="10" Background="Transparent"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddActiveLayerToGroupCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Put the active layer in this folder" />
                          <Panel Margin="4,0" MinHeight="24">
                            <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsRenaming}" FontWeight="SemiBold"
                                       Background="Transparent" VerticalAlignment="Center"
                                       DoubleTapped="OnGroupNameDoubleTapped" ToolTip.Tip="Double-click to rename" />
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     IsVisible="{Binding IsRenaming}" VerticalAlignment="Center"
                                     LostFocus="OnGroupNameLostFocus" KeyDown="OnGroupNameKeyDown" />
                          </Panel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:LayerRow">
                      <Border Classes="layerRow" Classes.active="{Binding IsActive}" Classes.grouped="{Binding IsGrouped}"
                              Classes.hiddenLayer="{Binding !Visible}" Classes.lockedLayer="{Binding EditsBlocked}"
                              Focusable="True"
                              PointerPressed="OnLayerRowPressed">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Rename" Click="OnLayerMenuRename" />
                            <Separator />
                            <MenuItem Header="Move up" Click="OnLayerMenuMoveUp" />
                            <MenuItem Header="Move down" Click="OnLayerMenuMoveDown" />
                            <Separator />
                            <MenuItem Header="New folder from layer" Click="OnLayerMenuNewFolder" />
                            <MenuItem Header="Remove from folder" IsVisible="{Binding IsGrouped}"
                                      Click="OnLayerMenuRemoveFromFolder" />
                            <Separator />
                            <MenuItem Header="Select layer contents" Click="OnLayerMenuSelectAlpha" />
                            <MenuItem Header="Blank layer content" Click="OnLayerMenuBlank" />
                            <Separator />
                            <MenuItem Header="In exports">
                              <MenuItem Header="Decide automatically" Click="OnLayerMenuExportAuto"
                                        ToolTip.Tip="The export's own background handling decides. The default." />
                              <MenuItem Header="Never export this layer" Click="OnLayerMenuExportNever"
                                        ToolTip.Tip="Left out of every export, in every mode — a reference photo, a colour check, a note to self." />
                              <MenuItem Header="Always export this layer" Click="OnLayerMenuExportAlways"
                                        ToolTip.Tip="Kept in even when background detection would drop it — for the asset whose background is the point: a backdrop, a sky, a tiling floor." />
                            </MenuItem>
                            <MenuItem Header="Delete layer" Click="OnLayerMenuDelete" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <DockPanel>
                          <ToggleButton Classes="icon glyph eye" DockPanel.Dock="Left" IsChecked="{Binding Visible}"
                                        ToolTip.Tip="Layer visibility"><Path /></ToggleButton>
                          <ToggleButton Classes="icon glyph lock" DockPanel.Dock="Left" IsChecked="{Binding Locked}"
                                        ToolTip.Tip="Lock the layer — refuses paint, fill, transform, delete and cel edits. It still renders and still exports."><Path /></ToggleButton>
                          <ToggleButton Classes="icon glyph alpha" DockPanel.Dock="Left" IsChecked="{Binding AlphaLocked}"
                                        ToolTip.Tip="Lock transparency — paint only lands where the layer already has content, so the silhouette cannot change"><Path /></ToggleButton>
                          <Border DockPanel.Dock="Left" Margin="4,0,0,0" BorderBrush="#555" BorderThickness="1"
                                  CornerRadius="2" Width="38" Height="22" VerticalAlignment="Center"
                                  Background="#111" PointerPressed="OnLayerThumbPressed"
                                  ToolTip.Tip="Layer content — Ctrl+click to select its visible pixels (Shift adds, Alt subtracts)">
                            <Image Source="{Binding Thumb}" Stretch="Uniform" />
                          </Border>
                          <Button Classes="icon" DockPanel.Dock="Right" Content="⏏" FontSize="9" Background="Transparent"
                                  IsVisible="{Binding IsGrouped}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveLayerFromGroupCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Take this layer out of its folder" />
                          <!-- Stacked reorder arrows: half-height each so the pair
                               fits one row without setting the row's height. -->
                          <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Spacing="0" VerticalAlignment="Center">
                            <Button Content="▲" FontSize="8" Padding="4,0" MinHeight="11" Height="11" Background="Transparent"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveLayerUpCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Move layer up" />
                            <Button Content="▼" FontSize="8" Padding="4,0" MinHeight="11" Height="11" Background="Transparent"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveLayerDownCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Move layer down" />
                          </StackPanel>
                          <!-- An "R"/"V" badge sat here, and named a distinction that no
                               longer exists: every layer holds strokes and can hold
                               pixels. Q52. (The symbol browser's KindLabel further down
                               is a different property on a different row.) -->
                          <Panel Margin="4,0" MinHeight="24">
                            <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsRenaming}"
                                       Background="Transparent" VerticalAlignment="Center"
                                       DoubleTapped="OnLayerNameDoubleTapped"
                                       ToolTip.Tip="Double-click to rename" />
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     IsVisible="{Binding IsRenaming}" VerticalAlignment="Center"
                                     LostFocus="OnLayerNameLostFocus" KeyDown="OnLayerNameKeyDown" />
                          </Panel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </ScrollViewer>
            </controls:Docker>

        <!--
          Symbols: a drawing stored once and placed many times. Absent unless a
          project is open, like the project tree and for the same reason — a
          symbol lives above the animations that place it, so without a project
          there is nowhere for one to live.

          The six libraries Pillar 3 asks for (pose, expression, hand, face,
          prop, FX) are the Kind filter below, not six panels.
        -->
        <controls:Docker x:Name="SymbolsPanel" PanelId="Symbols" Title="Symbols"
                         CloseCommand="{Binding ToggleSymbolsPanelCommand}">
              <controls:Docker.TopBar>
                <Border Classes="dockerBar">
                  <DockPanel>
                    <ComboBox DockPanel.Dock="Left" Width="104"
                              ItemsSource="{Binding SymbolBrowser.KindChoices}"
                              SelectedItem="{Binding SymbolBrowser.KindFilter}"
                              PlaceholderText="All kinds"
                              ToolTip.Tip="Show one kind of symbol, or all of them" />
                    <!-- Both scopes in one grid: the question is "which sword do
                         I want", not "which folder is it in". The filter is for
                         when it becomes the second question. -->
                    <ComboBox DockPanel.Dock="Left" Width="92" Margin="4,0,0,0"
                              ItemsSource="{Binding SymbolBrowser.ScopeChoices}"
                              SelectedItem="{Binding SymbolBrowser.ScopeFilter}"
                              PlaceholderText="Everywhere"
                              ToolTip.Tip="Project symbols live in this project only. Global ones are yours and are available in every project — placing one copies it into the project, so the project still renders with your library gone." />
                    <TextBox Text="{Binding SymbolBrowser.Search, Mode=TwoWay}"
                             Watermark="Search" Margin="4,0,0,0"
                             ToolTip.Tip="Matches a name or a tag" />
                  </DockPanel>
                </Border>
              </controls:Docker.TopBar>
              <controls:Docker.BottomBar>
                <StackPanel>
                  <!--
                    What changed under you. Absent unless there is something to
                    say — a bar reading "nothing is out of date" on every
                    drawing would be a row of the panel spent on silence.
                  -->
                  <Border Classes="dockerBar"
                          IsVisible="{Binding StalePlacementReport, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Acknowledge" Click="OnAcknowledgeStale"
                              ToolTip.Tip="Stop reporting these. Nothing about the drawing changes." />
                      <TextBlock Text="{Binding StalePlacementReport}" FontSize="10" Opacity="0.7"
                                 TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,0" />
                    </DockPanel>
                  </Border>
                <Border Classes="dockerBar">
                  <!-- Wraps rather than clips: the panel's minimum is 130px and
                       four controls do not fit in it on one line. -->
                  <WrapPanel ItemSpacing="4" LineSpacing="4">
                    <Button Content="Make symbol" Click="OnMakeSymbol"
                            ToolTip.Tip="Turn this drawing into a symbol and place it here" />
                    <Button Content="Edit" Command="{Binding EditSelectedSymbolCommand}"
                            IsEnabled="{Binding SymbolBrowser.Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Open the symbol to draw on it — every placement of it updates" />
                    <Button Content="Place" Command="{Binding PlaceSelectedCommand}"
                            IsEnabled="{Binding SymbolBrowser.Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Put the selected symbol on this drawing" />
                    <Button Content="Usage" Click="OnSymbolUsage"
                            IsEnabled="{Binding SymbolBrowser.Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Count where this symbol is placed — reads every document in the project" />
                    <Button Content="Promote" Click="OnPromoteSymbol"
                            IsEnabled="{Binding CanPromoteSelectedSymbol}"
                            ToolTip.Tip="Copy this symbol into your own library, so every project can use it" />
                    <!-- The pull, and only when there is something to pull.
                         Absent rather than disabled: an artist whose library
                         matches should not be shown a button about it. -->
                    <Button Content="Update from library" Click="OnUpdateSymbolsFromLibrary"
                            IsVisible="{Binding HasLibraryUpdates}"
                            ToolTip.Tip="Take the newer version from your library. Nothing in your library can change a project on its own — this is the project asking." />
                    <Button Classes="icon" Content="🗑" Click="OnDeleteSymbol"
                            IsEnabled="{Binding SymbolBrowser.Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Delete the symbol from the project" />
                  </WrapPanel>
                </Border>
                </StackPanel>
              </controls:Docker.BottomBar>
              <Panel>
                <TextBlock Text="{Binding SymbolBrowser.EmptyMessage}" Margin="10" FontSize="11"
                           Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top"
                           IsVisible="{Binding SymbolBrowser.EmptyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ListBox x:Name="SymbolTiles" DoubleTapped="OnSymbolTileOpened"
                           PointerPressed="OnSymbolTilePressed"
                           ItemsSource="{Binding SymbolBrowser.Rows}"
                           SelectedItem="{Binding SymbolBrowser.Selected}"
                           Background="Transparent" BorderThickness="0" Margin="2">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Width="72" Margin="1" Spacing="1"
                                    ToolTip.Tip="{Binding Tags}">
                          <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="3" Height="48">
                            <Image Source="{Binding Thumb}" Stretch="Uniform" />
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" />
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" FontSize="9" Opacity="0.5" />
                            <TextBlock Text="{Binding KindLabel}" FontSize="9" Opacity="0.5"
                                       TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>
              </Panel>
            </controls:Docker>

        <controls:Docker x:Name="ColorPanel" PanelId="Color" Title="Color"
                         CloseCommand="{Binding ToggleColorDockerCommand}">
              <controls:Docker.TopBar>
                <Border Classes="dockerBar">
                  <ComboBox ItemsSource="{Binding ColorPicker.ModeChoices}" SelectedItem="{Binding ColorPicker.Mode}"
                            Width="120" ToolTip.Tip="Color picker representation" />
                </Border>
              </controls:Docker.TopBar>
              <controls:Docker.BottomBar>
                <Border Classes="dockerBar">
                  <DockPanel>
                    <!--
                      The preview is also the readout. Hex and the channel
                      numbers live behind a click rather than taking a row of
                      the panel for good: they are what a colour IS, not how
                      you pick one, and the wheel above is how you pick one.
                      Dragging the swatch onto the canvas still fills.
                    -->
                    <Border x:Name="ColorSwatch" DockPanel.Dock="Left" Width="28" Height="28"
                            CornerRadius="14" BorderBrush="#555" BorderThickness="1"
                            Background="{Binding ColorPicker.SwatchBrush}"
                            PointerPressed="OnColorSwatchPressed"
                            Cursor="Hand"
                            ToolTip.Tip="Current colour — click for its values, or drag it onto the canvas to fill">
                      <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Top">
                          <ContentControl Content="{Binding ColorPicker}"
                                          ContentTemplate="{StaticResource ColorPickerBody}" />
                        </Flyout>
                      </FlyoutBase.AttachedFlyout>
                    </Border>
                    <TextBlock Text="{Binding ColorHex}" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="11" Opacity="0.75" />
                  </DockPanel>
                </Border>
              </controls:Docker.BottomBar>

              <!--
                No scroll viewer. Exactly one of the groups below is visible at
                a time, so they all share a single row and the panel is as tall
                as whichever one is showing — a colour picker you have to scroll
                to reach is not a colour picker.
              -->
              <Grid Margin="8">
                <!--
                  Krita-style wheel: hue ring plus a value slider beside it.

                  The slider used to sit under the wheel, which meant a wheel
                  tall enough to be usable pushed it out of the docker: the one
                  control you reach for on every stroke was the one that
                  scrolled away. Side by side, the pair is one row.

                  The Viewbox is what keeps it in view at any panel height. The
                  ring used to be sized from its own width and clamped at 240,
                  which is a height the panel does not always have — and the
                  moment it did not, the wheel grew a scrollbar and pushed
                  itself off the bottom. Scaling the pair as a unit means the
                  wheel is always whole, always square, and always the largest
                  it can be in the room it has.
                -->
                <!--
                  Capped at 190, not 320. The reference's wheel is ~150px in a
                  docker column — a compact instrument, not the panel's main
                  event — and at 320 ours was the largest single control in the
                  application. (The reference also draws a hue RING with the
                  SV square inside it, which is a different control from this
                  disc; that redesign is its own piece of work and only the
                  size is taken here.)
                -->
                <!-- The reference's wheel: a hue RING with the SV square
                     inside it. The square carries saturation and value, so
                     the separate value slider the disc needed is gone. The
                     square's side is the largest that fits the ring's inner
                     circle (inner diameter over root two). -->
                <Viewbox Stretch="Uniform" StretchDirection="Both" MinHeight="120" MaxHeight="190"
                         IsVisible="{Binding ColorPicker.IsWheelMode}">
                  <Panel Width="220" Height="220">
                    <controls:HueRing HsvColor="{Binding ColorPicker.WheelHsv, Mode=TwoWay}" RingWidth="16" />
                    <ColorSpectrum Width="130" Height="130"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Shape="Box" Components="SaturationValue"
                                   HsvColor="{Binding ColorPicker.WheelHsv, Mode=TwoWay}" />
                  </Panel>
                </Viewbox>

                  <!-- HSV sliders -->
                  <StackPanel Spacing="4" VerticalAlignment="Top" IsVisible="{Binding ColorPicker.IsHsvMode}">
                    <DockPanel>
                      <TextBlock Text="H" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Hue}" Minimum="0" Maximum="360"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Hue}" Minimum="0" Maximum="360" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="S" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.HsvSaturation}" Minimum="0" Maximum="100"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.HsvSaturation}" Minimum="0" Maximum="100" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="V" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.HsvValue}" Minimum="0" Maximum="100"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.HsvValue}" Minimum="0" Maximum="100" Margin="4,0" />
                    </DockPanel>
                  </StackPanel>

                  <!-- HSL sliders -->
                  <StackPanel Spacing="4" VerticalAlignment="Top" IsVisible="{Binding ColorPicker.IsHslMode}">
                    <DockPanel>
                      <TextBlock Text="H" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Hue}" Minimum="0" Maximum="360"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Hue}" Minimum="0" Maximum="360" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="S" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.HslSaturation}" Minimum="0" Maximum="100"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.HslSaturation}" Minimum="0" Maximum="100" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="L" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.HslLightness}" Minimum="0" Maximum="100"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.HslLightness}" Minimum="0" Maximum="100" Margin="4,0" />
                    </DockPanel>
                  </StackPanel>

                  <!-- RGB sliders -->
                  <StackPanel Spacing="4" VerticalAlignment="Top" IsVisible="{Binding ColorPicker.IsRgbMode}">
                    <DockPanel>
                      <TextBlock Text="R" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Red}" Minimum="0" Maximum="255"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Red}" Minimum="0" Maximum="255" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="G" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Green}" Minimum="0" Maximum="255"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Green}" Minimum="0" Maximum="255" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="B" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Blue}" Minimum="0" Maximum="255"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Blue}" Minimum="0" Maximum="255" Margin="4,0" />
                    </DockPanel>
                  </StackPanel>

                  <!-- CMYK sliders -->
                  <StackPanel Spacing="4" VerticalAlignment="Top" IsVisible="{Binding ColorPicker.IsCmykMode}">
                    <DockPanel>
                      <TextBlock Text="C" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Cyan}" Minimum="0" Maximum="100"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Cyan}" Minimum="0" Maximum="100" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="M" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Magenta}" Minimum="0" Maximum="100"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Magenta}" Minimum="0" Maximum="100" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="Y" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Yellow}" Minimum="0" Maximum="100"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Yellow}" Minimum="0" Maximum="100" Margin="4,0" />
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="K" Width="16" VerticalAlignment="Center" />
                      <NumericUpDown DockPanel.Dock="Right" Value="{Binding ColorPicker.Black}" Minimum="0" Maximum="100"
                                     Increment="1" FormatString="0" MinWidth="44" />
                      <Slider Value="{Binding ColorPicker.Black}" Minimum="0" Maximum="100" Margin="4,0" />
                    </DockPanel>
                  </StackPanel>
              </Grid>
            </controls:Docker>

        <controls:Docker x:Name="SheetsPanel" PanelId="Sheets" Title="Reference sheets"
                         CloseCommand="{Binding ToggleSheetsDockerCommand}">
              <controls:Docker.TopBar>
                <Border Classes="dockerBar">
                  <Button Classes="text" Content="＋ Sheet" Click="OnAddReferenceSheet"
                          ToolTip.Tip="Add a character sheet (reference art, not part of the animation)" />
                </Border>
              </controls:Docker.TopBar>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ReferenceSheetsView}" Margin="4">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="docs:ReferenceSheet">
                      <StackPanel Spacing="1">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="＋ view" FontSize="11" Padding="6,2"
                                  Click="OnAddReferenceView"
                                  ToolTip.Tip="Add a view (front/side/…) to this sheet" />
                          <TextBox Text="{Binding Name}" BorderThickness="0" Background="Transparent"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   GotFocus="OnReferenceNameFocused" LostFocus="OnReferenceRenamed" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Views}" Margin="14,0,0,4">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Vertical" Spacing="1" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="docs:ReferenceView">
                              <DockPanel>
                                <Button Classes="icon" DockPanel.Dock="Right" Content="✎" FontSize="11"
                                        Click="OnOpenReferenceView" ToolTip.Tip="Open this view in a tab" />
                                <TextBox Text="{Binding Name}" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="12"
                                         GotFocus="OnReferenceNameFocused" LostFocus="OnReferenceRenamed" />
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </controls:Docker>

        <controls:Docker x:Name="PalettePanel" PanelId="Palette" Title="Palette"
                         CloseCommand="{Binding TogglePaletteDockerCommand}">
              <controls:Docker.TopBar>
                <Border Classes="dockerBar">
                  <StackPanel Spacing="4">
                    <DockPanel>
                      <Button Classes="icon" DockPanel.Dock="Right" Content="✕" FontSize="10"
                              Command="{Binding PaletteDocker.RemovePaletteCommand}"
                              IsEnabled="{Binding PaletteDocker.HasPalette}"
                              ToolTip.Tip="Delete the selected palette or folder (art keeps the colours it was drawn in)" />
                      <Button Classes="icon" DockPanel.Dock="Right" Content="🗀" FontSize="10"
                              Command="{Binding PaletteDocker.AddFolderCommand}"
                              ToolTip.Tip="New folder, inside whatever is selected" />
                      <Button Classes="icon" DockPanel.Dock="Right" Content="＋" FontSize="10"
                              Command="{Binding PaletteDocker.AddPaletteCommand}"
                              ToolTip.Tip="New palette, inside whatever is selected" />
                      <TextBlock Text="Palettes" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Classes="text" Content="＋ Swatch"
                              Command="{Binding PaletteDocker.AddSwatchCommand}"
                              IsEnabled="{Binding PaletteDocker.HasPalette}"
                              ToolTip.Tip="Add the current colour to this palette" />
                      <Button Classes="icon" Content="－" FontSize="11"
                              Command="{Binding PaletteDocker.RemoveSwatchCommand}"
                              IsEnabled="{Binding PaletteDocker.HasSwatch}"
                              ToolTip.Tip="Remove the selected swatch" />
                      <!--
                        The deliberate way to get two of a colour. It is what
                        lets the colour wheel refuse duplicates: an accidental
                        second copy is almost always a slip, and a palette full
                        of near-identical entries is a palette nobody can use.
                      -->
                      <Button Classes="text" Content="Duplicate"
                              Command="{Binding PaletteDocker.DuplicateSwatchCommand}"
                              IsEnabled="{Binding PaletteDocker.HasSwatch}"
                              ToolTip.Tip="A second, independent copy of this swatch — for filing the same colour in two places" />
                      <Button Classes="text" Content="Import…" Click="OnImportPaletteClicked"
                              ToolTip.Tip="Import a GIMP .gpl palette" />
                      <Button Classes="text" Content="Export…" Click="OnExportPaletteClicked"
                              IsEnabled="{Binding PaletteDocker.HasPalette}"
                              ToolTip.Tip="Write this palette as a GIMP .gpl" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </controls:Docker.TopBar>

              <controls:Docker.BottomBar>
                <Border Classes="dockerBar">
                  <StackPanel Spacing="4">
                    <CheckBox Content="Edit selected swatch"
                              IsChecked="{Binding PaletteDocker.EditSelectedSwatch}"
                              IsEnabled="{Binding PaletteDocker.HasSwatch}"
                              ToolTip.Tip="The colour picker recolours the selected swatch — and every stroke painted with it — instead of setting the paint colour" />
                    <!--
                      Colour first, then the name. Changing the colour is the
                      thing you come here to do; naming it is what you do once,
                      afterwards, and putting the rarer field in the reading
                      position made the common one the second thing you found.
                    -->
                    <DockPanel IsVisible="{Binding PaletteDocker.HasSwatch}">
                      <controls:ColorField x:Name="PaletteSwatchField" DockPanel.Dock="Left" Margin="0,0,4,0"
                                           Hex="{Binding PaletteDocker.SelectedSwatch.Color, Mode=TwoWay}" />
                      <TextBox Text="{Binding PaletteDocker.SelectedSwatch.Name, Mode=TwoWay}"
                               FontSize="11" PlaceholderText="Swatch name"
                               ToolTip.Tip="A palette is a vocabulary — “skin shadow”, not “#b07a5e”" />
                    </DockPanel>
                    <TextBlock Text="{Binding PaletteDocker.Status}" FontSize="10" Opacity="0.6"
                               TextWrapping="Wrap" IsVisible="{Binding PaletteDocker.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Border>
              </controls:Docker.BottomBar>

              <!--
                The hierarchy above, the selected palette's colours below.

                Two panes rather than a folder tree in a dropdown: filing is
                something you do while looking at the colours, and a tree you
                have to open to see is a tree you stop using. The splitter is
                there because how much room each half deserves depends on
                whether you are organising or painting.
              -->
              <Grid RowDefinitions="Auto,Auto,*">
                <TreeView x:Name="PaletteTree" Grid.Row="0"
                          ItemsSource="{Binding PaletteDocker.Tree}"
                          SelectedItem="{Binding PaletteDocker.SelectedNode, Mode=TwoWay}"
                          Height="128" Background="Transparent" BorderThickness="0"
                          DragDrop.AllowDrop="True">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:PaletteNode" ItemsSource="{Binding Children}">
                      <!--
                        The context menu is built in code rather than declared
                        here. A menu declared inside a template lives in a
                        popup, outside the tree it came from, and the bindings
                        that would reach the docker from there resolve to
                        nothing — items that look right and are silently dead.
                      -->
                      <Border Background="Transparent" Padding="1"
                              PointerPressed="OnPaletteNodePressed"
                              PointerMoved="OnPaletteNodeMoved"
                              PointerReleased="OnPaletteNodeReleased"
                              DragDrop.AllowDrop="True"
                              DragDrop.DragOver="OnPaletteNodeDragOver" DragDrop.Drop="OnPaletteNodeDrop"
                              ToolTip.Tip="Drag onto a folder to file it, or right-click to assign">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{Binding Glyph}" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                     IsVisible="{Binding !IsRenaming}" />
                          <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="11" MinWidth="90"
                                   IsVisible="{Binding IsRenaming}"
                                   LostFocus="OnPaletteNameCommitted" KeyDown="OnPaletteNameKey" />
                        </StackPanel>
                      </Border>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              Background="Transparent" ResizeDirection="Rows" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                  <ListBox ItemsSource="{Binding PaletteDocker.Swatches}"
                           SelectedItem="{Binding PaletteDocker.SelectedSwatch}"
                           Background="Transparent" BorderThickness="0" Margin="4">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SwatchRow">
                        <Border Width="26" Height="26" CornerRadius="3" BorderBrush="#666" BorderThickness="1"
                                Background="{Binding Fill}"
                                PointerPressed="OnSwatchPressed"
                                PointerMoved="OnSwatchMoved"
                                PointerReleased="OnSwatchReleased"
                                ToolTip.Tip="{Binding Label}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>
              </Grid>
            </controls:Docker>

        <controls:Docker x:Name="GradientPanel" PanelId="Gradient" Title="Gradient"
                         CloseCommand="{Binding ToggleGradientDockerCommand}">
              <controls:Docker.TopBar>
                <Border Classes="dockerBar">
                  <StackPanel Spacing="4">
                    <DockPanel>
                      <Button Classes="icon" DockPanel.Dock="Right" Content="✕" FontSize="10"
                              Command="{Binding GradientDocker.RemoveGradientCommand}"
                              IsEnabled="{Binding GradientDocker.HasGradient}"
                              ToolTip.Tip="Delete this gradient" />
                      <Button Classes="icon" DockPanel.Dock="Right" Content="＋" FontSize="10"
                              Command="{Binding GradientDocker.AddGradientCommand}"
                              ToolTip.Tip="New gradient" />
                      <ComboBox ItemsSource="{Binding GradientDocker.Gradients}"
                                SelectedItem="{Binding GradientDocker.SelectedGradient}"
                                HorizontalAlignment="Stretch" ToolTip.Tip="Gradient">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="docs:Gradient">
                            <TextBlock Text="{Binding Name}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </DockPanel>
                    <!-- The strip is sampled through GradientOps, so it shows
                         the linear-light ramp the canvas will actually paint. -->
                    <Border Height="22" CornerRadius="3" BorderBrush="#666" BorderThickness="1"
                            Background="{Binding GradientDocker.Preview}"
                            IsVisible="{Binding GradientDocker.HasGradient}"
                            ToolTip.Tip="Preview of the ramp" />
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding GradientDocker.HasGradient}">
                      <ComboBox ItemsSource="{Binding GradientDocker.KindChoices}"
                                SelectedItem="{Binding GradientDocker.Kind}" Width="92" FontSize="11"
                                ToolTip.Tip="Linear runs along the drag; radial takes the drag as its radius" />
                      <ComboBox ItemsSource="{Binding GradientDocker.SpreadChoices}"
                                SelectedItem="{Binding GradientDocker.Spread}" Width="92" FontSize="11"
                                ToolTip.Tip="What happens beyond the ends of the ramp" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </controls:Docker.TopBar>

              <!--
                The panel is now the ramp, the same editor the tool options bar
                offers. A list of rows with position spinners described a
                gradient; this is the gradient, and where a change happens is a
                spatial judgement that a number makes awkward.
              -->
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6" Spacing="8">
                  <controls:GradientRamp x:Name="PanelRampEditor"
                                         Gradient="{Binding GradientDocker.SelectedGradient}"
                                         IsVisible="{Binding GradientDocker.HasGradient}" />
                  <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                             IsVisible="{Binding GradientDocker.HasGradient}"
                             Text="Click above the ramp for an opacity stop, below it for a colour stop. Drag to move, middle-click to remove." />

                  <StackPanel Spacing="4" IsVisible="{Binding GradientDocker.HasAlphaStop}">
                    <TextBlock Text="Opacity stop" FontSize="10" Opacity="0.6" />
                    <DockPanel>
                      <NumericUpDown DockPanel.Dock="Right" Width="56" FontSize="11"
                                     Value="{Binding GradientDocker.SelectedAlpha}"
                                     Minimum="0" Maximum="100" Increment="5" FormatString="0" />
                      <Slider Value="{Binding GradientDocker.SelectedAlpha}"
                              Minimum="0" Maximum="100" Margin="0,0,4,0" />
                    </DockPanel>
                  </StackPanel>

                  <StackPanel Spacing="4" IsVisible="{Binding GradientDocker.HasStop}">
                    <TextBlock Text="Colour stop" FontSize="10" Opacity="0.6" />
                    <controls:ColorField Hex="{Binding GradientDocker.SelectedStop.Color, Mode=TwoWay}"
                                         HorizontalAlignment="Left" />
                  </StackPanel>

                  <DockPanel ToolTip.Tip="Opacity the gradient tool lays the ramp down at">
                    <TextBlock DockPanel.Dock="Left" Text="Tool" FontSize="11" Width="34"
                               VerticalAlignment="Center" />
                    <NumericUpDown DockPanel.Dock="Right" Width="56" FontSize="11"
                                   Value="{Binding GradientOpacity}" Minimum="0" Maximum="1"
                                   Increment="0.05" FormatString="0.00" />
                    <Slider Value="{Binding GradientOpacity}" Minimum="0" Maximum="1" Margin="4,0" />
                  </DockPanel>
                </StackPanel>
              </ScrollViewer>
            </controls:Docker>

        <!-- An imported animation reference: a run cycle, a shot, a contact
             sheet. Never artwork — it is the photograph taped to the lightbox,
             and it never reaches an exported pixel. -->
        <controls:Docker x:Name="ReferencePanel" PanelId="Reference" Title="Reference"
                         CloseCommand="{Binding ToggleReferenceDockerCommand}">
          <controls:Docker.TopBar>
            <Border Classes="dockerBar">
              <DockPanel>
                <Button Classes="icon" DockPanel.Dock="Right" Content="🗑" FontSize="10"
                        Command="{Binding RemoveReferenceCommand}"
                        IsEnabled="{Binding HasReferences}"
                        ToolTip.Tip="Remove this reference" />
                <Button Classes="icon" DockPanel.Dock="Right" Content="＋" FontSize="10"
                        Click="OnImportReferenceClicked"
                        ToolTip.Tip="Import an image of an animation — or a video clip to draw against — and lay it against the timeline" />
                <ComboBox ItemsSource="{Binding References}"
                          SelectedIndex="{Binding ActiveReferenceIndex}"
                          HorizontalAlignment="Stretch" IsVisible="{Binding HasReferences}"
                          ToolTip.Tip="Reference">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="docs:ReferenceStrip">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </DockPanel>
            </Border>
          </controls:Docker.TopBar>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6" Spacing="8">
              <TextBlock Text="{Binding ReferenceSummary}" FontSize="10" Opacity="0.6"
                         TextWrapping="Wrap" />

              <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                         IsVisible="{Binding !HasReferences}"
                         Text="Import a sprite sheet or a strip of frames. Lightbox finds the frames in it and puts one on each frame of the timeline." />

              <StackPanel Spacing="8" IsVisible="{Binding HasReferences}">
                <TextBlock Text="{Binding ReferenceCellLabel}" FontSize="11" />

                <CheckBox Content="Show on canvas" IsChecked="{Binding ReferenceVisible}" />
                <CheckBox Content="Follow timeline edits" IsChecked="{Binding ReferenceFollowsTimeline}"
                          ToolTip.Tip="Insert a frame and the references after it move along with the animation. Off pins the reference to absolute timing — matching a shot frame for frame." />

                <DockPanel ToolTip.Tip="One scale for every frame: a reference whose size varied frame to frame is the one thing a size reference exists to prevent.">
                  <TextBlock DockPanel.Dock="Left" Text="Scale" Width="52" VerticalAlignment="Center" FontSize="12" />
                  <NumericUpDown DockPanel.Dock="Right" Value="{Binding ReferenceScale}" Minimum="0.05"
                                 Maximum="8" Increment="0.05" FormatString="0.00" MinWidth="44" />
                  <Slider Value="{Binding ReferenceScale}" Minimum="0.05" Maximum="4" Margin="4,0" />
                </DockPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Opacity" Width="52" VerticalAlignment="Center" FontSize="12" />
                  <NumericUpDown DockPanel.Dock="Right" Value="{Binding ReferenceOpacity}" Minimum="0"
                                 Maximum="1" Increment="0.05" FormatString="0.00" MinWidth="44" />
                  <Slider Value="{Binding ReferenceOpacity}" Minimum="0" Maximum="1" Margin="4,0" />
                </DockPanel>

                <TextBlock Text="Frames" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                           Text="Detection reads the gaps between the drawings. Two rows that touch have no gap to find — say how many columns and rows instead." />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Cols" VerticalAlignment="Center" FontSize="11" />
                  <NumericUpDown Value="{Binding ReferenceColumns}" Minimum="0" Maximum="64"
                                 Increment="1" FormatString="0" Width="56" />
                  <TextBlock Text="Rows" VerticalAlignment="Center" FontSize="11" />
                  <NumericUpDown Value="{Binding ReferenceRows}" Minimum="0" Maximum="64"
                                 Increment="1" FormatString="0" Width="56" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Apply grid" Command="{Binding ApplyReferenceGridCommand}" />
                  <Button Content="Detect" Command="{Binding DetectReferenceFramesCommand}"
                          ToolTip.Tip="Find the frames from the image again" />
                </StackPanel>

                <TextBlock Text="Alignment" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0" />
                <ToggleButton Content="Align on canvas" IsChecked="{Binding ReferenceAlignMode}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="Drag the canvas to line this frame's reference up. Hold Shift to move the whole sheet instead. A mode rather than a modifier because Shift, Ctrl and Alt are already spoken for on the canvas." />
                <Grid ColumnDefinitions="52,*,6,20,*" IsVisible="{Binding HasReferenceCell}">
                  <TextBlock Grid.Column="0" Text="This frame" FontSize="10" VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                  <NumericUpDown Grid.Column="1" Value="{Binding ReferenceCellDx}" Increment="1"
                                 FormatString="0.#" ToolTip.Tip="Horizontal nudge, document pixels" />
                  <TextBlock Grid.Column="3" Text="Y" FontSize="10" VerticalAlignment="Center"
                             HorizontalAlignment="Center" />
                  <NumericUpDown Grid.Column="4" Value="{Binding ReferenceCellDy}" Increment="1"
                                 FormatString="0.#" ToolTip.Tip="Vertical nudge, document pixels" />
                </Grid>
                <Button Content="Clear all alignment" Command="{Binding ClearReferenceAlignmentCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Undo every per-frame nudge on this sheet" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </controls:Docker>

        <!-- The timeline does not move: its row is as long as the animation,
             so a 300px sidebar is a placement that cannot work. No switcher
             either, for the same reason. -->
        <!-- The track timeline: the reference's front tab. One track per
             layer, drawings as dots, holds as bars, the camera as its own
             track; the dots drag to retime. -->
        <controls:Docker x:Name="TimelineDocker" PanelId="Timeline" Title="Timeline"
                         CloseCommand="{Binding ToggleTimelineCommand}">
          <controls:Docker.TopBar>
            <Border Classes="dockerBar">
              <controls:OverflowBar Spacing="10" HorizontalAlignment="Center"
                                    MoreLabel="More  &#x25BE;" MenuPlacement="TopEdgeAlignedRight">
                <views:TransportBar />
                <!-- The scratch track (Q59). One button until there is one,
                     then the whole row — the same shape as the camera. -->
                <Button Content="♪ Add audio" Click="OnImportAudio"
                        IsVisible="{Binding !HasAudio}" VerticalAlignment="Center"
                        ToolTip.Tip="Import a sound file to time the animation against (WAV)" />
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasAudio}">
                  <TextBlock Text="♪" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding AudioFileName}" VerticalAlignment="Center" FontSize="11"
                             MaxWidth="140" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding AudioFileName}" />
                  <TextBlock Text="missing" IsVisible="{Binding AudioMissing}"
                             VerticalAlignment="Center" FontSize="11"
                             Foreground="{DynamicResource StatusWarningBrush}"
                             ToolTip.Tip="The referenced sound file cannot be found — the track stays, silent, until it is back" />
                  <CheckBox Content="Mute" IsChecked="{Binding AudioMuted}" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding AudioVolume}" Minimum="0" Maximum="1" Increment="0.05"
                                 FormatString="0.00" Width="64" VerticalAlignment="Center"
                                 ToolTip.Tip="Volume" />
                  <NumericUpDown Value="{Binding AudioOffsetFrames}" Minimum="-9999" Maximum="9999" Increment="1"
                                 FormatString="0" Width="60" VerticalAlignment="Center"
                                 ToolTip.Tip="The frame the sound starts on — negative trims a lead-in" />
                  <Button Content="✕" Command="{Binding RemoveAudioCommand}" VerticalAlignment="Center"
                          ToolTip.Tip="Remove the audio track (the file itself is untouched)" />
                </StackPanel>
              </controls:OverflowBar>
            </Border>
          </controls:Docker.TopBar>
          <!-- Its own horizontal scroll: the docker's content scroller is
               vertical-only, and a long scene is wider than any window. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <controls:TrackView x:Name="TimelineTrackView"
                                Tracks="{Binding TimelineTracks}"
                                AudioPeaks="{Binding TimelineAudioPeaks}"
                                AudioClips="{Binding TimelineAudioClips}"
                                VideoClips="{Binding TimelineVideoClips}"
                                FrameCount="{Binding TimelineFrameCount}"
                                FrameWidth="{Binding TimelineFrameWidth}"
                                CurrentFrame="{Binding CurrentFrameIndex, Mode=TwoWay}" />
          </ScrollViewer>
        </controls:Docker>

        <!-- The X-sheet: the exposure grid this application has always had,
             under the name the craft uses for it (Q58). -->
        <controls:Docker x:Name="XsheetDocker" PanelId="Xsheet" Title="X-sheet"
                         CloseCommand="{Binding ToggleXsheetDockerCommand}">
        <controls:Docker.TopBar>
          <Border Classes="dockerBar">
            <!-- Centred on the docker, per the owner: playback is symmetric, so
                 it reads from the middle out. When the docker narrows, the
                 Frames slider gives way first; only at its floor do controls
                 start moving into the ▾ menu — the owner's overflow rule. -->
            <controls:OverflowBar Spacing="10" HorizontalAlignment="Center"
                                  MoreLabel="More  &#x25BE;" MenuPlacement="TopEdgeAlignedRight">
              <views:TransportBar />
              <!-- Onion skin: the toggle stays on the bar because it is
                   flipped constantly; everything that is set once and left
                   alone goes behind the ⚙, so the bar does not grow a row of
                   controls nobody touches twice in a session. -->
              <CheckBox Content="Onion skin" IsChecked="{Binding OnionSkin}" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding OnionBefore}" Minimum="0" Maximum="10" Increment="1"
                             FormatString="0" Width="44" VerticalAlignment="Center"
                             ToolTip.Tip="Drawings to ghost before the playhead" />
              <NumericUpDown Value="{Binding OnionAfter}" Minimum="0" Maximum="10" Increment="1"
                             FormatString="0" Width="44" VerticalAlignment="Center"
                             ToolTip.Tip="Drawings to ghost after the playhead" />
              <Button Content="⚙" VerticalAlignment="Center" ToolTip.Tip="Onion skin settings">
                <Button.Flyout>
                  <!-- Upwards: the timeline is the bottom strip, so a flyout
                       placed below it opens off the edge of the window. -->
                  <Flyout Placement="Top">
                    <StackPanel Width="290" Spacing="8">
                      <TextBlock Text="Onion skin" FontWeight="SemiBold" FontSize="12" />

                      <ComboBox ItemsSource="{Binding OnionModeChoices}" SelectedItem="{Binding OnionMode}"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="Frames ghosts this layer's own neighbouring drawings. Light table dims the other layers at this frame instead, as sheets under the one you are drawing on." />

                      <StackPanel Spacing="8" IsVisible="{Binding !IsLightTable}">
                        <DockPanel ToolTip.Tip="Visibility of the nearest ghost">
                          <TextBlock Text="Opacity" Width="76" VerticalAlignment="Center" FontSize="12" />
                          <NumericUpDown DockPanel.Dock="Right" Value="{Binding OnionOpacity}" Minimum="0.02"
                                         Maximum="1" Increment="0.05" FormatString="0.00" MinWidth="44" />
                          <Slider Value="{Binding OnionOpacity}" Minimum="0.02" Maximum="1" Margin="4,0" />
                        </DockPanel>
                        <DockPanel ToolTip.Tip="What each further ghost is worth. 1 makes them all equally visible — right for checking registration across a sequence; 0.5 halves each one — right when drawing an inbetween.">
                          <TextBlock Text="Falloff" Width="76" VerticalAlignment="Center" FontSize="12" />
                          <NumericUpDown DockPanel.Dock="Right" Value="{Binding OnionFalloff}" Minimum="0.05"
                                         Maximum="1" Increment="0.05" FormatString="0.00" MinWidth="44" />
                          <Slider Value="{Binding OnionFalloff}" Minimum="0.05" Maximum="1" Margin="4,0" />
                        </DockPanel>

                        <CheckBox Content="Keyed drawings only" IsChecked="{Binding OnionKeysOnly}"
                                  ToolTip.Tip="Step by drawings rather than by frames — what &quot;the drawing before this one&quot; means on 2s or 3s, where the frame before is a hold of the drawing already on screen." />
                        <CheckBox Content="Draw over the current drawing" IsChecked="{Binding OnionDrawOver}"
                                  ToolTip.Tip="Under is how a lightbox works and is what you want while drawing. Over is for checking a line you have just made against the one it should match." />

                        <Grid ColumnDefinitions="76,*,8,76,*" RowDefinitions="Auto">
                          <TextBlock Grid.Column="0" Text="Before" VerticalAlignment="Center" FontSize="12" />
                          <controls:ColorField Grid.Column="1" Hex="{Binding OnionPreviousTint, Mode=TwoWay}"
                                               HorizontalAlignment="Left" />
                          <TextBlock Grid.Column="3" Text="After" VerticalAlignment="Center" FontSize="12" />
                          <controls:ColorField Grid.Column="4" Hex="{Binding OnionNextTint, Mode=TwoWay}"
                                               HorizontalAlignment="Left" />
                        </Grid>
                      </StackPanel>

                      <TextBlock Text="Ghost poses" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                      <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                                 Text="A pinned frame stays ghosted from every other frame — the extreme you are animating towards, however far away it is." />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{Binding GhostPinLabel}" Command="{Binding ToggleGhostFrameCommand}" />
                        <Button Content="Clear pins" Command="{Binding ClearGhostFramesCommand}"
                                IsEnabled="{Binding HasGhostFrames}" />
                      </StackPanel>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <!-- How many frames fit on screen. Narrow to read the timing of
                   a long scene, wide to read the thumbnails of a short one. -->
              <DockPanel VerticalAlignment="Center" controls:OverflowBar.Flex="True"
                         MinWidth="96" MaxWidth="150">
                <TextBlock DockPanel.Dock="Left" Text="Frames" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider Value="{Binding TimelineFrameWidth}" Minimum="14" Maximum="72"
                        VerticalAlignment="Center"
                        ToolTip.Tip="How wide a frame is on the timeline" />
              </DockPanel>
            </controls:OverflowBar>
          </Border>
        </controls:Docker.TopBar>

        <controls:Docker.BottomBar>
          <Border Classes="dockerBar">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="＋" Command="{Binding AddFrameCommand}" ToolTip.Tip="Add empty frame after current" />
              <Button Content="⧉" Command="{Binding DuplicateFrameCommand}" ToolTip.Tip="Duplicate current frame" />
              <Button Content="🗑" Command="{Binding DeleteFrameCommand}" ToolTip.Tip="Delete current frame" />
              <Button Content="↶" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)" />
              <Button Content="↷" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)" />
              <TextBlock Text="{Binding FrameLabel}" VerticalAlignment="Center" Margin="8,0" />
              <NumericUpDown Value="{Binding TweenCount}" Minimum="1" Maximum="9" Increment="1"
                             FormatString="0" Width="72" VerticalAlignment="Center"
                             ToolTip.Tip="Number of inbetween frames to generate" />
              <ComboBox ItemsSource="{Binding EasingChoices}" SelectedItem="{Binding TweenEasing}" Width="110" />
              <Button Content="＋ Inbetween" Command="{Binding InsertInbetweensCommand}"
                      ToolTip.Tip="Insert interpolated frames between this key and the next" />

              <!-- Timing presets. The picker and Apply are on the bar because
                   re-timing a range is something an animator does over and
                   over; saving a pattern is done once, so it lives behind the
                   ⚙ like the onion settings do. -->
              <ComboBox ItemsSource="{Binding TimingPresets}" SelectedItem="{Binding SelectedTimingPreset}"
                        Width="104" VerticalAlignment="Center"
                        ToolTip.Tip="A pattern of hold lengths. Applying it re-spaces the drawings in the selected range — it never adds or removes one."
                        DisplayMemberBinding="{Binding Name}" />
              <Button Content="Re-time" Command="{Binding ApplySelectedTimingCommand}"
                      ToolTip.Tip="Re-space the selected range (or this cel) to the chosen pattern. The row grows or shrinks to fit the pattern — no drawing is lost." />
              <Button Content="⚙" VerticalAlignment="Center" ToolTip.Tip="Save a timing pattern of your own">
                <Button.Flyout>
                  <Flyout Placement="Top">
                    <StackPanel Width="260" Spacing="8">
                      <TextBlock Text="Timing patterns" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                                 Text="Hold length per drawing, in frames. &quot;2&quot; is on 2s. &quot;1, 1, 2, 3, 4&quot; is a slow-in: two snappy frames, then progressively longer holds." />
                      <TextBox Text="{Binding NewTimingPresetName, Mode=TwoWay}"
                               PlaceholderText="Name — e.g. Studio slow-in" />
                      <TextBox Text="{Binding NewTimingPresetPattern, Mode=TwoWay}"
                               PlaceholderText="Pattern — e.g. 1, 1, 2, 3, 4" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Save" Click="OnSaveTimingPreset" />
                        <Button Content="Delete selected" Click="OnDeleteTimingPreset"
                                IsEnabled="{Binding CanDeleteTimingPreset}"
                                ToolTip.Tip="Only your own patterns can be deleted — the built-ins stay" />
                      </StackPanel>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <!-- Camera. One button until there is one, then the whole row:
                   a document that never adds a camera shows no camera UI. -->
              <Button Content="🎥 Add camera" Command="{Binding AddCameraCommand}"
                      IsVisible="{Binding !HasCamera}"
                      ToolTip.Tip="Add a shot camera — keyframed pan, zoom and roll, exported through the framing" />
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasCamera}">
                <TextBlock Text="Camera" VerticalAlignment="Center" Margin="6,0,0,0" />
                <Button Content="🔑" Command="{Binding SetCameraKeyCommand}"
                        ToolTip.Tip="Key the current framing at the playhead" />
                <Button Content="✕key" Command="{Binding ClearCameraKeyCommand}"
                        ToolTip.Tip="Remove the camera key at the playhead" />
                <NumericUpDown Value="{Binding CameraZoom}" Minimum="0.05" Maximum="64" Increment="0.1"
                               FormatString="0.00" Width="72" VerticalAlignment="Center"
                               ToolTip.Tip="Zoom at the playhead (keys as you edit)" />
                <NumericUpDown Value="{Binding CameraRotationDeg}" Minimum="-720" Maximum="720" Increment="1"
                               FormatString="0.#" Width="68" VerticalAlignment="Center"
                               ToolTip.Tip="Roll at the playhead, degrees" />
                <NumericUpDown Value="{Binding CameraOutputWidth}" Minimum="1" Maximum="16384" Increment="1"
                               FormatString="0" Width="68" VerticalAlignment="Center"
                               ToolTip.Tip="Output width" />
                <NumericUpDown Value="{Binding CameraOutputHeight}" Minimum="1" Maximum="16384" Increment="1"
                               FormatString="0" Width="68" VerticalAlignment="Center"
                               ToolTip.Tip="Output height" />
                <CheckBox Content="Through camera" IsChecked="{Binding ViewThroughCamera}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Show the canvas as the camera frames it (view only — you still draw in the world)" />
                <Button Content="🗑" Command="{Binding RemoveCameraCommand}"
                        ToolTip.Tip="Remove the camera and all its keys" />
              </StackPanel>
            </StackPanel>
          </Border>
        </controls:Docker.BottomBar>

        <!-- Ruler (scrubbable numbering, range indication) above one row per layer -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel Orientation="Vertical" Spacing="2">
            <controls:TimelineRuler x:Name="Ruler" Height="22" HorizontalAlignment="Left"
                                    LeadingInset="152"
                                    CellWidth="{Binding TimelineRulerCellWidth}"
                                    Extent="{Binding TimelineExtent}"
                                    MaxFrame="{Binding MaxScrubFrame}"
                                    CurrentFrame="{Binding CurrentFrameIndex, Mode=TwoWay}"
                                    RangeStart="{Binding PlaybackStartFrame, Mode=TwoWay}"
                                    RangeEnd="{Binding PlaybackEndFrame, Mode=TwoWay}"
                                    Markers="{Binding MarkersView}" />
            <ItemsControl ItemsSource="{Binding LayerRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LayerRow">
                  <Border Classes="layerRow" Classes.active="{Binding IsActive}"
                          Classes.hiddenLayer="{Binding !Visible}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <!-- Both explicitly centred. They looked inconsistent
                           because they were relying on the default, and ◉ and
                           👁 do not have the same metrics: an emoji glyph and a
                           geometric one centre differently inside the same
                           tile unless told not to. -->
                      <ToggleButton Classes="icon glyph eye" IsChecked="{Binding Visible}"
                                    ToolTip.Tip="Layer visibility"><Path /></ToggleButton>
                      <ToggleButton Classes="icon glyph onion" IsChecked="{Binding OnionEnabled}"
                                    ToolTip.Tip="Onion skinning for this layer"><Path /></ToggleButton>
                      <Panel Width="88" Height="{Binding $parent[Window].((vm:MainViewModel)DataContext).TimelineRowHeight}">
                        <Button Content="{Binding Name}" Width="88"
                                Height="{Binding $parent[Window].((vm:MainViewModel)DataContext).TimelineRowHeight}"
                                HorizontalContentAlignment="Left"
                                IsVisible="{Binding !IsRenaming}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ActivateLayerCommand}"
                                CommandParameter="{Binding}"
                                DoubleTapped="OnLayerNameDoubleTapped"
                                ToolTip.Tip="Click to select, double-click to rename" />
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 IsVisible="{Binding IsRenaming}" VerticalAlignment="Center"
                                 LostFocus="OnLayerNameLostFocus" KeyDown="OnLayerNameKeyDown" />
                      </Panel>
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FrameCell">
                            <Button Classes="cel"
                                    Width="{Binding $parent[Window].((vm:MainViewModel)DataContext).TimelineFrameWidth}"
                                    Height="{Binding $parent[Window].((vm:MainViewModel)DataContext).TimelineRowHeight}"
                                    Classes.current="{Binding IsCurrent}"
                                    Classes.breakdown="{Binding IsBreakdown}"
                                    Classes.tween="{Binding IsInbetween}"
                                    Classes.virtualCell="{Binding IsVirtual}"
                                    Classes.dim="{Binding OutOfRange}"
                                    Classes.sel="{Binding IsSelected}"
                                    DragDrop.AllowDrop="True"
                                    PointerMoved="OnCellPointerMoved"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectFrameCommand}"
                                    CommandParameter="{Binding}"
                                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                              <Image Source="{Binding Thumb}" Stretch="Uniform"
                                     Width="{Binding $parent[Window].((vm:MainViewModel)DataContext).TimelineThumbWidth}"
                                     Height="{Binding $parent[Window].((vm:MainViewModel)DataContext).TimelineThumbHeight}"
                                     IsVisible="{Binding IsKeyed}" />
                              <Button.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Insert frame">
                                    <MenuItem Header="Insert keyframe" Click="OnInsertKeyframe" />
                                    <MenuItem Header="Insert breakdown frame" Click="OnInsertBreakdown" />
                                    <MenuItem Header="Insert inbetween frame" Click="OnInsertInbetweenFrame" />
                                  </MenuItem>
                                  <Separator />
                                  <MenuItem Header="Extend exposure (+1 hold)" Click="OnExtendExposure" />
                                  <MenuItem Header="Reduce exposure (−1 hold)" Click="OnReduceExposure" />
                                  <!-- The pattern is chosen on the timeline bar, so this item
                                       names it rather than repeating the whole list: a submenu
                                       here would be a second picker to keep in step with the
                                       first. Shift-click a range before using it to re-time
                                       more than one drawing. -->
                                  <MenuItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).RetimeMenuLabel}"
                                            Click="OnRetimeCel"
                                            ToolTip.Tip="Re-space this cel's range to the pattern chosen on the timeline bar" />
                                  <MenuItem Header="Clear cel" Click="OnClearCel"
                                            ToolTip.Tip="Blank the drawing, keep its slot on the timeline" />
                                  <MenuItem Header="Delete cel" Click="OnDeleteCel"
                                            ToolTip.Tip="Remove the cel and pull the rest of this layer's row back" />
                                  <Separator />
                                  <MenuItem Header="Copy cel" Click="OnCopyCel" />
                                  <MenuItem Header="Cut cel" Click="OnCutCel" />
                                  <MenuItem Header="Paste cel" Click="OnPasteCel" />
                                  <Separator />
                                  <MenuItem Header="Add/edit marker…" Click="OnEditMarker" />
                                  <MenuItem Header="Remove marker" Click="OnRemoveMarker" />
                                  <Separator />
                                  <MenuItem Header="Set start frame" Click="OnSetStartFrame" />
                                  <MenuItem Header="Set end frame" Click="OnSetEndFrame" />
                                  <MenuItem Header="Clear playback range" Click="OnClearPlaybackRange" />
                                </ContextMenu>
                              </Button.ContextMenu>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </controls:Docker>

        <!-- The graph editor: value over time for the things that
             interpolate — the camera's framing, and the measured spacing of
             the active layer's drawings (Q58, the chart the stroke record
             makes possible). Camera dots drag: vertically for value,
             sideways to retime. -->
        <controls:Docker x:Name="GraphEditorDocker" PanelId="GraphEditor" Title="Graph editor"
                         CloseCommand="{Binding ToggleGraphEditorDockerCommand}">
          <controls:Docker.TopBar>
            <Border Classes="dockerBar">
              <controls:OverflowBar Spacing="10" HorizontalAlignment="Center"
                                    MoreLabel="More  &#x25BE;" MenuPlacement="TopEdgeAlignedRight">
                <views:TransportBar />
                <!-- The legend IS the series switchboard: each row toggles
                     its curve, and the swatch says which colour is whose.
                     The spacing rows read the ACTIVE layer. -->
                <ItemsControl ItemsSource="{Binding GraphLegend}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GraphLegendItem">
                      <ToggleButton IsChecked="{Binding IsShown, Mode=TwoWay}" Padding="6,2"
                                    ToolTip.Tip="Show or hide this curve. The spacing curves read the active layer.">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                  Background="{Binding Colour}" />
                          <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </controls:OverflowBar>
            </Border>
          </controls:Docker.TopBar>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <controls:GraphView x:Name="GraphEditorView"
                                Series="{Binding GraphSeriesList}"
                                FrameCount="{Binding TimelineFrameCount}"
                                FrameWidth="{Binding TimelineFrameWidth}"
                                CurrentFrame="{Binding CurrentFrameIndex, Mode=TwoWay}" />
          </ScrollViewer>
        </controls:Docker>
      </Panel>

      <!-- The drop highlight. Last child so it is over everything, and it takes
           no pointer input at all — an overlay that did would swallow the very
           moves it exists to follow. -->
      <controls:DockDropIndicator x:Name="DropIndicator" Grid.RowSpan="5" />
    <!-- Over the indicator, because the ghost is the thing in your hand and
         the highlight is the thing on the table. Neither takes the pointer. -->
    <controls:DockDragGhost x:Name="DragGhost" Grid.RowSpan="5" />
    </Grid>


  </DockPanel>
</Window>
