<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lightbox.App.ViewModels"
             xmlns:svc="using:Lightbox.App.Services"
             xmlns:core="using:Lightbox.Core.Documents"
             x:Class="Lightbox.App.Views.TextOptionsPanel"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsTextTool}">
  <!--
    Everything type has, in the Tool options docker: the same bindings as
    TextOptionsBar with room for labels, which is exactly the pair
    GuideOptionsBar and GuideOptionsPanel make.

    The two exist because the bar cannot hold all of this. The quick bar's
    fixed section — the colour pair, the preset picker, size and opacity — is
    pinned and never yields, so a five-control text group overflows into the ▾
    and an artist sees nothing. The bar therefore carries what changes
    mid-word; this carries the rest, gated on the tool alone because a docker
    has no room problem to solve.
  -->
  <StackPanel Spacing="6">
    <DockPanel>
      <TextBlock Text="Font" Width="90" VerticalAlignment="Center" FontSize="12" />
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Margin="4,0,0,0"
              ToolTip.Tip="Installed fonts are always here; Google's are fetched once and kept.">
        <Button.Content>
          <TextBlock Text="{Binding SelectedFontName}" TextTrimming="CharacterEllipsis" />
        </Button.Content>
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <StackPanel Spacing="6" Width="300">
              <TextBox Text="{Binding FontFilter}" PlaceholderText="Search fonts…" />
              <TextBlock Text="{Binding FontTrouble}" TextWrapping="Wrap" Opacity="0.75" FontSize="11"
                         IsVisible="{Binding FontTrouble, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ListBox ItemsSource="{Binding FontChoices}" SelectedItem="{Binding SelectedFont}"
                       MaxHeight="300">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="svc:FontFace">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Family}" />
                      <TextBlock Text="{Binding StyleName}" Opacity="0.6" />
                      <TextBlock Text="carries" Opacity="0.45" FontSize="10" VerticalAlignment="Center"
                                 IsVisible="{Binding Embeddable}"
                                 ToolTip.Tip="Open licence: this font can be carried inside the document, so the text stays editable on any machine." />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Size" Width="90" VerticalAlignment="Center" FontSize="12" />
      <NumericUpDown DockPanel.Dock="Right" Value="{Binding TextSize}" Minimum="1" Maximum="2000"
                     Increment="1" FormatString="0" MinWidth="44"
                     ToolTip.Tip="Em size in document pixels" />
      <Slider Value="{Binding TextSize}" Minimum="1" Maximum="400" Margin="4,0" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Tracking" Width="90" VerticalAlignment="Center" FontSize="12" />
      <NumericUpDown DockPanel.Dock="Right" Value="{Binding TextTracking}" Minimum="-500" Maximum="2000"
                     Increment="10" FormatString="0" MinWidth="44"
                     ToolTip.Tip="Letter-spacing in thousandths of an em — the unit every type specimen quotes" />
      <Slider Value="{Binding TextTracking}" Minimum="-200" Maximum="800" Margin="4,0" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Leading" Width="90" VerticalAlignment="Center" FontSize="12" />
      <NumericUpDown DockPanel.Dock="Right" Value="{Binding TextLineHeight}" Minimum="0" Maximum="2000"
                     Increment="1" FormatString="0" MinWidth="44"
                     ToolTip.Tip="Baseline to baseline in pixels. Zero leaves it to the typeface, which is what it is designed for." />
      <Slider Value="{Binding TextLineHeight}" Minimum="0" Maximum="400" Margin="4,0" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Align" Width="90" VerticalAlignment="Center" FontSize="12" />
      <ComboBox ItemsSource="{Binding TextAlignChoices}" SelectedItem="{Binding TextAlign}"
                HorizontalAlignment="Stretch" Margin="4,0,0,0"
                ToolTip.Tip="Which part of the line sits on the point you clicked">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="core:TextAlign">
            <TextBlock Text="{Binding}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </DockPanel>

    <TextBlock Text="Click to type · Esc sets it · click type again to retype"
               FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
