<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Lightbox.App.Views"
        x:Class="Lightbox.App.Views.NewProjectDialog"
        Title="New project"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space10}">
    <views:NewProjectPanel x:Name="Fields" />
    <UniformGrid x:Name="ButtonRow" Rows="1" ColumnSpacing="8" HorizontalAlignment="Right" Margin="{StaticResource SectionGap}">
      <Button Classes="tertiary" Content="Cancel" IsCancel="True" Click="OnCancelClicked"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
      <Button Classes="primary" Content="Create" IsDefault="True" Click="OnCreateClicked"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  MinWidth="{StaticResource SizeDialogButton}" />
    </UniformGrid>
  </StackPanel>
</Window>
