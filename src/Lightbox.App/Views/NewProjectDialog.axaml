<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Lightbox.App.Views"
        x:Class="Lightbox.App.Views.NewProjectDialog"
        Title="New project"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space10}">
    <views:NewProjectPanel x:Name="Fields" />
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Right" Margin="{StaticResource SectionGap}">
      <Button Classes="primary" Content="Create" IsDefault="True" Click="OnCreateClicked" MinWidth="{StaticResource SizeDialogButton}" />
      <Button Classes="tertiary" Content="Cancel" IsCancel="True" Click="OnCancelClicked" MinWidth="{StaticResource SizeDialogButton}" />
    </StackPanel>
  </StackPanel>
</Window>
