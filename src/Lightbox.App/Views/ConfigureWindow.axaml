<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Lightbox.App.Views"
        x:Class="Lightbox.App.Views.ConfigureWindow"
        Title="Configure Lightbox"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="150,1,*">

    <!-- Categories (left) -->
    <ListBox x:Name="CategoryList" Grid.Column="0" SelectedIndex="0" Background="#1c1c1c"
             SelectionChanged="OnCategoryChanged">
      <ListBoxItem Content="Shortcuts" />
      <ListBoxItem Content="Performance" />
      <ListBoxItem Content="Guides and grid" />
      <ListBoxItem Content="Timeline" />
      <ListBoxItem Content="Drawing" />
      <ListBoxItem Content="AI" />
    </ListBox>

    <Border Grid.Column="1" Background="#141414" />

    <!-- Content (center): shortcuts page -->
    <DockPanel x:Name="ShortcutsPage" Grid.Column="2" Margin="10">

      <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
               PlaceholderText="Search shortcuts by name or keys…"
               TextChanged="OnSearchChanged" Margin="0,0,0,8" />

      <!-- Conflict warning: shown before a clashing binding can be committed -->
      <Border x:Name="ConflictBar" DockPanel.Dock="Bottom" Background="#4a3320" CornerRadius="4"
              Padding="10,8" Margin="0,8,0,0" IsVisible="False">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Assign anyway" Click="OnAssignAnyway" />
            <Button Content="Cancel" Click="OnCancelAssign" />
          </StackPanel>
          <TextBlock x:Name="ConflictText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Button DockPanel.Dock="Bottom" Content="Reset all to defaults" Click="OnResetAll"
              HorizontalAlignment="Right" Margin="0,8,0,0" />

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="GroupsHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:ShortcutGroup">
              <StackPanel Spacing="2" Margin="0,0,0,12">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ShortcutRow">
                      <DockPanel Margin="0,1">
                        <Button DockPanel.Dock="Right" Content="{Binding GestureText}" MinWidth="130"
                                Click="OnCaptureClicked" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Click, then press the new key combination (Esc cancels)" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Content (center): performance page -->
    <ScrollViewer x:Name="PerformancePage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="Canvas quality while drawing" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Only changes what is drawn on screen. The document, exports and thumbnails are always full resolution. On a large canvas, presenting the image is usually costlier than editing it." />
          <ComboBox x:Name="QualityBox" Width="260" SelectionChanged="OnQualityChanged" />
          <TextBlock x:Name="QualityHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Undo history" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Brush strokes are stored as cheap deltas, but structural edits keep a copy of the whole document, so deep history costs memory on a long scene." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="UndoDepthBox" Width="120"
                           Minimum="5" Maximum="500" Increment="8" FormatString="0"
                           ValueChanged="OnUndoDepthChanged" />
            <TextBlock Text="Steps kept" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Frame cache" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Rendered frames kept in memory so scrubbing and onion skin stay instant. Raising this helps long scenes; lowering it frees memory on a large canvas." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="CacheBudgetBox" Width="120"
                           Minimum="64" Maximum="4096" Increment="64" FormatString="0"
                           ValueChanged="OnCacheBudgetChanged" />
            <TextBlock Text="Megabytes" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <Border Background="#20262c" CornerRadius="4" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Measured now" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="MeasuredText" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
            <!-- What the backend actually is, and what to do about it. Saying
                 "there is no GPU switch to throw" was true of the drawing and
                 false of the presenting, and it left the machines that fall
                 back to software with a diagnosis and no treatment. -->
            <TextBlock x:Name="BackendText" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!--
      Content (center): guides and grid.

      Here rather than in a docker because none of it is per-drawing: a grid
      pitch and a snap radius are how you like to work, and a panel that took
      a strip of screen away from everybody to hold four numbers you set once
      would be a bad trade.
    -->
    <ScrollViewer x:Name="GuidesPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="New grids" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="The pitch a grid is made with, from View ▸ Guides ▸ Add grid. Changing it never touches a grid that already exists — that one's spacing belongs to the document." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="GridSpacingBox" Width="120"
                           Minimum="1" Maximum="4096" Increment="4" FormatString="0"
                           ValueChanged="OnGridSpacingChanged" />
            <TextBlock Text="Cell size, in pixels" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Snapping" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="How close a point has to come to a guide before it is pulled onto it. Measured in document pixels, so a zoomed-in artist gets the same guides as a zoomed-out one." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="SnapToleranceBox" Width="120"
                           Minimum="0" Maximum="200" Increment="2" FormatString="0"
                           ValueChanged="OnSnapToleranceChanged" />
            <TextBlock Text="Pull distance, in pixels" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <!-- The grids on this document, if any: the one place their pitch and
             angle can be changed after the fact. -->
        <StackPanel Spacing="6">
          <TextBlock Text="Grids on this document" FontWeight="SemiBold" />
          <TextBlock x:Name="NoGridsText" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="None yet. View ▸ Guides ▸ Add grid places one." />
          <ItemsControl x:Name="GridsHost">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:GridRow">
                <Border Background="#20262c" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                    <DockPanel>
                      <NumericUpDown DockPanel.Dock="Right" Width="110"
                                     Minimum="1" Maximum="4096" Increment="4" FormatString="0"
                                     Value="{Binding Spacing, Mode=TwoWay}" />
                      <TextBlock Text="Cell size" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <NumericUpDown DockPanel.Dock="Right" Width="110"
                                     Minimum="-180" Maximum="180" Increment="5" FormatString="0.#"
                                     Value="{Binding Angle, Mode=TwoWay}" />
                      <TextBlock Text="Angle, in degrees" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <CheckBox Content="Draw it" IsChecked="{Binding Visible, Mode=TwoWay}" />
                      <CheckBox Content="Snap to it" IsChecked="{Binding Snaps, Mode=TwoWay}"
                                ToolTip.Tip="A hidden grid still snaps unless this is off" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <!-- Content (center): timeline -->
    <!--
      Drawing: preferences about how a mark is made. They are stamped into each
      stroke at paint time rather than read at render time, so nothing here can
      change art that already exists — which is what lets them live in a
      settings window instead of taking a row of the tool options bar.
    -->
    <ScrollViewer x:Name="DrawingPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="What smudge and blur read" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Smudge and blur move pixels that are already there. This decides which pixels: only the layer you are painting on, or everything you can see through it." />
          <ComboBox x:Name="SampleBox" Width="260" SelectionChanged="OnSampleSourceChanged" />
          <TextBlock x:Name="SampleHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Where the brush lives" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Whether the brush belongs to the tool or to the drawing. Come back to a comic or a set of game assets after a fortnight and the question is not which brush you like, but which brush the work is drawn with." />
          <ComboBox x:Name="BrushScopeBox" Width="260" SelectionChanged="OnBrushScopeChanged" />
          <TextBlock x:Name="BrushScopeHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!--
      Content (center): AI.

      One page for every provider rather than a page each: the fields come
      from the catalogue, so adding a service is a catalogue entry and this
      page grows a row. Test connection makes a real, tiny drawing request,
      because the ways a connection fails are mostly not reachability.
    -->
    <ScrollViewer x:Name="AiPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <CheckBox x:Name="AiEnabledBox" Content="Use AI assistance"
                    IsCheckedChanged="OnAiEnabledChanged" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="On by default. Off removes the AI bar rather than greying it out, and nothing below stops working — a provider can be set up and tested before it is switched on." />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Provider" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Who draws the inbetweens. Nothing here reaches the brush engine — an AI pass emits ordinary strokes and the document renders them like any others." />
          <ComboBox x:Name="AiProviderBox" Width="260" SelectionChanged="OnAiProviderChanged" />
          <TextBlock x:Name="AiSummary" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <ItemsControl x:Name="AiFieldsHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:AiFieldRow">
              <StackPanel Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontSize="12" />
                <TextBox Text="{Binding Value, Mode=TwoWay}"
                         PasswordChar="{Binding Mask}"
                         PlaceholderText="{Binding Placeholder}" />
                <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="6">
          <TextBlock Text="Test" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="AiTestDepthBox" Width="150" SelectionChanged="OnAiTestDepthChanged" />
            <Button x:Name="AiTestButton" Content="Test connection" Click="OnAiTestClicked" />
            <TextBlock x:Name="AiTestElapsed" VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                       IsVisible="False" />
          </StackPanel>
          <!-- Indeterminate, because nothing here can know how long a model
               will think. It is the elapsed clock beside it that answers the
               question a bar cannot: is this still going? -->
          <ProgressBar x:Name="AiTestProgress" IsIndeterminate="True" Height="4"
                       IsVisible="False" />
          <TextBlock x:Name="AiTestStatus" FontSize="11" TextWrapping="Wrap" />
          <TextBlock x:Name="AiTestExplain" TextWrapping="Wrap" FontSize="11" Opacity="0.6" />
        </StackPanel>

        <Border Background="#20262c" CornerRadius="4" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock Text="The other direction" FontWeight="SemiBold" FontSize="12" />
            <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                       Text="Lightbox is also an MCP server, so an agent you already run can open the document and draw in it directly — no provider needed here. That path and this one are independent: this page is Lightbox calling out, the server is something calling in." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="TimelinePage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="Drawing on a held cel" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="A cel that holds an earlier drawing is not a drawing of its own, so a mark on one has two honest readings. Which you mean depends on how you work." />
          <ComboBox x:Name="HoldBox" Width="260" SelectionChanged="OnHoldDrawingChanged" />
          <TextBlock x:Name="HoldHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Playback" FontWeight="SemiBold" />
          <CheckBox x:Name="LoopBox" Content="Loop" IsCheckedChanged="OnLoopChanged"
                    ToolTip.Tip="Off plays the range once and stops on its last frame" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="On by default: a cycle is usually what you are watching, and stopping after one pass means reaching for the button every time." />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Frame width" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="How wide one frame is on the timeline. Also on the timeline's own bar, where it is quicker to reach." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="FrameWidthBox" Width="120"
                           Minimum="14" Maximum="72" Increment="2" FormatString="0"
                           ValueChanged="OnFrameWidthChanged" />
            <TextBlock Text="Pixels per frame" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
