<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Lightbox.App.Views"
        x:Class="Lightbox.App.Views.ConfigureWindow"
        Title="Configure Lightbox"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="150,1,*">

    <!-- Categories (left) -->
    <ListBox x:Name="CategoryList" Grid.Column="0" SelectedIndex="0" Background="#1c1c1c">
      <ListBoxItem Content="Shortcuts" />
    </ListBox>

    <Border Grid.Column="1" Background="#141414" />

    <!-- Content (center): shortcuts page -->
    <DockPanel Grid.Column="2" Margin="10">

      <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
               PlaceholderText="Search shortcuts by name or keys…"
               TextChanged="OnSearchChanged" Margin="0,0,0,8" />

      <!-- Conflict warning: shown before a clashing binding can be committed -->
      <Border x:Name="ConflictBar" DockPanel.Dock="Bottom" Background="#4a3320" CornerRadius="4"
              Padding="10,8" Margin="0,8,0,0" IsVisible="False">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Assign anyway" Click="OnAssignAnyway" />
            <Button Content="Cancel" Click="OnCancelAssign" />
          </StackPanel>
          <TextBlock x:Name="ConflictText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Button DockPanel.Dock="Bottom" Content="Reset all to defaults" Click="OnResetAll"
              HorizontalAlignment="Right" Margin="0,8,0,0" />

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="GroupsHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:ShortcutGroup">
              <StackPanel Spacing="2" Margin="0,0,0,12">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ShortcutRow">
                      <DockPanel Margin="0,1">
                        <Button DockPanel.Dock="Right" Content="{Binding GestureText}" MinWidth="130"
                                Click="OnCaptureClicked" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Click, then press the new key combination (Esc cancels)" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
