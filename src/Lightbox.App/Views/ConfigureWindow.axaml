<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Lightbox.App.Views"
        x:Class="Lightbox.App.Views.ConfigureWindow"
        Title="Configure Lightbox"
        Icon="/Assets/lightbox.ico"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="150,1,*">

    <!-- Categories (left) -->
    <ListBox x:Name="CategoryList" Grid.Column="0" SelectedIndex="0" Background="{StaticResource BackgroundSecondaryBrush}"
             SelectionChanged="OnCategoryChanged">
      <ListBoxItem Content="Shortcuts" />
      <ListBoxItem Content="Performance" />
      <ListBoxItem Content="Features" />
      <ListBoxItem Content="Guides and grid" />
      <ListBoxItem Content="Timeline" />
      <ListBoxItem Content="Drawing" />
      <ListBoxItem Content="Export" />
      <ListBoxItem Content="Library" />
      <ListBoxItem Content="AI" />
    </ListBox>

    <Border Grid.Column="1" Background="{StaticResource BackgroundPrimaryBrush}" />

    <!-- Content (center): shortcuts page -->
    <DockPanel x:Name="ShortcutsPage" Grid.Column="2" Margin="10">

      <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
               PlaceholderText="Search shortcuts by name or keys…"
               TextChanged="OnSearchChanged" Margin="0,0,0,8" />

      <!-- Conflict warning: shown before a clashing binding can be committed -->
      <Border x:Name="ConflictBar" DockPanel.Dock="Bottom" Background="{StaticResource StatusWarningSurfaceBrush}" CornerRadius="4"
              Padding="10,8" Margin="0,8,0,0" IsVisible="False">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Assign anyway" Click="OnAssignAnyway" />
            <Button Content="Cancel" Click="OnCancelAssign" />
          </StackPanel>
          <TextBlock x:Name="ConflictText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Button DockPanel.Dock="Bottom" Content="Reset all to defaults" Click="OnResetAll"
              HorizontalAlignment="Right" Margin="0,8,0,0" />

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="GroupsHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:ShortcutGroup">
              <StackPanel Spacing="2" Margin="0,0,0,12">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding Hint}" FontSize="11" Opacity="0.6"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ShortcutRow">
                      <DockPanel Margin="0,1">
                        <Button DockPanel.Dock="Right" Content="{Binding GestureText}" MinWidth="130"
                                Click="OnCaptureClicked" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Click, then press the new key combination (Esc cancels)" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Content (center): performance page -->
    <ScrollViewer x:Name="PerformancePage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="Canvas quality while drawing" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Only changes what is drawn on screen. The document, exports and thumbnails are always full resolution. On a large canvas, presenting the image is usually costlier than editing it." />
          <ComboBox x:Name="QualityBox" Width="260" SelectionChanged="OnQualityChanged" />
          <TextBlock x:Name="QualityHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Canvas quality during playback" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="A still drawing rewards sharpness; a running animation rewards frame rate. Lowering this keeps the canvas crisp while you draw and composites smaller frames only while a scene plays." />
          <ComboBox x:Name="PlaybackQualityBox" Width="260" SelectionChanged="OnPlaybackQualityChanged" />
          <TextBlock x:Name="PlaybackQualityHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Undo history" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Brush strokes are stored as cheap deltas, but structural edits keep a copy of the whole document, so deep history costs memory on a long scene." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="UndoDepthBox" Width="120"
                           Minimum="5" Maximum="500" Increment="8" FormatString="0"
                           ValueChanged="OnUndoDepthChanged" />
            <TextBlock Text="Steps kept" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Frame cache" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Rendered frames kept in memory so scrubbing and onion skin stay instant. Raising this helps long scenes; lowering it frees memory on a large canvas." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="CacheBudgetBox" Width="120"
                           Minimum="64" Maximum="4096" Increment="64" FormatString="0"
                           ValueChanged="OnCacheBudgetChanged" />
            <TextBlock Text="Megabytes" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Composite layers on the GPU" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Experimental, and off because it is not yet known to be faster. Blending layers on the graphics card should help most on a large canvas with many layers — but the layer images have to reach the card first, and on a laptop with shared graphics memory that transfer competes with the drawing itself. It may be slower. Switch it on, play a scene back, then write a render report to see what it did on this machine." />
          <CheckBox x:Name="GpuCompositeBox" Content="Use the graphics card to blend layers"
                    IsCheckedChanged="OnGpuCompositeChanged" />
          <TextBlock x:Name="GpuCompositeHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="4" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock Text="Measured now" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="MeasuredText" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
            <!-- What the backend actually is, and what to do about it. Saying
                 "there is no GPU switch to throw" was true of the drawing and
                 false of the presenting, and it left the machines that fall
                 back to software with a diagnosis and no treatment. -->
            <TextBlock x:Name="BackendText" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!--
      Content (center): guides and grid.

      Here rather than in a docker because none of it is per-drawing: a grid
      pitch and a snap radius are how you like to work, and a panel that took
      a strip of screen away from everybody to hold four numbers you set once
      would be a bad trade.
    -->

    <!-- Features page -->
    <ScrollViewer x:Name="FeaturesPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="Document features" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Toggle features available in this document. Changes are saved with the document." />
        </StackPanel>

        <ItemsControl x:Name="FeaturesHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:FeatureToggleRow">
              <DockPanel Margin="0,4">
                <CheckBox DockPanel.Dock="Right"
                          IsChecked="{Binding IsEnabled}"
                          VerticalAlignment="Center" />
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="GuidesPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="New grids" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="The pitch a grid is made with, from View ▸ Guides ▸ Add grid. Changing it never touches a grid that already exists — that one's spacing belongs to the document." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="GridSpacingBox" Width="120"
                           Minimum="1" Maximum="4096" Increment="4" FormatString="0"
                           ValueChanged="OnGridSpacingChanged" />
            <TextBlock Text="Cell size, in pixels" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="New vanishing points" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="How many rays a vanishing point is drawn with. Fewer to see the drawing through it, more to read the perspective — the point constrains every direction either way. A placed one is changed with the Move tool." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="VanishingPointRaysBox" Width="120"
                           Minimum="2" Maximum="180" Increment="2" FormatString="0"
                           ValueChanged="OnVanishingPointRaysChanged" />
            <TextBlock Text="Rays" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="New character height scales" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="What a new height scale stands at. The height is a share of the canvas rather than a pixel count, so the same default reads as a figure on any size of scene." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="HeightScaleHeadsBox" Width="120"
                           Minimum="1" Maximum="32" Increment="1" FormatString="0"
                           ValueChanged="OnHeightScaleHeadsChanged" />
            <TextBlock Text="Heads tall" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="HeightScaleFillBox" Width="120"
                           Minimum="5" Maximum="100" Increment="5" FormatString="0"
                           ValueChanged="OnHeightScaleFillChanged" />
            <TextBlock Text="Share of the canvas height, in percent" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Snapping" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="How close a point has to come to a guide before it is pulled onto it. Measured in document pixels, so a zoomed-in artist gets the same guides as a zoomed-out one." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="SnapToleranceBox" Width="120"
                           Minimum="0" Maximum="200" Increment="2" FormatString="0"
                           ValueChanged="OnSnapToleranceChanged" />
            <TextBlock Text="Pull distance, in pixels" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <!-- The grids on this document, if any: the one place their pitch and
             angle can be changed after the fact. -->
        <StackPanel Spacing="6">
          <TextBlock Text="Grids on this document" FontWeight="SemiBold" />
          <TextBlock x:Name="NoGridsText" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="None yet. View ▸ Guides ▸ Add grid places one." />
          <ItemsControl x:Name="GridsHost">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:GridRow">
                <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                    <DockPanel>
                      <NumericUpDown DockPanel.Dock="Right" Width="110"
                                     Minimum="1" Maximum="4096" Increment="4" FormatString="0"
                                     Value="{Binding Spacing, Mode=TwoWay}" />
                      <TextBlock Text="Cell size" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <NumericUpDown DockPanel.Dock="Right" Width="110"
                                     Minimum="-180" Maximum="180" Increment="5" FormatString="0.#"
                                     Value="{Binding Angle, Mode=TwoWay}" />
                      <TextBlock Text="Angle, in degrees" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <CheckBox Content="Draw it" IsChecked="{Binding Visible, Mode=TwoWay}" />
                      <CheckBox Content="Snap to it" IsChecked="{Binding Snaps, Mode=TwoWay}"
                                ToolTip.Tip="A hidden grid still snaps unless this is off" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- The height scales on this document, if any: proportions after the
             fact, the way the grids above get their pitch. -->
        <StackPanel Spacing="6">
          <TextBlock Text="Height scales on this document" FontWeight="SemiBold" />
          <TextBlock x:Name="NoHeightScalesText" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="None yet. View ▸ Guides ▸ Add character height scale places one." />
          <ItemsControl x:Name="HeightScalesHost">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:HeightScaleRow">
                <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                    <DockPanel>
                      <NumericUpDown DockPanel.Dock="Right" Width="110"
                                     Minimum="1" Maximum="4096" Increment="2" FormatString="0.#"
                                     Value="{Binding Unit, Mode=TwoWay}" />
                      <TextBlock Text="One head, in pixels" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel>
                      <NumericUpDown DockPanel.Dock="Right" Width="110"
                                     Minimum="1" Maximum="32" Increment="1" FormatString="0"
                                     Value="{Binding Divisions, Mode=TwoWay}" />
                      <TextBlock Text="Heads tall" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <CheckBox Content="Draw it" IsChecked="{Binding Visible, Mode=TwoWay}" />
                      <CheckBox Content="Snap to it" IsChecked="{Binding Snaps, Mode=TwoWay}"
                                ToolTip.Tip="A hidden scale still snaps unless this is off" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <!-- Content (center): timeline -->
    <!--
      Drawing: preferences about how a mark is made. They are stamped into each
      stroke at paint time rather than read at render time, so nothing here can
      change art that already exists — which is what lets them live in a
      settings window instead of taking a row of the tool options bar.
    -->
    <ScrollViewer x:Name="DrawingPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="What smudge and blur read" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Smudge and blur move pixels that are already there. This decides which pixels: only the layer you are painting on, or everything you can see through it." />
          <ComboBox x:Name="SampleBox" Width="260" SelectionChanged="OnSampleSourceChanged" />
          <TextBlock x:Name="SampleHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Fonts" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="The text tool always offers the fonts installed on this machine. Google Fonts adds a few thousand more that look the same everywhere and are licensed to be passed around." />
          <CheckBox x:Name="GoogleFontsBox" Content="Offer Google Fonts beside the installed ones"
                    IsCheckedChanged="OnGoogleFontsChanged" />
          <TextBlock Text="Nothing is requested until you open the font list, and each font is fetched once and kept. Turn this off and Lightbox never contacts fonts.google.com at all."
                     FontSize="10" Opacity="0.65" TextWrapping="Wrap" />
          <CheckBox x:Name="EmbedFontsBox" Content="Carry open-licensed fonts inside documents that use them"
                    IsCheckedChanged="OnEmbedFontsChanged" />
          <TextBlock Text="Text is drawn as outlines the moment you set it, so a document always renders correctly with no fonts installed. Carrying the font is what lets somebody else retype the words. Only fonts whose licence permits it are ever carried — never one installed on this machine, whose terms Lightbox cannot read."
                     FontSize="10" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="What a stroke records from the pen" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Pressure is always recorded. Tilt and speed are recorded whenever the brush you are drawing with uses them, and left out when it does not — so a drawing stays exactly as small as it needs to be." />
          <CheckBox x:Name="RecordPenAxesBox" Content="Always record tilt and speed, even when the brush ignores them"
                    IsCheckedChanged="OnRecordPenAxesChanged" />
          <TextBlock Text="Switch this on to keep the numbers for later: a stroke can then be given a tilt or speed curve months after it was drawn and will respond to it. Left off, adding that curve does nothing, because the pen's tilt was never stored. It roughly doubles the size of a drawing."
                     FontSize="10" Opacity="0.65" TextWrapping="Wrap" />
          <TextBlock Text="Turning this off later leaves finished drawings alone — the strokes that recorded tilt keep it."
                     FontSize="10" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Where the brush lives" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Whether the brush belongs to the tool or to the drawing. Come back to a comic or a set of game assets after a fortnight and the question is not which brush you like, but which brush the work is drawn with." />
          <ComboBox x:Name="BrushScopeBox" Width="260" SelectionChanged="OnBrushScopeChanged" />
          <TextBlock x:Name="BrushScopeHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!--
      Content (center): AI.

      One page for every provider rather than a page each: the fields come
      from the catalogue, so adding a service is a catalogue entry and this
      page grows a row. Test connection makes a real, tiny drawing request,
      because the ways a connection fails are mostly not reachability.
    -->
    <ScrollViewer x:Name="AiPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <CheckBox x:Name="AiEnabledBox" Content="Use AI assistance"
                    IsCheckedChanged="OnAiEnabledChanged" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="On by default. Off removes the AI bar rather than greying it out, and nothing below stops working — a provider can be set up and tested before it is switched on." />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Provider" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Who draws the inbetweens. Nothing here reaches the brush engine — an AI pass emits ordinary strokes and the document renders them like any others." />
          <ComboBox x:Name="AiProviderBox" Width="260" SelectionChanged="OnAiProviderChanged" />
          <TextBlock x:Name="AiSummary" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <ItemsControl x:Name="AiFieldsHost">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:AiFieldRow">
              <StackPanel Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontSize="12" />
                <TextBox Text="{Binding Value, Mode=TwoWay}"
                         PasswordChar="{Binding Mask}"
                         PlaceholderText="{Binding Placeholder}" />
                <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}"
                           FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="6">
          <TextBlock Text="Test" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="AiTestDepthBox" Width="150" SelectionChanged="OnAiTestDepthChanged" />
            <Button x:Name="AiTestButton" Content="Test connection" Click="OnAiTestClicked" />
            <TextBlock x:Name="AiTestElapsed" VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                       IsVisible="False" />
          </StackPanel>
          <!-- Indeterminate, because nothing here can know how long a model
               will think. It is the elapsed clock beside it that answers the
               question a bar cannot: is this still going? -->
          <ProgressBar x:Name="AiTestProgress" IsIndeterminate="True" Height="4"
                       IsVisible="False" />
          <TextBlock x:Name="AiTestStatus" FontSize="11" TextWrapping="Wrap" />
          <TextBlock x:Name="AiTestExplain" TextWrapping="Wrap" FontSize="11" Opacity="0.6" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Grade this model" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="A connection test says the model answers. This says what it can do: a committed set of keyframe pairs, scored by the same checks that judge its real work, reported as numbers rather than a pass mark. The one worth reading is where it stops coping with stroke count." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="AiRunSizeBox" Width="150" SelectionChanged="OnAiRunSizeChanged" />
            <Button x:Name="AiProfileButton" Content="Grade this model" Click="OnAiProfileClicked" />
            <TextBlock x:Name="AiProfileElapsed" VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                       IsVisible="False" />
          </StackPanel>
          <!-- The cost before it is spent, not after. Following the brush
               rule: the expensive option is available, deliberate, and badged
               so the trade is made knowingly. -->
          <TextBlock x:Name="AiRunCost" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
          <ProgressBar x:Name="AiProfileProgress" IsIndeterminate="True" Height="4"
                       IsVisible="False" />
          <TextBlock x:Name="AiProfileStatus" FontSize="11" TextWrapping="Wrap" />
          <Border x:Name="AiProfileResult" Background="{StaticResource SurfaceElevatedBrush}"
                  CornerRadius="4" Padding="10" IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock x:Name="AiProfileWhen" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
              <TextBlock x:Name="AiProfileStale" FontSize="11" TextWrapping="Wrap"
                         Foreground="Goldenrod" IsVisible="False" />
              <ItemsControl x:Name="AiProfileLines">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="4" Padding="10">
          <StackPanel Spacing="4">
            <TextBlock Text="The other direction" FontWeight="SemiBold" FontSize="12" />
            <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                       Text="Lightbox is also an MCP server, so an agent you already run can open the document and draw in it directly — no provider needed here. That path and this one are independent: this page is Lightbox calling out, the server is something calling in." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="TimelinePage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="Drawing on a held cel" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="A cel that holds an earlier drawing is not a drawing of its own, so a mark on one has two honest readings. Which you mean depends on how you work." />
          <ComboBox x:Name="HoldBox" Width="260" SelectionChanged="OnHoldDrawingChanged" />
          <TextBlock x:Name="HoldHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Playback" FontWeight="SemiBold" />
          <CheckBox x:Name="LoopBox" Content="Loop" IsCheckedChanged="OnLoopChanged"
                    ToolTip.Tip="Off plays the range once and stops on its last frame" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="On by default: a cycle is usually what you are watching, and stopping after one pass means reaching for the button every time." />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="The X-sheet and the Timeline" FontWeight="SemiBold" />
          <CheckBox x:Name="OffSheetKeyBox" Content="Mark frames where the camera or a bone is keyed"
                    IsCheckedChanged="OnMarkOffSheetKeysChanged"
                    ToolTip.Tip="A small orange or blue square under the X-sheet's frame number, in the Timeline's own track colours" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="The X-sheet is the exposure sheet: it shows ink and when it is exposed, which is why camera moves and bone poses live on the Timeline instead. Off by default — turn it on when you want the sheet to tell you that something happens on a frame it cannot draw." />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="The rig during playback" FontWeight="SemiBold" />
          <CheckBox x:Name="AnimateRigBox" Content="Show the bones while the animation plays"
                    IsCheckedChanged="OnAnimateRigChanged"
                    ToolTip.Tip="Off, the bones are hidden while playing; on, they follow the playhead with everything else" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Playback is for watching the animation, so the rig gets out of the way by default. Turn it on when what you are checking is the rig itself — whether a limb reads through the movement." />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Frame width" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="How wide one frame is on the timeline. Also on the timeline's own bar, where it is quicker to reach." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="FrameWidthBox" Width="120"
                           Minimum="14" Maximum="72" Increment="2" FormatString="0"
                           ValueChanged="OnFrameWidthChanged" />
            <TextBlock Text="Pixels per frame" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Volume check" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="View ▸ Volume and balance check measures the active layer's ink per frame. A frame is flagged when its area drifts further than this from the shot's median — squash and stretch preserves volume, so drift past taste is off-model." />
          <DockPanel>
            <NumericUpDown DockPanel.Dock="Right" x:Name="VolumeToleranceBox" Width="120"
                           Minimum="1" Maximum="100" Increment="1" FormatString="0"
                           ValueChanged="OnVolumeToleranceChanged" />
            <TextBlock Text="Allowed drift, percent" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ExportPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="Export when an asset is done" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Finish an asset, set its status in the Project panel, and the sheet and its sidecar land where your engine is already looking. Nobody has to remember to export — and the export nobody remembered is the one that makes a designer think you have not started." />
          <CheckBox x:Name="AutoExportBox" Content="Export automatically on a status change"
                    IsCheckedChanged="OnAutoExportChanged" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6"
                     Text="Off by default, because this writes files into another project on a click. The status change is always saved first: if the folder is missing or your engine has the file locked, you keep the status and get a message." />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Which status fires it" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Ready by default. A studio that reviews in engine wants Review instead — when the engine should see an asset is a question about your pipeline, not ours." />
          <ComboBox x:Name="AutoExportStatusBox" Width="260"
                    SelectionChanged="OnAutoExportStatusChanged" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Export preset" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="The same presets the export window uses. Save one there and it appears here." />
          <ComboBox x:Name="AutoExportPresetBox" Width="260"
                    SelectionChanged="OnAutoExportPresetChanged" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Output folder" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Where the files go. An absolute path, or one relative to the project folder — ../Game/Assets/Sprites keeps the whole thing portable." />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseAutoExportFolder"
                    Margin="6,0,0,0" />
            <TextBox x:Name="AutoExportFolderBox"
                     PlaceholderText="e.g. ../Game/Assets/Sprites"
                     LostFocus="OnAutoExportFolderChanged" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="LibraryPage" Grid.Column="2" Margin="14" IsVisible="False"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="Character libraries" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                     Text="Where shared characters live on this machine. A library is an ordinary project whose type is Asset library — point this at one, or at a folder holding several. The import button on the project panel and the library window read from these folders; nothing is scanned until one of them opens." />
          <ListBox x:Name="LibraryRootsList" MaxHeight="160" FontSize="11" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="text" Content="Add folder…" Click="OnLibraryAddRoot" />
            <Button Classes="text" Content="Remove" Click="OnLibraryRemoveRoot" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6"
                     Text="The same list the library window edits — a setting of the machine, kept across sessions and shared by every project." />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
