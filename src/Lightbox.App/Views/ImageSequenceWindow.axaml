<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lightbox.App.ViewModels"
        xmlns:doc="using:Lightbox.Core.Documents"
        x:Class="Lightbox.App.Views.ImageSequenceWindow"
        x:DataType="vm:ImageSequenceDialogViewModel"
        Width="{StaticResource SizeDialogWidth}" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Export image sequence">

  <!--
    Every row is its own two-column grid inside a stack, rather than a row of
    one shared grid. A grid keeps a hidden row's spacing — hide Quality between
    Format and Size and the gap there is 16 where every other is 8 — and a
    stack does not. AHiddenRowLeavesNoGapWhereItWas measures it.
  -->
  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space12}">

    <!-- What each file is. -->
    <StackPanel Spacing="{StaticResource Space8}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Format" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="FormatBox"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Formats}"
                  SelectedItem="{Binding Format}" />
      </Grid>

      <!-- Hidden rather than disabled on PNG: the format has no such setting. -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasQuality}">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Quality" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1"
                       Value="{Binding Quality}" Minimum="1" Maximum="100" Increment="5"
                       FormatString="0" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Size %" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" x:Name="SizeBox"
                       Value="{Binding ScalePercent}" Minimum="1" Maximum="1600" Increment="25"
                       FormatString="0" />
      </Grid>
    </StackPanel>

    <Separator />

    <!-- Which frames. Counted from one, as the timeline shows them. -->
    <StackPanel Spacing="{StaticResource Space8}">
      <!-- Only on a document that has tags; an empty picker is a control that does nothing. -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasTags}">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Tag" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="TagBox"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Tags}"
                  SelectedItem="{Binding SelectedTag}"
                  PlaceholderText="Fill the range from a tag"
                  DisplayMemberBinding="{Binding Name, DataType=doc:AnimationTag}" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Frames" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" x:Name="FromBox"
                       Value="{Binding FromFrame}" Minimum="1" Maximum="{Binding LastFrame}"
                       Increment="1" FormatString="0" />
        <TextBlock Grid.Column="2" Text="to" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="3" x:Name="ToBox"
                       Value="{Binding ToFrame}" Minimum="1" Maximum="{Binding LastFrame}"
                       Increment="1" FormatString="0" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Every" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" x:Name="StepBox"
                       Value="{Binding Step}" Minimum="1" Maximum="{Binding LastFrame}"
                       Increment="1" FormatString="0"
                       ToolTip.Tip="1 writes every frame of the range, 2 every second one, and so on" />
      </Grid>

      <CheckBox x:Name="UniqueBox" IsChecked="{Binding UniqueOnly}"
                Content="Unique frames only"
                ToolTip.Tip="A drawing held for several frames is written once, and a timing file beside the pictures says how long each one holds" />
    </StackPanel>

    <Separator />

    <!-- What the files are called. -->
    <StackPanel Spacing="{StaticResource Space8}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Name" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="PrefixBox" Text="{Binding Prefix}" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Digits" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1"
                       Value="{Binding Digits}" Minimum="1" Maximum="10" Increment="1" FormatString="0" />
      </Grid>

      <!-- Absent while the timeline does the numbering: the two answer the same question. -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasStartNumber}">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Start at" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1"
                       Value="{Binding StartNumber}" Minimum="0" Maximum="999999" Increment="1"
                       FormatString="0" />
      </Grid>

      <CheckBox x:Name="TimelineNumbersBox" IsChecked="{Binding TimelineNumbers}"
                Content="Number files by their frame on the timeline"
                ToolTip.Tip="A file keeps the number of the frame it sits on, so a held drawing leaves a gap and an excerpt overwrites the same files a full export wrote" />
    </StackPanel>

    <Separator />

    <!-- The paper: left out where the format can show it, filled in where it cannot. -->
    <CheckBox x:Name="TransparentPaperBox" IsChecked="{Binding TransparentPaper}"
              IsVisible="{Binding OffersTransparentPaper}"
              Content="Leave the paper out"
              ToolTip.Tip="Frames are written with a see-through background. This export only — the document keeps its paper." />

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasMatte}">
      <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Fill with" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Matte}" />
    </Grid>

    <Border x:Name="TransparencyWarning" Classes="notice warning" IsVisible="{Binding MayLoseTransparency}">
      <TextBlock TextWrapping="Wrap"
                 Text="This format has no transparency. The see-through areas will be filled in — export as PNG or WebP to keep them." />
    </Border>

    <Border Background="{DynamicResource SurfaceElevated}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
    </Border>

    <!--
      A uniform grid: both buttons take the width of the wider one. A MinWidth alone leaves "Export…" wider
      than "Cancel", which is the pair the design system says must match.
    -->
    <UniformGrid x:Name="ButtonRow" Rows="1" ColumnSpacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Classes="tertiary" Content="Cancel"
              Click="OnCancel" IsCancel="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              MinWidth="{StaticResource SizeDialogButton}" />
      <Button x:Name="ExportButton" Classes="primary" Content="Export…"
              Click="OnApply" IsDefault="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              MinWidth="{StaticResource SizeDialogButton}" />
    </UniformGrid>
  </StackPanel>
</Window>
