<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lightbox.App.Views.ExportWindow"
        Title="Export"
        Icon="/Assets/lightbox.ico"
        Width="440" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space10}">

    <!-- The preset row first, because the whole point of this window is that an
         artist visits it once per project and presses Export after that. -->
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
      <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Preset" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="PresetBox" HorizontalAlignment="Stretch"
                SelectionChanged="OnPresetChanged" />
      <Button Grid.Column="2" Classes="text" Content="Delete" x:Name="DeletePresetButton"
              Click="OnDeletePreset"
              ToolTip.Tip="Only your own presets. The built-in three cannot be deleted." />
    </Grid>

    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
      <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Save as" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="PresetNameBox"
               PlaceholderText="Name — e.g. Knight atlas"
               ToolTip.Tip="Keep these settings under a name, so the next export is one click." />
      <Button Grid.Column="2" Classes="text" Content="Save" Click="OnSavePreset" />
    </Grid>

    <Separator />

    <!--
      A stack of rows, each its own grid, and the code-behind hides a ROW. As
      one grid with row spacing, hiding a row's two controls left its spacing
      behind: 24 px between Trim and Background on a strip, and 32 px of
      nothing under Format on a PNG sequence.
    -->
    <StackPanel x:Name="SheetRows" Spacing="{StaticResource Space8}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Format" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="TargetBox" HorizontalAlignment="Stretch"
                  SelectionChanged="OnTargetChanged" />
      </Grid>

      <Grid x:Name="TrimRow" ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Trim" VerticalAlignment="Center" x:Name="TrimLabel" />
        <ComboBox Grid.Column="1" x:Name="TrimBox" HorizontalAlignment="Stretch" />
      </Grid>

      <Grid x:Name="PackRow" ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Layout" VerticalAlignment="Center" x:Name="PackLabel" />
        <ComboBox Grid.Column="1" x:Name="PackBox" HorizontalAlignment="Stretch" />
      </Grid>

      <Grid x:Name="PaddingRow" ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Padding" VerticalAlignment="Center" x:Name="PaddingLabel" />
        <TextBox Grid.Column="1" x:Name="PaddingBox" Width="{StaticResource SizeDialogField}"
                 HorizontalAlignment="Left"
                 ToolTip.Tip="Transparent gutter around each cell, in pixels. Stops an engine's bilinear filtering bleeding one sprite into the next." />
      </Grid>

      <Grid x:Name="BackgroundRow" ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Background" VerticalAlignment="Center" x:Name="BackgroundLabel" />
        <ComboBox Grid.Column="1" x:Name="BackgroundBox" HorizontalAlignment="Stretch" />
      </Grid>
    </StackPanel>

    <TextBlock x:Name="BackgroundHint" TextWrapping="Wrap" FontSize="{StaticResource TypeHint}" Opacity="0.6" />

    <StackPanel x:Name="NormalPanel" Spacing="{StaticResource Space6}">
      <CheckBox x:Name="NormalMapBox" Content="Also write a normal map"
                IsCheckedChanged="OnNormalMapChanged"
                ToolTip.Tip="A tangent-space normal map beside the sheet, as &lt;name&gt;_normal.png, so an engine can light the sprite." />
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowSpacing="6"
            RowDefinitions="Auto,Auto,Auto" x:Name="NormalRows">
        <TextBlock Grid.Row="0" Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Bevel" VerticalAlignment="Center" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space6}">
          <TextBox x:Name="BevelBox" Width="{StaticResource SizeDialogField}" />
          <TextBlock Text="px in from the edge" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Strength" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NormalStrengthBox" Width="{StaticResource SizeDialogField}"
                 HorizontalAlignment="Left" />

        <TextBlock Grid.Row="2" Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Green points" VerticalAlignment="Center" />
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="GreenBox" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Get this backwards and lighting looks inverted — every bevel reads as a groove. Unity wants OpenGL; Unreal wants DirectX." />
      </Grid>
    </StackPanel>

    <!-- Unity only. Absent rather than disabled: a control that does nothing
         teaches an artist that the controls lie. -->
    <StackPanel x:Name="EnginePanel" Spacing="{StaticResource Space8}" IsVisible="False">
      <Separator />
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Width="{StaticResource SizeDialogLabel}" Text="Canvas height" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space6}">
          <TextBox x:Name="WorldHeightBox" Width="{StaticResource SizeDialogField}" />
          <!-- Metres, not "world units": Unity's unit is a metre and Unreal's is a
               centimetre, so the only unambiguous label is a real-world one. -->
          <TextBlock Text="metres tall" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
      </Grid>
      <CheckBox x:Name="WriteImporterBox"
                Content="Write the Unity importer script beside the sheet"
                ToolTip.Tip="Never overwritten once it is there — you may have adjusted it." />
      <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TypeHint}" Opacity="0.6"
                 Text="Needs Unity's 2D Sprite package, which every 2D template has. Lightbox never writes a .meta file — Unity owns those." />
    </StackPanel>

    <Separator />

    <!--
      A uniform grid, so both buttons take the width of the wider label; a
      MinWidth alone leaves them different. Dismissing is the quiet one.
      DialogGeometryTests measures the pair.
    -->
    <UniformGrid x:Name="ButtonRow" Rows="1" ColumnSpacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Classes="tertiary" Content="Cancel" Click="OnCancel" IsCancel="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              MinWidth="{StaticResource SizeDialogButton}" />
      <Button x:Name="ExportButton" Classes="primary" Content="Export…" Click="OnExport" IsDefault="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              MinWidth="{StaticResource SizeDialogButton}" />
    </UniformGrid>
  </StackPanel>
</Window>
