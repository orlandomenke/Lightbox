<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lightbox.App.ViewModels"
        x:Class="Lightbox.App.Views.SaveImageDialog"
        x:DataType="vm:SaveImageDialogViewModel"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Save as image">

  <StackPanel Margin="{StaticResource DialogPadding}" Spacing="{StaticResource Space12}">

    <!--
      Each row is its own grid inside a stack, not a row of one shared grid: a
      grid keeps the spacing of a row whose contents are hidden, so with Quality
      hidden on PNG the gap between Format and Size was 16 where every other gap
      is 8. A stack spaces only what is visible.
    -->
    <StackPanel Spacing="{StaticResource Space8}">
      <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Format" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="FormatBox"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Formats}"
                  SelectedItem="{Binding Format}" />
      </Grid>

      <!--
        Hidden rather than disabled on PNG, the rule the export window already
        follows: a greyed slider invites a click that does nothing, where an
        absent one says the format has no such setting.
      -->
      <Grid ColumnDefinitions="120,*" ColumnSpacing="8" IsVisible="{Binding HasQuality}">
        <TextBlock Grid.Column="0" Text="Quality" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" x:Name="QualityBox"
                       Value="{Binding Quality}" Minimum="1" Maximum="100" Increment="5"
                       FormatString="0" />
      </Grid>

      <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Size %" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" x:Name="SizeBox"
                       Value="{Binding ScalePercent}" Minimum="1" Maximum="1600" Increment="25"
                       FormatString="0" />
      </Grid>
    </StackPanel>

    <!--
      Only shown for a format with nowhere to put alpha, and it is here because
      the plumbing existed with no control bound to it — which is the "the feature
      works and the artist cannot change it" failure, not a saving.
    -->
    <Grid ColumnDefinitions="120,*" ColumnSpacing="8" IsVisible="{Binding !KeepsTransparency}">
      <TextBlock Grid.Column="0" Text="Fill with" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Text="{Binding Matte}" />
    </Grid>

    <!--
      The warning the roadmap item asked for, in front of the save rather than
      after it: a character saved as JPEG comes back on a solid box, and an
      artist who learns that later has already sent the file somewhere.

      It reads the format chosen *here*, so it cannot see one the file picker
      forces afterwards by its extension — type "cover.jpg" over a PNG default
      and this banner never appears. That case is not silent, it is just late:
      ImageSaveResult measures what actually happened from the rendered pixels
      and the status line says so. Typing the extension is the deliberate act,
      which is why it is allowed to win rather than being second-guessed here.
    -->
    <Border Background="{DynamicResource SurfaceElevated}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}"
            IsVisible="{Binding MayLoseTransparency}">
      <TextBlock TextWrapping="Wrap"
                 Text="This format has no transparency. The see-through areas will be filled in — save as PNG or WebP to keep them." />
    </Border>

    <!--
      The SVG counterpart of the warning above, and in front of the save for the
      same reason: which layers will be pixels inside the file is something to
      know before choosing SVG for them, not after opening it elsewhere.
    -->
    <Border Background="{DynamicResource SurfaceElevated}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}"
            IsVisible="{Binding HasSvgNotice}">
      <TextBlock x:Name="SvgNoticeText" TextWrapping="Wrap" Text="{Binding SvgNotice}" />
    </Border>

    <Border Background="{DynamicResource SurfaceElevated}" CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource CardPadding}">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
    </Border>

    <!--
      A uniform grid, so both buttons take the width of the wider label; a
      MinWidth alone leaves them different. Dismissing is the quiet one.
      DialogGeometryTests measures the pair.
    -->
    <UniformGrid HorizontalAlignment="Right" Columns="2" ColumnSpacing="8">
      <Button x:Name="CancelButton" Classes="tertiary" Content="Cancel" Click="OnCancel" IsCancel="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              MinWidth="{StaticResource SizeDialogButton}" />
      <Button x:Name="SaveButton" Classes="primary" Content="Save…" Click="OnApply" IsDefault="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              MinWidth="{StaticResource SizeDialogButton}" />
    </UniformGrid>
  </StackPanel>
</Window>
