<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Lightbox.App.Controls"
             x:Class="Lightbox.App.Views.NewDocumentPanel">

  <!--
    The fields of File → New, in a control of their own.

    Shared by the dialog and the start screen. Two copies of these fields would
    be two places for a preset to be added to, and the one that was missed
    would be the one somebody used.
  -->
  <StackPanel Spacing="10">

    <DockPanel>
      <TextBlock Text="Name" Width="110" VerticalAlignment="Center" />
      <TextBox x:Name="NameBox" Text="Untitled" />
    </DockPanel>

    <!--
      What kind of work this is. "None" is first and is the default: the app is
      document-first, and a picture that never becomes a project must not be
      made to carry one. Everything below it only decides which panels you get
      and, if a project is created later, what type it is recorded as.
    -->
    <DockPanel>
      <TextBlock Text="For" Width="110" VerticalAlignment="Center" />
      <ComboBox x:Name="TypeBox" SelectionChanged="OnTypeChanged" HorizontalAlignment="Stretch"
                ToolTip.Tip="None makes a single file with no project structure" />
    </DockPanel>

    <DockPanel x:Name="WorkspaceRow" IsVisible="False">
      <TextBlock Text="Panels" Width="110" VerticalAlignment="Center" />
      <ComboBox x:Name="WorkspaceBox" HorizontalAlignment="Stretch"
                ToolTip.Tip="Keep the arrangement you are working in, or take this type's defaults" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Preset" Width="110" VerticalAlignment="Center" />
      <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged" HorizontalAlignment="Stretch" />
    </DockPanel>

    <!-- One grid rather than two rows, so the swap button can sit beside both
         fields at once — portrait/landscape is one gesture, not two edits. -->
    <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Width (px)" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="WidthBox" Minimum="16" Maximum="8192" Increment="10" FormatString="0" Value="1920" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Height (px)" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="HeightBox" Minimum="16" Maximum="8192" Increment="10" FormatString="0" Value="1080" />
      <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="icon"
              Margin="6,0,0,0" VerticalAlignment="Center" Click="OnSwapSizeClicked"
              ToolTip.Tip="Swap width and height">
        <Path Classes="icon" Data="{StaticResource IconSwapVertical}" />
      </Button>
    </Grid>

    <DockPanel>
      <TextBlock Text="Frame rate (fps)" Width="110" VerticalAlignment="Center" />
      <NumericUpDown x:Name="FpsBox" Minimum="1" Maximum="60" Increment="1" FormatString="0" Value="12" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Resolution (ppi)" Width="110" VerticalAlignment="Center"
                 ToolTip.Tip="Metadata only for now — relevant when print/export sizing arrives" />
      <NumericUpDown x:Name="PpiBox" Minimum="36" Maximum="1200" Increment="1" FormatString="0" Value="72" />
    </DockPanel>

    <DockPanel>
      <TextBlock Text="Background" Width="110" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <!-- The same picker every other colour in the app opens — wheel first,
             hex at the bottom of the flyout as the readout it is. -->
        <controls:ColorField x:Name="BackgroundField" Hex="#ffffff" VerticalAlignment="Center"
                             ToolTip.Tip="Paper color" />
        <CheckBox x:Name="TransparentBox" Content="Transparent" VerticalAlignment="Center"
                  ToolTip.Tip="No paper at all — PNG exports keep transparency" />
      </StackPanel>
    </DockPanel>

    <TextBlock Text="Color mode: RGB · 8-bit (fixed for now)" FontSize="11" Opacity="0.6" Margin="110,0,0,0" />

  </StackPanel>
</UserControl>
