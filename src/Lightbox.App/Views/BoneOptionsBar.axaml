<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lightbox.App.ViewModels"
             x:Class="Lightbox.App.Views.BoneOptionsBar"
             x:DataType="vm:MainViewModel">
  <!--
    A collaborator rather than 76 more lines of MainWindow.axaml, which is on
    the monolith ratchet. The DataContext is inherited, so every binding here
    reads the same MainViewModel the docker around it does.

    Vertical, because the host is the Tool options DOCKER — ~300px wide, as
    tall as the window. The first version of this panel was one horizontal
    StackPanel, a toolbar row transplanted into a docker, and everything past
    the mode switch sat clipped off the right edge: the bone list, rename,
    delete, IK, the weight brush. Nothing was red — every control existed and
    worked — and the artist reported the whole surface missing, which is the
    invisibility bug this tool keeps being reported for wearing its host's
    shape. A control that cannot be scrolled to does not exist.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsBoneTool}">
    <!-- Sections sit a gap-lg (8) apart; rows inside a section sit 6 apart,
         off-scale on purpose to match the brush pages sharing this docker
         (BrushPageGeneral and siblings), so switching tools does not switch
         rhythms. Labels are the 52px column the transform rows use. -->
    <StackPanel Spacing="8" Margin="0,0,4,0">

      <!-- Which third of the tool is in hand, said rather than remembered. -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <RadioButton GroupName="BoneMode" Content="Bind" IsChecked="{Binding IsBindMode, Mode=TwoWay}"
                     ToolTip.Tip="Edit the skeleton against its rest pose: drag empty canvas to add a bone, a shaft to move it, a tip to re-aim it, Shift a tip to grow a child. (Shift+K switches)" />
        <RadioButton GroupName="BoneMode" Content="Pose" IsChecked="{Binding PosingMode, Mode=TwoWay}"
                     ToolTip.Tip="Turn bones and key the pose at the playhead. (Shift+K switches)" />
        <RadioButton GroupName="BoneMode" Content="Weights" IsChecked="{Binding WeightPainting, Mode=TwoWay}"
                     IsEnabled="{Binding HasArmature}"
                     ToolTip.Tip="Paint influence for the selected bone. Painting is against the rest pose, so this leaves posing. (Ctrl+Shift+K)" />
      </StackPanel>

      <TextBlock Text="no rig yet — drag on the canvas to add the first bone"
                 TextWrapping="Wrap" Opacity="0.6"
                 IsVisible="{Binding !HasArmature}" />

      <!-- The bones themselves: findable by name, not only by hitting them.
           A list rather than a combo — in a docker there is room to show the
           rig whole, and the hierarchy is the thing worth seeing. Items and
           selection are wired in code-behind, not bound: the list is redrawn
           whenever the rig changes, and a two-way selection binding answers
           each redraw by writing null into the very selection it was showing.
           That was the reported "no indication of what bone is selected" —
           the panel deselected the bone the moment it heard about it. -->
      <StackPanel Spacing="4" IsVisible="{Binding HasArmature}">
        <TextBlock Text="Bones" FontWeight="SemiBold" FontSize="12" />
        <!-- Capped at ~8 rows so a deep rig scrolls here rather than pushing
             the bone's own controls off the bottom of the docker. -->
        <ListBox x:Name="BoneList" MaxHeight="200"
                 SelectionChanged="OnBoneListSelectionChanged"
                 ToolTip.Tip="Every bone in the rig, children indented under their parent. Picking one here selects it on the canvas.">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BoneRow">
              <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFontFamily}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- What can be done to the picked bone. Absent rather than greyed
           until one is picked. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasSelectedBone}">
        <DockPanel>
          <TextBlock Text="Name" Width="52" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
          <TextBox Text="{Binding SelectedBoneName, Mode=TwoWay}"
                   ToolTip.Tip="Rename the bone. Ending a pair in .l and .r is what lets X-symmetry paint both sides at once." />
        </DockPanel>
        <DockPanel>
          <TextBlock Text="Length" Width="52" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
          <NumericUpDown Value="{Binding SelectedBoneLength, Mode=TwoWay}" Minimum="4" Maximum="4000"
                         Increment="4" FormatString="0"
                         ToolTip.Tip="How long the bone is, in document pixels — the same thing dragging its tip changes." />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Add child" Command="{Binding AddChildBoneCommand}"
                  ToolTip.Tip="Grow a bone from this one's tip, already joined to it. Shift-drag a tip on the canvas does the same and lets you aim it." />
          <Button x:Name="DeleteBoneButton" Content="Delete" Command="{Binding DeleteBoneCommand}"
                  ToolTip.Tip="Delete this bone (Delete). Its children are re-parented to its parent and stay where they are; strokes bound to it lose that binding." />
        </StackPanel>
      </StackPanel>

      <!-- IK. One button makes a working limb, and the rest only appears
           once there is a chain to talk about. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasSelectedBone}">
        <Button Content="Add IK" Command="{Binding AddIkChainCommand}"
                IsVisible="{Binding !HasSelectedChain}"
                ToolTip.Tip="Make this bone the end of an IK chain: a target handle is created at its tip, and dragging that in Pose reaches the whole limb after it." />
        <StackPanel Spacing="6" IsVisible="{Binding HasSelectedChain}">
          <TextBlock Text="IK" FontWeight="SemiBold" FontSize="12" />
          <DockPanel>
            <TextBlock Text="Bones" Width="52" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
            <NumericUpDown Value="{Binding SelectedChainBoneCount, Mode=TwoWay}" Minimum="1" Maximum="16"
                           Increment="1" FormatString="0"
                           ToolTip.Tip="How many bones up from the chain's end the solve may turn. Two is a limb; more is a tail." />
          </DockPanel>
          <DockPanel>
            <TextBlock Text="Pole" Width="52" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
            <ComboBox ItemsSource="{Binding PoleRows}" SelectedValue="{Binding SelectedChainPoleKey, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Id}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="A bone that says which way the knee or elbow bends. Without one the chain keeps whichever way it is already bent.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BoneRow">
                  <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFontFamily}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <Button Content="Remove IK" Command="{Binding RemoveIkChainCommand}"
                  ToolTip.Tip="Delete the chain and its target handle. The bones stay where they are and go back to being posed by hand." />
        </StackPanel>
      </StackPanel>

      <!-- Spline chains, the bendy-bone deformer. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasSelectedBone}">
        <Button Content="Add spline" Command="{Binding AddSplineChainCommand}"
                IsVisible="{Binding !HasSelectedSpline}"
                ToolTip.Tip="Lay this bone and the two above it along a curve, with three handles you drag in Pose. Tails, hair, capes." />
        <StackPanel Spacing="6" IsVisible="{Binding HasSelectedSpline}">
          <TextBlock Text="Spline" FontWeight="SemiBold" FontSize="12" />
          <DockPanel>
            <TextBlock Text="Bones" Width="52" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
            <NumericUpDown Value="{Binding SelectedSplineBoneCount, Mode=TwoWay}" Minimum="1" Maximum="32"
                           Increment="1" FormatString="0"
                           ToolTip.Tip="How many bones up from the end lie along the curve. Every one keeps its own length — the curve bends the run, it never stretches it." />
          </DockPanel>
          <Button Content="Remove spline" Command="{Binding RemoveSplineChainCommand}"
                  ToolTip.Tip="Delete the curve and its handles. The bones stay where they are and go back to being turned by hand." />
        </StackPanel>
      </StackPanel>

      <!-- Constraints. Picking a target IS the add; the editing controls
           only appear once there is something to edit. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasSelectedBone}">
        <TextBlock Text="Constraints" FontWeight="SemiBold" FontSize="12" />
        <ComboBox ItemsSource="{Binding ConstraintTargetRows}" SelectedValue="{Binding ConstrainToKey, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Id}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Make this bone follow another one. Picking a bone here creates an aim at it; change what kind of following it is afterwards.">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BoneRow">
              <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFontFamily}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Spacing="6" IsVisible="{Binding HasSelectedConstraint}">
          <ComboBox ItemsSource="{Binding ConstraintRows}" SelectedValue="{Binding SelectedConstraintId, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Id}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="This bone's constraints. They resolve top to bottom, so a later one sees what an earlier one did.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BoneRow">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox SelectedIndex="{Binding ConstraintKindIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Aim turns the bone to point at the target; Copy turn takes its angle; Copy place takes its position. Stack two for both.">
            <ComboBoxItem Content="Aim at" />
            <ComboBoxItem Content="Copy turn of" />
            <ComboBoxItem Content="Copy place of" />
          </ComboBox>
          <DockPanel>
            <TextBlock Text="Offset" Width="52" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
            <NumericUpDown Value="{Binding ConstraintOffsetDeg, Mode=TwoWay}" Minimum="-360" Maximum="360"
                           Increment="5" FormatString="0"
                           ToolTip.Tip="Degrees added after the constraint resolves — a head that should look slightly past what it aims at." />
          </DockPanel>
          <DockPanel>
            <TextBlock Text="Strength" Width="52" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
            <NumericUpDown Value="{Binding ConstraintInfluencePercent, Mode=TwoWay}" Minimum="0" Maximum="100"
                           Increment="5" FormatString="0"
                           ToolTip.Tip="How far toward the constrained result the bone goes. 0 leaves it exactly where it was." />
          </DockPanel>
          <Button Content="Unconstrain" Command="{Binding RemoveConstraintCommand}"
                  ToolTip.Tip="Take this constraint off. The bone stays where it is and goes back to being posed by hand." />
        </StackPanel>
      </StackPanel>

      <!-- The weight brush and its settings, shown while the brush is armed. -->
      <StackPanel Spacing="6" IsVisible="{Binding WeightPainting}">
        <TextBlock Text="Weight brush" FontWeight="SemiBold" FontSize="12" />
        <ComboBox SelectedIndex="{Binding WeightBrushModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Add builds influence, Subtract takes it away, Smooth averages toward the neighbours — the armpit fixer.">
          <ComboBoxItem Content="Add" />
          <ComboBoxItem Content="Subtract" />
          <ComboBoxItem Content="Smooth" />
        </ComboBox>
        <DockPanel>
          <TextBlock Text="Size" Width="52" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
          <NumericUpDown Value="{Binding WeightBrushRadius, Mode=TwoWay}" Minimum="2" Maximum="400"
                         Increment="2" FormatString="0"
                         ToolTip.Tip="Brush radius in document pixels. Pressure drives strength within it." />
        </DockPanel>
        <CheckBox Content="Mirror" IsChecked="{Binding MirrorWeights, Mode=TwoWay}"
                  ToolTip.Tip="Paint the named pair too (hip.l ↔ hip.r), mirrored across the pair's own axis." />
      </StackPanel>

      <!-- Binding actions, which only mean anything with strokes picked. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasArmature}">
        <TextBlock Text="Binding" FontWeight="SemiBold" FontSize="12" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Assign" Command="{Binding AssignStrokesToBoneCommand}"
                  ToolTip.Tip="Bind the selected lines wholly to the selected bone — the cutout workflow." />
          <Button Content="Auto-bind" Command="{Binding AutoBindStrokesCommand}"
                  ToolTip.Tip="Weight the selected lines against the whole skeleton by distance, then correct with the weight brush." />
        </StackPanel>
        <Button Content="Bake pose" Command="{Binding BakePoseCommand}"
                ToolTip.Tip="Write this frame's pose into the drawing. Bound lines become ordinary posed lines." />
      </StackPanel>

      <!-- Correctives (Q100). A bent joint that skinning collapses is fixed by
           drawing the right shape once; it eases in as the joint approaches
           that angle. The capture is a mode, so the panel says loudly that it
           is open and offers only the two ways out. -->
      <StackPanel Spacing="6" IsVisible="{Binding HasArmature}">
        <TextBlock Text="Joint fixes" FontWeight="SemiBold" FontSize="12" />
        <Button Content="Draw a fix here" Command="{Binding BeginCorrectiveCommand}"
                IsVisible="{Binding !CapturingCorrective}"
                ToolTip.Tip="Bend the joint, then press this: the drawing is posed so you can correct it with the ordinary tools, and what you change is kept as the shape for this angle. Needs Pose mode and a selected bone." />
        <StackPanel Spacing="6" IsVisible="{Binding CapturingCorrective}">
          <TextBlock Text="{Binding CorrectiveStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
          <TextBlock Text="Fix the drawing with any tool, then keep it."
                     TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Keep the fix" Command="{Binding CaptureCorrectiveCommand}"
                    ToolTip.Tip="Store what you moved as this joint's shape at this angle, and put the drawing back." />
            <Button Content="Discard" Command="{Binding CancelCorrectiveCommand}"
                    ToolTip.Tip="Put the drawing back and keep nothing." />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding HasCorrectives}">
          <ListBox x:Name="CorrectiveList" MaxHeight="110"
                   ItemsSource="{Binding CorrectiveRows}"
                   ToolTip.Tip="The fixes on this drawing, and the angles each was drawn at.">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BoneRow">
                <TextBlock Text="{Binding Name}" FontSize="12" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="Remove fix" Click="OnRemoveCorrective"
                  ToolTip.Tip="Take the picked fix off this drawing. The bones and the drawing are untouched." />
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
