<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Lightbox.App.Tests" />
  </ItemGroup>

  <!--
    The compositor moved from Lightbox.App/Rendering into Lightbox.Raster, where
    the one pixel path already lives (Q171 / DESIGN-symbol-layers.md). Seventy-three
    files referenced those types without a `using Lightbox.Raster;`, and adding
    seventy-three usings would have buried an eight-file move in an eighty-file diff.
    One global using instead: the project already references Raster in every build.
  -->
  <ItemGroup>
    <Using Include="Lightbox.Raster" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lightbox.Core\Lightbox.Core.csproj" />
    <ProjectReference Include="..\Lightbox.Raster\Lightbox.Raster.csproj" />
    <ProjectReference Include="..\Lightbox.Ai\Lightbox.Ai.csproj" />
    <ProjectReference Include="..\Lightbox.Import\Lightbox.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <!-- The reference designs are set in Inter. Bundling it means the UI is
         the same typeface on every platform, instead of Segoe on Windows and
         DejaVu on Linux — the latter being a size wider at the same pt. -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      WinExe, not Exe: on Windows this is the difference between a
      GUI-subsystem apphost and a console-subsystem one. A console-subsystem
      executable with no console gets one allocated and attached, which is the
      terminal window that used to open beside the app and take the app down
      with it when closed. Lightbox.Mcp and Lightbox.Bench stay Exe — a stdio
      server and a CLI harness want the console they are given.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- For AudioPlayback only: OpenAL device/context handles are pointer
         types in Silk.NET. Nothing else here should reach for unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The split-gray tile with the mark, generated by
         docs/design/brand/gen_logo.py. This one is the EXE's own icon —
         Explorer, the taskbar, alt-tab; the in-window copy is wired on
         MainWindow from the same file. -->
    <ApplicationIcon>Assets/lightbox.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!--
    Publishing for a specific runtime bundles the app into one executable.

    Conditioned on the RID rather than set outright, and that condition is
    load-bearing: an unconditional PublishSingleFile fails any publish that has
    no RuntimeIdentifier, and this repository builds and tests on Linux without
    one all day. Keyed this way the group is empty on every path `dotnet build`
    and `dotnet test` take, and populated only when somebody is producing a
    bundle to ship.

    Native libraries stay loose beside the executable on purpose. See
    docs/DESIGN-net10-upgrade.md: .NET 10 stopped unconditionally adding a
    single-file app's own directory to the native search path, and Avalonia
    loads ANGLE through a raw LoadLibrary that never consulted it anyway.
    Self-extracting the natives into %TEMP% is the configuration where those two
    facts collide, and the failure is silent — the app falls back to software
    rendering and simply feels slow. Three named files in the folder cost
    nothing at runtime and sidestep the question entirely.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!--
    Native debug symbols are not part of a shipped bundle.

    Measured before removing them: libSkiaSharp.pdb is 84 MB and
    libHarfBuzzSharp.pdb is 21 MB, so 105 MB of a 216 MB publish was symbols for
    somebody else's C++. DebugType=none does not touch these — they are not this
    project's pdbs, they arrive as native runtime assets from the NuGet packages
    and the SDK copies everything under runtimes/<rid>/native/.
  -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
