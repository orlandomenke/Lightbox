<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Lightbox.App.Controls"
             x:Class="Lightbox.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- ColorSpectrum/ColorSlider templates live in a separate theme file;
         without this include they render as nothing at all. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <!-- Docker: title strip, optional top/bottom option bars, content between. -->
    <Style Selector="controls|Docker">
      <Setter Property="Background" Value="#242424" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="#383838" BorderThickness="1" CornerRadius="4">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#1b1b1b" Padding="8,2">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                    <ContentPresenter Content="{TemplateBinding TitleBarExtra}" VerticalAlignment="Center" />
                    <Button Content="✕" FontSize="11" Padding="6,2"
                            Command="{TemplateBinding CloseCommand}"
                            IsVisible="{TemplateBinding CloseCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Collapse this docker (reopen via the View menu)" />
                  </StackPanel>
                  <TextBlock Text="{TemplateBinding Title}" FontSize="12" FontWeight="SemiBold"
                             Opacity="0.9" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding TopBar}" />
              <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding BottomBar}" />
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Shared look for a docker's option bars. -->
    <Style Selector="Border.dockerBar">
      <Setter Property="Background" Value="#202020" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
  </Application.Styles>
</Application>
