<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lightbox.App.App"
             RequestedThemeVariant="Dark">
  <!--
    Both halves live in Styles/ (Q203) so tools/Lightbox.Gallery can load the
    same set. The comments that explain each include moved with it.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lightbox.App/Styles/AppResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <StyleInclude Source="avares://Lightbox.App/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
