bin/
obj/
*.user

# Generated index. INDEX.md and FEATURES.md are committed, because their
# diffs show behaviour changing and they are derived purely from file
# contents — rebuild after an unrelated commit and nothing moves.
#
# The rest is not committed, and the test is the same one every time: does
# the artefact change when nothing about the source did? map.json is a 350 KB
# graph that regenerates in a second. HOTSPOTS.md ranks files by commit churn,
# so every commit changes it by construction — committing it meant the file
# was wrong the instant it landed, and the rebuild that fixed it was another
# commit that made it wrong again. The session hook builds both.
.claude/codemap/map.json
.claude/codemap/.stamp
.claude/codemap/HOTSPOTS.md
# INDEX.md and FEATURES.md joined the untracked set on 2026-08-08 (Q55).
# They are derived from the whole solution, so every parallel branch rewrote
# them end to end and every pull request conflicted on them by construction —
# and GitHub never runs the merge driver that resolved this locally, so the
# owner hand-merged main into every surviving branch after every merge. The
# session-start hook builds them when they are stale or absent; CI builds
# them to prove the tree parses. Nothing authored lives in them.
.claude/codemap/INDEX.md
.claude/codemap/FEATURES.md

# Workflow agents get their own git worktrees under here.
.claude/worktrees/

# Generated by tools/Lightbox.Bench. A cliff and an exponent are facts about
# the code and are committed, in bench-baseline.json; these two are one
# machine's timings and would be a merge conflict every time somebody ran them.
.claude/quality/PERFORMANCE.md
.claude/quality/PERFORMANCE.json

# Bytecode for the scripts/ tooling. Regenerated on every codemap, bugs or
# roadmap run, so tracking it means a dirty tree after any command that reads
# the repo.
__pycache__/
*.pyc

# Generated contact sheets (scripts/visuals.sh). Pictures of the current build, so committing them
# would mean the repository carried an image of whatever the code did on the day somebody ran it —
# and a stale sheet is worse than none, because it looks current. Regenerate in a few seconds.
artifacts/
